            self.writeFrameRate(&out, payload)
        case .cursor(let payload):
            Bincode.writeVarintU32(&out, 1)
            self.writeCursorRequest(&out, payload)
        case .region(let payload):
            Bincode.writeVarintU32(&out, 2)
            self.writeRegionSelector(&out, payload)
        case .formats(let payload):
            Bincode.writeVarintU32(&out, 3)
            self.writeFormatRequest(&out, payload)
        case .pause:
            Bincode.writeVarintU32(&out, 4)
        case .resume:
            Bincode.writeVarintU32(&out, 5)
        }
    }

