    public func readVideoConfig(_ c: inout Bincode.Cursor) throws -> VideoConfig {
        let formats = try self.readFormatRequest(&c)
        let fps = try self.readFrameRate(&c)
        let size = try self.readOutputSize(&c)
        let cursor = try self.readCursorRequest(&c)
        let damage = try self.readStrength(&c)
        let hdr = try self.readHdrPolicy(&c)
        let poolDepth = try Bincode.readU8(&c)
        let exhaustion = try self.readExhaustion(&c)
        let gpu = try self.readGpuPreference(&c)
        let orientation = try self.readOrientationHandling(&c)
        let exclude = try Bincode.readVec(&c) { c1 in try self.readSourceId(&c1) }
        let excludeOwnProcess = try Bincode.readBool(&c)
        let liveBuffers = try Bincode.readBool(&c)
        return VideoConfig(formats: formats, fps: fps, size: size, cursor: cursor, damage: damage, hdr: hdr, poolDepth: poolDepth, exhaustion: exhaustion, gpu: gpu, orientation: orientation, exclude: exclude, excludeOwnProcess: excludeOwnProcess, liveBuffers: liveBuffers)
    }

