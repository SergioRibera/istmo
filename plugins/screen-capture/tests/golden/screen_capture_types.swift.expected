    case linuxWlrScreencopy = 2
    case linuxX11 = 3
    case linuxKms = 4
    case windowsWgc = 5
    case windowsDxgi = 6
    case windowsGdi = 7
    case macosSck = 8
    case iosSck = 9
    case iosReplayKit = 10
    case androidProjection = 11
    case web = 12
}

