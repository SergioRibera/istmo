<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- UIActivityViewController's "Save Image" / "Save Video" actions
	     crash the app when this usage string is missing. Reword it in
	     the app's Info.plist (outside the istmo block); localise it
	     with InfoPlist.strings (templates/ios-localization). -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save shared images and videos to your photo library.</string>
</dict>
</plist>
