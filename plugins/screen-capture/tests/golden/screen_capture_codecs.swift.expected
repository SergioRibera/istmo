    public func readAttemptFailure(_ c: inout Bincode.Cursor) throws -> ScreenCapture.AttemptFailure {
        let disc = try Bincode.readVarintU32(&c)
        switch disc {
        case 0: return .unavailable(try self.readAvailability(&c))
        case 1: return .unsatisfiable(try Bincode.readVec(&c) { c1 in try self.readRequirement(&c1) })
        case 2: return .failed(try Bincode.readString(&c))
        default: throw Bincode.DecodeError.invalidTag(UInt8(clamping: disc))
        }
    }

