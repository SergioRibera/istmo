    }

    override fun readSound(bytes: ByteArray, offset: Int): Bincode.Decoded<Sound> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> Bincode.Decoded(Sound.Default, cursor)
            1 -> Bincode.Decoded(Sound.Silent, cursor)
            2 -> {
                val d_inner = Bincode.readString(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(Sound.Named(inner) as Sound, cursor)
            }
            else -> throw Bincode.DecodeException("Sound: unknown discriminant ${disc.value}")
        }
    }

    override fun writeSound(out: ByteArrayOutputStream, value: Sound) {
        when (value) {
            Sound.Default -> Bincode.writeEnumDiscriminant(out, 0)
            Sound.Silent -> Bincode.writeEnumDiscriminant(out, 1)
            is Sound.Named -> {
                Bincode.writeEnumDiscriminant(out, 2)
                Bincode.writeString(out, value.value)
            }
        }
    }

    override fun readLockScreen(bytes: ByteArray, offset: Int): Bincode.Decoded<LockScreen> {
        val d = Bincode.readEnumDiscriminant(bytes, offset)
