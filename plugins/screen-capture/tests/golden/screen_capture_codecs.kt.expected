    override fun readConsentConfig(bytes: ByteArray, offset: Int): Bincode.Decoded<ConsentConfig> {
        var cursor = offset
        val d_allowPicker = Bincode.readBool(bytes, cursor); cursor = d_allowPicker.consumed
        val allowPicker = d_allowPicker.value
        val d_restoreToken = Bincode.readOption(bytes, cursor) { b1, c1 -> readRestoreToken(b1, c1) }; cursor = d_restoreToken.consumed
        val restoreToken = d_restoreToken.value
        val d_persist = readPersistMode(bytes, cursor); cursor = d_persist.consumed
        val persist = d_persist.value
        val d_grant = Bincode.readOption(bytes, cursor) { b1, c1 -> readProjectionGrant(b1, c1) }; cursor = d_grant.consumed
        val grant = d_grant.value
        return Bincode.Decoded(ConsentConfig(allowPicker = allowPicker, restoreToken = restoreToken, persist = persist, grant = grant), cursor)
    }

