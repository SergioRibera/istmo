    public func readSchemeRequestInfo(_ c: inout Bincode.Cursor) throws -> WebView.SchemeRequestInfo {
        let requestId = try Bincode.readVarintU64(&c)
        let scheme = try Bincode.readString(&c)
        let method = try Bincode.readString(&c)
        let url = try Bincode.readString(&c)
        let headers = try Bincode.readVec(&c) { c1 in try self.readHttpHeader(&c1) }
        let hasBody = try Bincode.readBool(&c)
        let initiatorOrigin = try Bincode.readOption(&c) { c1 in try Bincode.readString(&c1) }
        return WebView.SchemeRequestInfo(requestId: requestId, scheme: scheme, method: method, url: url, headers: headers, hasBody: hasBody, initiatorOrigin: initiatorOrigin)
    }

    public func writeSchemeRequestInfo(_ out: inout Data, _ value: WebView.SchemeRequestInfo) {
        Bincode.writeVarintU64(&out, value.requestId)
        Bincode.writeString(&out, value.scheme)
        Bincode.writeString(&out, value.method)
        Bincode.writeString(&out, value.url)
        Bincode.writeVec(&out, value.headers) { o1, v1 in self.writeHttpHeader(&o1, v1) }
        Bincode.writeBool(&out, value.hasBody)
        Bincode.writeOption(&out, value.initiatorOrigin) { o1, v1 in Bincode.writeString(&o1, v1) }
    }

    public func readBridgeMessage(_ c: inout Bincode.Cursor) throws -> WebView.BridgeMessage {
        let channel = try Bincode.readString(&c)
        let origin = try Bincode.readString(&c)
        let isMainFrame = try Bincode.readBool(&c)
        let documentId = try Bincode.readVarintU64(&c)
        let replyId = try Bincode.readOption(&c) { c1 in try Bincode.readVarintU64(&c1) }
        let data = try Bincode.readData(&c)
        return WebView.BridgeMessage(channel: channel, origin: origin, isMainFrame: isMainFrame, documentId: documentId, replyId: replyId, data: data)
    }

    public func writeBridgeMessage(_ out: inout Data, _ value: WebView.BridgeMessage) {
        Bincode.writeString(&out, value.channel)
        Bincode.writeString(&out, value.origin)
        Bincode.writeBool(&out, value.isMainFrame)
        Bincode.writeVarintU64(&out, value.documentId)
        Bincode.writeOption(&out, value.replyId) { o1, v1 in Bincode.writeVarintU64(&o1, v1) }
        Bincode.writeData(&out, value.data)
    }

