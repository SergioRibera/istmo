    public func readReplyResult(_ c: inout Bincode.Cursor) throws -> WebView.ReplyResult {
        let disc = try Bincode.readVarintU32(&c)
        switch disc {
        case 0: return .ok(try Bincode.readData(&c))
        case 1: return .err(try Bincode.readString(&c))
        default: throw Bincode.DecodeError.invalidTag(UInt8(clamping: disc))
        }
    }

    public func writeReplyResult(_ out: inout Data, _ value: WebView.ReplyResult) {
        switch value {
        case .ok(let payload):
            Bincode.writeVarintU32(&out, 0)
            Bincode.writeData(&out, payload)
        case .err(let payload):
            Bincode.writeVarintU32(&out, 1)
            Bincode.writeString(&out, payload)
        }
    }

    public func readDecision(_ c: inout Bincode.Cursor) throws -> WebView.Decision {
        let requestId = try Bincode.readVarintU64(&c)
        let response = try self.readDecisionResponse(&c)
        return WebView.Decision(requestId: requestId, response: response)
    }

    public func writeDecision(_ out: inout Data, _ value: WebView.Decision) {
        Bincode.writeVarintU64(&out, value.requestId)
        self.writeDecisionResponse(&out, value.response)
    }

    public func readDecisionResponse(_ c: inout Bincode.Cursor) throws -> WebView.DecisionResponse {
        let disc = try Bincode.readVarintU32(&c)
        switch disc {
        case 0: return .allow
        case 1: return .deny
        case 2: return .grant(try Bincode.readVec(&c) { c1 in try self.readWebPermission(&c1) })
        case 3: return .credentials(try self.readHttpCredentials(&c))
        case 4: return .files(try Bincode.readVec(&c) { c1 in try Bincode.readString(&c1) })
        case 5: return .dialogAccept(try Bincode.readOption(&c) { c1 in try Bincode.readString(&c1) })
        case 6: return .downloadTo(try Bincode.readString(&c))
        default: throw Bincode.DecodeError.invalidTag(UInt8(clamping: disc))
        }
    }

    public func writeDecisionResponse(_ out: inout Data, _ value: WebView.DecisionResponse) {
        switch value {
        case .allow:
            Bincode.writeVarintU32(&out, 0)
        case .deny:
            Bincode.writeVarintU32(&out, 1)
        case .grant(let payload):
            Bincode.writeVarintU32(&out, 2)
            Bincode.writeVec(&out, payload) { o1, v1 in self.writeWebPermission(&o1, v1) }
        case .credentials(let payload):
            Bincode.writeVarintU32(&out, 3)
            self.writeHttpCredentials(&out, payload)
        case .files(let payload):
            Bincode.writeVarintU32(&out, 4)
            Bincode.writeVec(&out, payload) { o1, v1 in Bincode.writeString(&o1, v1) }
        case .dialogAccept(let payload):
            Bincode.writeVarintU32(&out, 5)
            Bincode.writeOption(&out, payload) { o1, v1 in Bincode.writeString(&o1, v1) }
        case .downloadTo(let payload):
            Bincode.writeVarintU32(&out, 6)
            Bincode.writeString(&out, payload)
        }
    }

    public func readHttpCredentials(_ c: inout Bincode.Cursor) throws -> WebView.HttpCredentials {
        let user = try Bincode.readString(&c)
        let password = try Bincode.readString(&c)
        return WebView.HttpCredentials(user: user, password: password)
    }

    public func writeHttpCredentials(_ out: inout Data, _ value: WebView.HttpCredentials) {
        Bincode.writeString(&out, value.user)
        Bincode.writeString(&out, value.password)
    }

    public func readSchemeResponseHead(_ c: inout Bincode.Cursor) throws -> WebView.SchemeResponseHead {
        let requestId = try Bincode.readVarintU64(&c)
        let status = try Bincode.readVarintU16(&c)
        let mimeType = try Bincode.readString(&c)
        let headers = try Bincode.readVec(&c) { c1 in try self.readHttpHeader(&c1) }
        let contentLength = try Bincode.readOption(&c) { c1 in try Bincode.readVarintU64(&c1) }
        return WebView.SchemeResponseHead(requestId: requestId, status: status, mimeType: mimeType, headers: headers, contentLength: contentLength)
    }

    public func writeSchemeResponseHead(_ out: inout Data, _ value: WebView.SchemeResponseHead) {
        Bincode.writeVarintU64(&out, value.requestId)
        Bincode.writeVarintU16(&out, value.status)
        Bincode.writeString(&out, value.mimeType)
        Bincode.writeVec(&out, value.headers) { o1, v1 in self.writeHttpHeader(&o1, v1) }
        Bincode.writeOption(&out, value.contentLength) { o1, v1 in Bincode.writeVarintU64(&o1, v1) }
    }

    public func readSchemeChunk(_ c: inout Bincode.Cursor) throws -> WebView.SchemeChunk {
        let requestId = try Bincode.readVarintU64(&c)
        let body = try self.readSchemeBody(&c)
        return WebView.SchemeChunk(requestId: requestId, body: body)
    }

    public func writeSchemeChunk(_ out: inout Data, _ value: WebView.SchemeChunk) {
        Bincode.writeVarintU64(&out, value.requestId)
        self.writeSchemeBody(&out, value.body)
    }

    public func readSchemeBody(_ c: inout Bincode.Cursor) throws -> WebView.SchemeBody {
        let disc = try Bincode.readVarintU32(&c)
        switch disc {
        case 0: return .data(try Bincode.readData(&c))
        case 1: return .end
        case 2: return .abort(try Bincode.readString(&c))
        default: throw Bincode.DecodeError.invalidTag(UInt8(clamping: disc))
        }
    }

    public func writeSchemeBody(_ out: inout Data, _ value: WebView.SchemeBody) {
        switch value {
        case .data(let payload):
            Bincode.writeVarintU32(&out, 0)
            Bincode.writeData(&out, payload)
        case .end:
            Bincode.writeVarintU32(&out, 1)
        case .abort(let payload):
            Bincode.writeVarintU32(&out, 2)
            Bincode.writeString(&out, payload)
        }
    }

    public func readWebCookie(_ c: inout Bincode.Cursor) throws -> WebView.WebCookie {
        let name = try Bincode.readString(&c)
        let value = try Bincode.readString(&c)
        let domain = try Bincode.readString(&c)
        let path = try Bincode.readString(&c)
        let expiresUnixMs = try Bincode.readOption(&c) { c1 in try Bincode.readVarintI64(&c1) }
        let secure = try Bincode.readBool(&c)
        let httpOnly = try Bincode.readBool(&c)
        let sameSite = try self.readSameSite(&c)
        return WebView.WebCookie(name: name, value: value, domain: domain, path: path, expiresUnixMs: expiresUnixMs, secure: secure, httpOnly: httpOnly, sameSite: sameSite)
    }

    public func writeWebCookie(_ out: inout Data, _ value: WebView.WebCookie) {
        Bincode.writeString(&out, value.name)
        Bincode.writeString(&out, value.value)
        Bincode.writeString(&out, value.domain)
        Bincode.writeString(&out, value.path)
        Bincode.writeOption(&out, value.expiresUnixMs) { o1, v1 in Bincode.writeVarintI64(&o1, v1) }
        Bincode.writeBool(&out, value.secure)
        Bincode.writeBool(&out, value.httpOnly)
        self.writeSameSite(&out, value.sameSite)
    }

    public func readSameSite(_ c: inout Bincode.Cursor) throws -> WebView.SameSite {
        let disc = try Bincode.readVarintU32(&c)
        guard let value = WebView.SameSite(rawValue: disc) else {
            throw Bincode.DecodeError.invalidTag(UInt8(clamping: disc))
        }
        return value
    }

    public func writeSameSite(_ out: inout Data, _ value: WebView.SameSite) {
