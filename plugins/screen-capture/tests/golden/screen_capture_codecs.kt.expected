    }

    override fun readCompositeScale(bytes: ByteArray, offset: Int): Bincode.Decoded<CompositeScale> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> Bincode.Decoded(CompositeScale.HighestScale, cursor)
            1 -> Bincode.Decoded(CompositeScale.Logical, cursor)
            2 -> {
                val d_inner = Bincode.readU32(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(CompositeScale.Permille(inner) as CompositeScale, cursor)
            }
            else -> throw Bincode.DecodeException("CompositeScale: unknown discriminant ${disc.value}")
        }
    }

    override fun writeCompositeScale(out: ByteArrayOutputStream, value: CompositeScale) {
        when (value) {
            CompositeScale.HighestScale -> Bincode.writeEnumDiscriminant(out, 0)
            CompositeScale.Logical -> Bincode.writeEnumDiscriminant(out, 1)
            is CompositeScale.Permille -> {
                Bincode.writeEnumDiscriminant(out, 2)
                Bincode.writeU32(out, value.value)
            }
        }
    }

