        val defaultAction = d_defaultAction.value
        val d_rules = Bincode.readVec(bytes, cursor) { b1, c1 -> readNavigationRule(b1, c1) }; cursor = d_rules.consumed
        val rules = d_rules.value
        return Bincode.Decoded(NavigationRules(defaultAction = defaultAction, rules = rules), cursor)
    }

    override fun writeNavigationRules(out: ByteArrayOutputStream, value: NavigationRules) {
