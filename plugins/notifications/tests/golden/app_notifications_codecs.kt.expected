    }

    override fun readProgress(bytes: ByteArray, offset: Int): Bincode.Decoded<Progress> {
        var cursor = offset
        val d_value = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readF32(b1, c1) }; cursor = d_value.consumed
        val value = d_value.value
        val d_label = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_label.consumed
        val label = d_label.value
        val d_segments = Bincode.readVec(bytes, cursor) { b1, c1 -> readProgressSegment(b1, c1) }; cursor = d_segments.consumed
        val segments = d_segments.value
        val d_points = Bincode.readVec(bytes, cursor) { b1, c1 -> readProgressPoint(b1, c1) }; cursor = d_points.consumed
        val points = d_points.value
        return Bincode.Decoded(Progress(value = value, label = label, segments = segments, points = points), cursor)
    }

    override fun writeProgress(out: ByteArrayOutputStream, value: Progress) {
        Bincode.writeOption(out, value.value) { s1, v1 -> Bincode.writeF32(s1, v1) }
        Bincode.writeOption(out, value.label) { s1, v1 -> Bincode.writeString(s1, v1) }
        Bincode.writeVec(out, value.segments) { s1, v1 -> writeProgressSegment(s1, v1) }
        Bincode.writeVec(out, value.points) { s1, v1 -> writeProgressPoint(s1, v1) }
    }

    override fun readProgressSegment(bytes: ByteArray, offset: Int): Bincode.Decoded<ProgressSegment> {
        var cursor = offset
        val d_length = Bincode.readU32(bytes, cursor); cursor = d_length.consumed
        val length = d_length.value
        val d_color = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readU32(b1, c1) }; cursor = d_color.consumed
        val color = d_color.value
        return Bincode.Decoded(ProgressSegment(length = length, color = color), cursor)
    }

    override fun writeProgressSegment(out: ByteArrayOutputStream, value: ProgressSegment) {
        Bincode.writeU32(out, value.length)
        Bincode.writeOption(out, value.color) { s1, v1 -> Bincode.writeU32(s1, v1) }
    }

    override fun readProgressPoint(bytes: ByteArray, offset: Int): Bincode.Decoded<ProgressPoint> {
        var cursor = offset
        val d_position = Bincode.readU32(bytes, cursor); cursor = d_position.consumed
        val position = d_position.value
        val d_color = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readU32(b1, c1) }; cursor = d_color.consumed
        val color = d_color.value
        return Bincode.Decoded(ProgressPoint(position = position, color = color), cursor)
    }

    override fun writeProgressPoint(out: ByteArrayOutputStream, value: ProgressPoint) {
        Bincode.writeU32(out, value.position)
        Bincode.writeOption(out, value.color) { s1, v1 -> Bincode.writeU32(s1, v1) }
    }

    override fun readChronometer(bytes: ByteArray, offset: Int): Bincode.Decoded<Chronometer> {
        var cursor = offset
        val d_baseMs = Bincode.readI64(bytes, cursor); cursor = d_baseMs.consumed
        val baseMs = d_baseMs.value
        val d_countDown = Bincode.readBool(bytes, cursor); cursor = d_countDown.consumed
        val countDown = d_countDown.value
        return Bincode.Decoded(Chronometer(baseMs = baseMs, countDown = countDown), cursor)
    }

    override fun writeChronometer(out: ByteArrayOutputStream, value: Chronometer) {
        Bincode.writeI64(out, value.baseMs)
        Bincode.writeBool(out, value.countDown)
    }

    override fun readMissedPolicy(bytes: ByteArray, offset: Int): Bincode.Decoded<MissedPolicy> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> Bincode.Decoded(MissedPolicy.Drop, cursor)
            1 -> {
                val d_inner = Bincode.readU64(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(MissedPolicy.DeliverLate(inner) as MissedPolicy, cursor)
            }
            else -> throw Bincode.DecodeException("MissedPolicy: unknown discriminant ${disc.value}")
        }
    }

    override fun writeMissedPolicy(out: ByteArrayOutputStream, value: MissedPolicy) {
        when (value) {
            MissedPolicy.Drop -> Bincode.writeEnumDiscriminant(out, 0)
            is MissedPolicy.DeliverLate -> {
                Bincode.writeEnumDiscriminant(out, 1)
                Bincode.writeU64(out, value.value)
            }
        }
    }

    override fun readTrigger(bytes: ByteArray, offset: Int): Bincode.Decoded<Trigger> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> {
                val d_inner = Bincode.readU64(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(Trigger.After(inner) as Trigger, cursor)
            }
            1 -> {
                val d_inner = Bincode.readI64(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(Trigger.At(inner) as Trigger, cursor)
            }
            2 -> {
                val d_inner = Bincode.readU64(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(Trigger.Every(inner) as Trigger, cursor)
            }
            3 -> {
                val d_inner = readCalendarRule(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(Trigger.Calendar(inner) as Trigger, cursor)
            }
            else -> throw Bincode.DecodeException("Trigger: unknown discriminant ${disc.value}")
        }
    }

    override fun writeTrigger(out: ByteArrayOutputStream, value: Trigger) {
        when (value) {
            is Trigger.After -> {
                Bincode.writeEnumDiscriminant(out, 0)
                Bincode.writeU64(out, value.value)
            }
            is Trigger.At -> {
                Bincode.writeEnumDiscriminant(out, 1)
                Bincode.writeI64(out, value.value)
            }
            is Trigger.Every -> {
                Bincode.writeEnumDiscriminant(out, 2)
                Bincode.writeU64(out, value.value)
            }
            is Trigger.Calendar -> {
                Bincode.writeEnumDiscriminant(out, 3)
                writeCalendarRule(out, value.value)
            }
        }
    }

    override fun readCalendarRule(bytes: ByteArray, offset: Int): Bincode.Decoded<CalendarRule> {
        var cursor = offset
        val d_hour = Bincode.readU8(bytes, cursor); cursor = d_hour.consumed
        val hour = d_hour.value
        val d_minute = Bincode.readU8(bytes, cursor); cursor = d_minute.consumed
        val minute = d_minute.value
        val d_weekdays = Bincode.readVec(bytes, cursor) { b1, c1 -> readWeekday(b1, c1) }; cursor = d_weekdays.consumed
        val weekdays = d_weekdays.value
        val d_dayOfMonth = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readU8(b1, c1) }; cursor = d_dayOfMonth.consumed
        val dayOfMonth = d_dayOfMonth.value
        val d_month = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readU8(b1, c1) }; cursor = d_month.consumed
        val month = d_month.value
        val d_timeZone = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_timeZone.consumed
        val timeZone = d_timeZone.value
        val d_untilMs = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readI64(b1, c1) }; cursor = d_untilMs.consumed
        val untilMs = d_untilMs.value
        return Bincode.Decoded(CalendarRule(hour = hour, minute = minute, weekdays = weekdays, dayOfMonth = dayOfMonth, month = month, timeZone = timeZone, untilMs = untilMs), cursor)
    }

    override fun writeCalendarRule(out: ByteArrayOutputStream, value: CalendarRule) {
        Bincode.writeU8(out, value.hour)
        Bincode.writeU8(out, value.minute)
        Bincode.writeVec(out, value.weekdays) { s1, v1 -> writeWeekday(s1, v1) }
        Bincode.writeOption(out, value.dayOfMonth) { s1, v1 -> Bincode.writeU8(s1, v1) }
        Bincode.writeOption(out, value.month) { s1, v1 -> Bincode.writeU8(s1, v1) }
        Bincode.writeOption(out, value.timeZone) { s1, v1 -> Bincode.writeString(s1, v1) }
        Bincode.writeOption(out, value.untilMs) { s1, v1 -> Bincode.writeI64(s1, v1) }
    }

    override fun readWeekday(bytes: ByteArray, offset: Int): Bincode.Decoded<Weekday> {
        val d = Bincode.readEnumDiscriminant(bytes, offset)
        val variant = Weekday.entries.getOrNull(d.value)
            ?: throw Bincode.DecodeException("Weekday: unknown discriminant ${d.value}")
        return Bincode.Decoded(variant, d.consumed)
    }

    override fun writeWeekday(out: ByteArrayOutputStream, value: Weekday) {
        Bincode.writeEnumDiscriminant(out, value.ordinal)
    }

    override fun readNotificationPatch(bytes: ByteArray, offset: Int): Bincode.Decoded<NotificationPatch> {
        var cursor = offset
        val d_title = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_title.consumed
        val title = d_title.value
        val d_subtitle = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_subtitle.consumed
        val subtitle = d_subtitle.value
        val d_body = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_body.consumed
        val body = d_body.value
        val d_style = Bincode.readOption(bytes, cursor) { b1, c1 -> readStyle(b1, c1) }; cursor = d_style.consumed
        val style = d_style.value
        val d_icon = Bincode.readOption(bytes, cursor) { b1, c1 -> readNotificationImage(b1, c1) }; cursor = d_icon.consumed
        val icon = d_icon.value
        val d_actions = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readVec(b1, c1) { b2, c2 -> readAction(b2, c2) } }; cursor = d_actions.consumed
        val actions = d_actions.value
        val d_progress = Bincode.readOption(bytes, cursor) { b1, c1 -> readProgress(b1, c1) }; cursor = d_progress.consumed
        val progress = d_progress.value
        val d_statusText = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_statusText.consumed
        val statusText = d_statusText.value
        val d_count = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readU32(b1, c1) }; cursor = d_count.consumed
        val count = d_count.value
        val d_ongoing = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readBool(b1, c1) }; cursor = d_ongoing.consumed
        val ongoing = d_ongoing.value
        val d_url = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_url.consumed
        val url = d_url.value
        val d_userData = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_userData.consumed
        val userData = d_userData.value
        val d_clear = Bincode.readVec(bytes, cursor) { b1, c1 -> readPatchField(b1, c1) }; cursor = d_clear.consumed
        val clear = d_clear.value
        val d_alertAgain = Bincode.readBool(bytes, cursor); cursor = d_alertAgain.consumed
        val alertAgain = d_alertAgain.value
        return Bincode.Decoded(NotificationPatch(title = title, subtitle = subtitle, body = body, style = style, icon = icon, actions = actions, progress = progress, statusText = statusText, count = count, ongoing = ongoing, url = url, userData = userData, clear = clear, alertAgain = alertAgain), cursor)
    }

    override fun writeNotificationPatch(out: ByteArrayOutputStream, value: NotificationPatch) {
        Bincode.writeOption(out, value.title) { s1, v1 -> Bincode.writeString(s1, v1) }
        Bincode.writeOption(out, value.subtitle) { s1, v1 -> Bincode.writeString(s1, v1) }
        Bincode.writeOption(out, value.body) { s1, v1 -> Bincode.writeString(s1, v1) }
        Bincode.writeOption(out, value.style) { s1, v1 -> writeStyle(s1, v1) }
        Bincode.writeOption(out, value.icon) { s1, v1 -> writeNotificationImage(s1, v1) }
        Bincode.writeOption(out, value.actions) { s1, v1 -> Bincode.writeVec(s1, v1) { s2, v2 -> writeAction(s2, v2) } }
        Bincode.writeOption(out, value.progress) { s1, v1 -> writeProgress(s1, v1) }
        Bincode.writeOption(out, value.statusText) { s1, v1 -> Bincode.writeString(s1, v1) }
        Bincode.writeOption(out, value.count) { s1, v1 -> Bincode.writeU32(s1, v1) }
        Bincode.writeOption(out, value.ongoing) { s1, v1 -> Bincode.writeBool(s1, v1) }
        Bincode.writeOption(out, value.url) { s1, v1 -> Bincode.writeString(s1, v1) }
        Bincode.writeOption(out, value.userData) { s1, v1 -> Bincode.writeString(s1, v1) }
        Bincode.writeVec(out, value.clear) { s1, v1 -> writePatchField(s1, v1) }
        Bincode.writeBool(out, value.alertAgain)
    }

    override fun readPatchField(bytes: ByteArray, offset: Int): Bincode.Decoded<PatchField> {
        val d = Bincode.readEnumDiscriminant(bytes, offset)
        val variant = PatchField.entries.getOrNull(d.value)
            ?: throw Bincode.DecodeException("PatchField: unknown discriminant ${d.value}")
        return Bincode.Decoded(variant, d.consumed)
    }

    override fun writePatchField(out: ByteArrayOutputStream, value: PatchField) {
        Bincode.writeEnumDiscriminant(out, value.ordinal)
    }

    override fun readChannelSpec(bytes: ByteArray, offset: Int): Bincode.Decoded<ChannelSpec> {
        var cursor = offset
        val d_id = readChannelId(bytes, cursor); cursor = d_id.consumed
        val id = d_id.value
        val d_name = Bincode.readString(bytes, cursor); cursor = d_name.consumed
        val name = d_name.value
        val d_description = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_description.consumed
        val description = d_description.value
        val d_importance = readInterruption(bytes, cursor); cursor = d_importance.consumed
        val importance = d_importance.value
        val d_sound = Bincode.readOption(bytes, cursor) { b1, c1 -> readSound(b1, c1) }; cursor = d_sound.consumed
        val sound = d_sound.value
        val d_vibration = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readVec(b1, c1) { b2, c2 -> Bincode.readU32(b2, c2) } }; cursor = d_vibration.consumed
        val vibration = d_vibration.value
        val d_lightColor = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readU32(b1, c1) }; cursor = d_lightColor.consumed
        val lightColor = d_lightColor.value
        val d_showBadge = Bincode.readBool(bytes, cursor); cursor = d_showBadge.consumed
        val showBadge = d_showBadge.value
        val d_lockScreen = Bincode.readOption(bytes, cursor) { b1, c1 -> readLockScreen(b1, c1) }; cursor = d_lockScreen.consumed
        val lockScreen = d_lockScreen.value
        val d_bypassDnd = Bincode.readBool(bytes, cursor); cursor = d_bypassDnd.consumed
        val bypassDnd = d_bypassDnd.value
        val d_group = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_group.consumed
        val group = d_group.value
        return Bincode.Decoded(ChannelSpec(id = id, name = name, description = description, importance = importance, sound = sound, vibration = vibration, lightColor = lightColor, showBadge = showBadge, lockScreen = lockScreen, bypassDnd = bypassDnd, group = group), cursor)
    }

    override fun writeChannelSpec(out: ByteArrayOutputStream, value: ChannelSpec) {
        writeChannelId(out, value.id)
        Bincode.writeString(out, value.name)
        Bincode.writeOption(out, value.description) { s1, v1 -> Bincode.writeString(s1, v1) }
        writeInterruption(out, value.importance)
        Bincode.writeOption(out, value.sound) { s1, v1 -> writeSound(s1, v1) }
        Bincode.writeOption(out, value.vibration) { s1, v1 -> Bincode.writeVec(s1, v1) { s2, v2 -> Bincode.writeU32(s2, v2) } }
        Bincode.writeOption(out, value.lightColor) { s1, v1 -> Bincode.writeU32(s1, v1) }
        Bincode.writeBool(out, value.showBadge)
        Bincode.writeOption(out, value.lockScreen) { s1, v1 -> writeLockScreen(s1, v1) }
        Bincode.writeBool(out, value.bypassDnd)
        Bincode.writeOption(out, value.group) { s1, v1 -> Bincode.writeString(s1, v1) }
    }

    override fun readFeature(bytes: ByteArray, offset: Int): Bincode.Decoded<Feature> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> Bincode.Decoded(Feature.Show, cursor)
            1 -> Bincode.Decoded(Feature.Update, cursor)
            2 -> Bincode.Decoded(Feature.SilentUpdate, cursor)
            3 -> Bincode.Decoded(Feature.ProgressBar, cursor)
            4 -> Bincode.Decoded(Feature.LivePromotion, cursor)
            5 -> Bincode.Decoded(Feature.Schedule, cursor)
            6 -> Bincode.Decoded(Feature.Repeat, cursor)
            7 -> Bincode.Decoded(Feature.Missed, cursor)
            8 -> Bincode.Decoded(Feature.Actions, cursor)
            9 -> Bincode.Decoded(Feature.InlineReply, cursor)
            10 -> Bincode.Decoded(Feature.Choices, cursor)
            11 -> Bincode.Decoded(Feature.Snooze, cursor)
            12 -> Bincode.Decoded(Feature.Avatar, cursor)
            13 -> Bincode.Decoded(Feature.Picture, cursor)
            14 -> Bincode.Decoded(Feature.Messaging, cursor)
            15 -> Bincode.Decoded(Feature.CallStyle, cursor)
            16 -> Bincode.Decoded(Feature.Groups, cursor)
            17 -> Bincode.Decoded(Feature.Channels, cursor)
            18 -> Bincode.Decoded(Feature.CustomSound, cursor)
            19 -> Bincode.Decoded(Feature.Interruption, cursor)
            20 -> Bincode.Decoded(Feature.Ongoing, cursor)
            21 -> Bincode.Decoded(Feature.Timeout, cursor)
            22 -> Bincode.Decoded(Feature.LockScreen, cursor)
            23 -> Bincode.Decoded(Feature.Chronometer, cursor)
            24 -> Bincode.Decoded(Feature.ListDelivered, cursor)
            25 -> Bincode.Decoded(Feature.ListPending, cursor)
            26 -> Bincode.Decoded(Feature.Dismissal, cursor)
            27 -> Bincode.Decoded(Feature.TapWhenClosed, cursor)
            28 -> Bincode.Decoded(Feature.BackgroundAction, cursor)
            29 -> Bincode.Decoded(Feature.PermissionRequest, cursor)
            30 -> Bincode.Decoded(Feature.ExactAlarms, cursor)
            31 -> Bincode.Decoded(Feature.DoNotDisturb, cursor)
            32 -> Bincode.Decoded(Feature.OpenSettings, cursor)
            else -> Bincode.Decoded(Feature.Unknown(disc.value, bytes.copyOfRange(cursor, bytes.size)) as Feature, bytes.size)
        }
    }

    override fun writeFeature(out: ByteArrayOutputStream, value: Feature) {
        when (value) {
            Feature.Show -> Bincode.writeEnumDiscriminant(out, 0)
            Feature.Update -> Bincode.writeEnumDiscriminant(out, 1)
            Feature.SilentUpdate -> Bincode.writeEnumDiscriminant(out, 2)
            Feature.ProgressBar -> Bincode.writeEnumDiscriminant(out, 3)
            Feature.LivePromotion -> Bincode.writeEnumDiscriminant(out, 4)
            Feature.Schedule -> Bincode.writeEnumDiscriminant(out, 5)
            Feature.Repeat -> Bincode.writeEnumDiscriminant(out, 6)
            Feature.Missed -> Bincode.writeEnumDiscriminant(out, 7)
            Feature.Actions -> Bincode.writeEnumDiscriminant(out, 8)
            Feature.InlineReply -> Bincode.writeEnumDiscriminant(out, 9)
            Feature.Choices -> Bincode.writeEnumDiscriminant(out, 10)
            Feature.Snooze -> Bincode.writeEnumDiscriminant(out, 11)
            Feature.Avatar -> Bincode.writeEnumDiscriminant(out, 12)
            Feature.Picture -> Bincode.writeEnumDiscriminant(out, 13)
            Feature.Messaging -> Bincode.writeEnumDiscriminant(out, 14)
            Feature.CallStyle -> Bincode.writeEnumDiscriminant(out, 15)
            Feature.Groups -> Bincode.writeEnumDiscriminant(out, 16)
            Feature.Channels -> Bincode.writeEnumDiscriminant(out, 17)
            Feature.CustomSound -> Bincode.writeEnumDiscriminant(out, 18)
            Feature.Interruption -> Bincode.writeEnumDiscriminant(out, 19)
            Feature.Ongoing -> Bincode.writeEnumDiscriminant(out, 20)
            Feature.Timeout -> Bincode.writeEnumDiscriminant(out, 21)
            Feature.LockScreen -> Bincode.writeEnumDiscriminant(out, 22)
            Feature.Chronometer -> Bincode.writeEnumDiscriminant(out, 23)
            Feature.ListDelivered -> Bincode.writeEnumDiscriminant(out, 24)
            Feature.ListPending -> Bincode.writeEnumDiscriminant(out, 25)
            Feature.Dismissal -> Bincode.writeEnumDiscriminant(out, 26)
            Feature.TapWhenClosed -> Bincode.writeEnumDiscriminant(out, 27)
            Feature.BackgroundAction -> Bincode.writeEnumDiscriminant(out, 28)
            Feature.PermissionRequest -> Bincode.writeEnumDiscriminant(out, 29)
            Feature.ExactAlarms -> Bincode.writeEnumDiscriminant(out, 30)
            Feature.DoNotDisturb -> Bincode.writeEnumDiscriminant(out, 31)
            Feature.OpenSettings -> Bincode.writeEnumDiscriminant(out, 32)
            is Feature.Unknown -> {
                Bincode.writeEnumDiscriminant(out, value.discriminant)
                out.write(value.payload, 0, value.payload.size)
            }
        }
    }

    override fun readSupport(bytes: ByteArray, offset: Int): Bincode.Decoded<Support> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> Bincode.Decoded(Support.Native, cursor)
            1 -> Bincode.Decoded(Support.Simulated, cursor)
            2 -> Bincode.Decoded(Support.WhileRunning, cursor)
            3 -> Bincode.Decoded(Support.Unsupported, cursor)
            else -> Bincode.Decoded(Support.Unknown(disc.value, bytes.copyOfRange(cursor, bytes.size)) as Support, bytes.size)
        }
    }

    override fun writeSupport(out: ByteArrayOutputStream, value: Support) {
        when (value) {
            Support.Native -> Bincode.writeEnumDiscriminant(out, 0)
            Support.Simulated -> Bincode.writeEnumDiscriminant(out, 1)
            Support.WhileRunning -> Bincode.writeEnumDiscriminant(out, 2)
            Support.Unsupported -> Bincode.writeEnumDiscriminant(out, 3)
            is Support.Unknown -> {
                Bincode.writeEnumDiscriminant(out, value.discriminant)
                out.write(value.payload, 0, value.payload.size)
            }
        }
    }

    override fun readFeatureSupport(bytes: ByteArray, offset: Int): Bincode.Decoded<FeatureSupport> {
        var cursor = offset
        val d_feature = readFeature(bytes, cursor); cursor = d_feature.consumed
        val feature = d_feature.value
        val d_support = readSupport(bytes, cursor); cursor = d_support.consumed
        val support = d_support.value
        return Bincode.Decoded(FeatureSupport(feature = feature, support = support), cursor)
    }

    override fun writeFeatureSupport(out: ByteArrayOutputStream, value: FeatureSupport) {
        writeFeature(out, value.feature)
        writeSupport(out, value.support)
    }

    override fun readCapabilities(bytes: ByteArray, offset: Int): Bincode.Decoded<Capabilities> {
        var cursor = offset
        val d_backend = Bincode.readString(bytes, cursor); cursor = d_backend.consumed
        val backend = d_backend.value
        val d_features = Bincode.readVec(bytes, cursor) { b1, c1 -> readFeatureSupport(b1, c1) }; cursor = d_features.consumed
        val features = d_features.value
        val d_maxActions = Bincode.readU32(bytes, cursor); cursor = d_maxActions.consumed
        val maxActions = d_maxActions.value
        val d_maxPending = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readU32(b1, c1) }; cursor = d_maxPending.consumed
        val maxPending = d_maxPending.value
        val d_maxActive = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readU32(b1, c1) }; cursor = d_maxActive.consumed
        val maxActive = d_maxActive.value
        return Bincode.Decoded(Capabilities(backend = backend, features = features, maxActions = maxActions, maxPending = maxPending, maxActive = maxActive), cursor)
    }

    override fun writeCapabilities(out: ByteArrayOutputStream, value: Capabilities) {
        Bincode.writeString(out, value.backend)
        Bincode.writeVec(out, value.features) { s1, v1 -> writeFeatureSupport(s1, v1) }
        Bincode.writeU32(out, value.maxActions)
        Bincode.writeOption(out, value.maxPending) { s1, v1 -> Bincode.writeU32(s1, v1) }
        Bincode.writeOption(out, value.maxActive) { s1, v1 -> Bincode.writeU32(s1, v1) }
    }

    override fun readPermissionRequest(bytes: ByteArray, offset: Int): Bincode.Decoded<PermissionRequest> {
        var cursor = offset
        val d_alerts = Bincode.readBool(bytes, cursor); cursor = d_alerts.consumed
        val alerts = d_alerts.value
        val d_sound = Bincode.readBool(bytes, cursor); cursor = d_sound.consumed
        val sound = d_sound.value
        val d_badge = Bincode.readBool(bytes, cursor); cursor = d_badge.consumed
        val badge = d_badge.value
        val d_provisional = Bincode.readBool(bytes, cursor); cursor = d_provisional.consumed
        val provisional = d_provisional.value
        val d_critical = Bincode.readBool(bytes, cursor); cursor = d_critical.consumed
        val critical = d_critical.value
        val d_exactAlarms = Bincode.readBool(bytes, cursor); cursor = d_exactAlarms.consumed
        val exactAlarms = d_exactAlarms.value
        val d_fullScreen = Bincode.readBool(bytes, cursor); cursor = d_fullScreen.consumed
        val fullScreen = d_fullScreen.value
        val d_promoted = Bincode.readBool(bytes, cursor); cursor = d_promoted.consumed
        val promoted = d_promoted.value
        return Bincode.Decoded(PermissionRequest(alerts = alerts, sound = sound, badge = badge, provisional = provisional, critical = critical, exactAlarms = exactAlarms, fullScreen = fullScreen, promoted = promoted), cursor)
    }

    override fun writePermissionRequest(out: ByteArrayOutputStream, value: PermissionRequest) {
        Bincode.writeBool(out, value.alerts)
        Bincode.writeBool(out, value.sound)
        Bincode.writeBool(out, value.badge)
        Bincode.writeBool(out, value.provisional)
        Bincode.writeBool(out, value.critical)
        Bincode.writeBool(out, value.exactAlarms)
        Bincode.writeBool(out, value.fullScreen)
        Bincode.writeBool(out, value.promoted)
    }

    override fun readPermissionState(bytes: ByteArray, offset: Int): Bincode.Decoded<PermissionState> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> Bincode.Decoded(PermissionState.Granted, cursor)
            1 -> Bincode.Decoded(PermissionState.Denied, cursor)
            2 -> Bincode.Decoded(PermissionState.NotDetermined, cursor)
            3 -> Bincode.Decoded(PermissionState.Provisional, cursor)
            4 -> Bincode.Decoded(PermissionState.Ephemeral, cursor)
            5 -> Bincode.Decoded(PermissionState.NotRequired, cursor)
            6 -> Bincode.Decoded(PermissionState.Unavailable, cursor)
            else -> Bincode.Decoded(PermissionState.Unknown(disc.value, bytes.copyOfRange(cursor, bytes.size)) as PermissionState, bytes.size)
        }
    }

    override fun writePermissionState(out: ByteArrayOutputStream, value: PermissionState) {
        when (value) {
            PermissionState.Granted -> Bincode.writeEnumDiscriminant(out, 0)
            PermissionState.Denied -> Bincode.writeEnumDiscriminant(out, 1)
            PermissionState.NotDetermined -> Bincode.writeEnumDiscriminant(out, 2)
            PermissionState.Provisional -> Bincode.writeEnumDiscriminant(out, 3)
            PermissionState.Ephemeral -> Bincode.writeEnumDiscriminant(out, 4)
            PermissionState.NotRequired -> Bincode.writeEnumDiscriminant(out, 5)
            PermissionState.Unavailable -> Bincode.writeEnumDiscriminant(out, 6)
            is PermissionState.Unknown -> {
                Bincode.writeEnumDiscriminant(out, value.discriminant)
                out.write(value.payload, 0, value.payload.size)
            }
        }
    }

    override fun readPermissionStatus(bytes: ByteArray, offset: Int): Bincode.Decoded<PermissionStatus> {
        var cursor = offset
        val d_state = readPermissionState(bytes, cursor); cursor = d_state.consumed
        val state = d_state.value
        val d_alerts = Bincode.readBool(bytes, cursor); cursor = d_alerts.consumed
        val alerts = d_alerts.value
        val d_sound = Bincode.readBool(bytes, cursor); cursor = d_sound.consumed
        val sound = d_sound.value
        val d_badge = Bincode.readBool(bytes, cursor); cursor = d_badge.consumed
        val badge = d_badge.value
        val d_exactAlarms = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readBool(b1, c1) }; cursor = d_exactAlarms.consumed
        val exactAlarms = d_exactAlarms.value
        val d_fullScreen = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readBool(b1, c1) }; cursor = d_fullScreen.consumed
        val fullScreen = d_fullScreen.value
        val d_promoted = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readBool(b1, c1) }; cursor = d_promoted.consumed
        val promoted = d_promoted.value
        val d_timeSensitive = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readBool(b1, c1) }; cursor = d_timeSensitive.consumed
        val timeSensitive = d_timeSensitive.value
        val d_communication = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readBool(b1, c1) }; cursor = d_communication.consumed
        val communication = d_communication.value
        val d_doNotDisturb = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readBool(b1, c1) }; cursor = d_doNotDisturb.consumed
        val doNotDisturb = d_doNotDisturb.value
        return Bincode.Decoded(PermissionStatus(state = state, alerts = alerts, sound = sound, badge = badge, exactAlarms = exactAlarms, fullScreen = fullScreen, promoted = promoted, timeSensitive = timeSensitive, communication = communication, doNotDisturb = doNotDisturb), cursor)
    }

    override fun writePermissionStatus(out: ByteArrayOutputStream, value: PermissionStatus) {
        writePermissionState(out, value.state)
        Bincode.writeBool(out, value.alerts)
        Bincode.writeBool(out, value.sound)
        Bincode.writeBool(out, value.badge)
        Bincode.writeOption(out, value.exactAlarms) { s1, v1 -> Bincode.writeBool(s1, v1) }
        Bincode.writeOption(out, value.fullScreen) { s1, v1 -> Bincode.writeBool(s1, v1) }
        Bincode.writeOption(out, value.promoted) { s1, v1 -> Bincode.writeBool(s1, v1) }
        Bincode.writeOption(out, value.timeSensitive) { s1, v1 -> Bincode.writeBool(s1, v1) }
        Bincode.writeOption(out, value.communication) { s1, v1 -> Bincode.writeBool(s1, v1) }
        Bincode.writeOption(out, value.doNotDisturb) { s1, v1 -> Bincode.writeBool(s1, v1) }
    }

    override fun readScheduledInfo(bytes: ByteArray, offset: Int): Bincode.Decoded<ScheduledInfo> {
        var cursor = offset
        val d_exact = Bincode.readBool(bytes, cursor); cursor = d_exact.consumed
        val exact = d_exact.value
        val d_nextFireMs = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readI64(b1, c1) }; cursor = d_nextFireMs.consumed
        val nextFireMs = d_nextFireMs.value
        return Bincode.Decoded(ScheduledInfo(exact = exact, nextFireMs = nextFireMs), cursor)
    }

    override fun writeScheduledInfo(out: ByteArrayOutputStream, value: ScheduledInfo) {
        Bincode.writeBool(out, value.exact)
        Bincode.writeOption(out, value.nextFireMs) { s1, v1 -> Bincode.writeI64(s1, v1) }
    }

    override fun readPendingNotification(bytes: ByteArray, offset: Int): Bincode.Decoded<PendingNotification> {
        var cursor = offset
        val d_notification = readNotification(bytes, cursor); cursor = d_notification.consumed
        val notification = d_notification.value
        val d_trigger = readTrigger(bytes, cursor); cursor = d_trigger.consumed
        val trigger = d_trigger.value
        val d_nextFireMs = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readI64(b1, c1) }; cursor = d_nextFireMs.consumed
        val nextFireMs = d_nextFireMs.value
        return Bincode.Decoded(PendingNotification(notification = notification, trigger = trigger, nextFireMs = nextFireMs), cursor)
    }

    override fun writePendingNotification(out: ByteArrayOutputStream, value: PendingNotification) {
        writeNotification(out, value.notification)
        writeTrigger(out, value.trigger)
        Bincode.writeOption(out, value.nextFireMs) { s1, v1 -> Bincode.writeI64(s1, v1) }
    }

    override fun readDeliveredNotification(bytes: ByteArray, offset: Int): Bincode.Decoded<DeliveredNotification> {
        var cursor = offset
        val d_id = readNotificationId(bytes, cursor); cursor = d_id.consumed
        val id = d_id.value
        val d_title = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_title.consumed
        val title = d_title.value
        val d_body = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_body.consumed
        val body = d_body.value
        val d_group = Bincode.readOption(bytes, cursor) { b1, c1 -> readGroupId(b1, c1) }; cursor = d_group.consumed
        val group = d_group.value
        val d_deliveredMs = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readI64(b1, c1) }; cursor = d_deliveredMs.consumed
        val deliveredMs = d_deliveredMs.value
        return Bincode.Decoded(DeliveredNotification(id = id, title = title, body = body, group = group, deliveredMs = deliveredMs), cursor)
    }

    override fun writeDeliveredNotification(out: ByteArrayOutputStream, value: DeliveredNotification) {
        writeNotificationId(out, value.id)
        Bincode.writeOption(out, value.title) { s1, v1 -> Bincode.writeString(s1, v1) }
        Bincode.writeOption(out, value.body) { s1, v1 -> Bincode.writeString(s1, v1) }
        Bincode.writeOption(out, value.group) { s1, v1 -> writeGroupId(s1, v1) }
        Bincode.writeOption(out, value.deliveredMs) { s1, v1 -> Bincode.writeI64(s1, v1) }
    }

    override fun readAckToken(bytes: ByteArray, offset: Int): Bincode.Decoded<AckToken> {
        var cursor = offset
        val d_value = Bincode.readU64(bytes, cursor); cursor = d_value.consumed
        val value = d_value.value
        return Bincode.Decoded(AckToken(value = value), cursor)
    }

    override fun writeAckToken(out: ByteArrayOutputStream, value: AckToken) {
        Bincode.writeU64(out, value.value)
    }

    override fun readNotificationEvent(bytes: ByteArray, offset: Int): Bincode.Decoded<NotificationEvent> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> {
                val d_inner = readNotificationId(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(NotificationEvent.Delivered(inner) as NotificationEvent, cursor)
            }
            1 -> {
                val d_inner = readNotificationId(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(NotificationEvent.DeliveredLate(inner) as NotificationEvent, cursor)
            }
            2 -> {
                val d_inner = readDismissal(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(NotificationEvent.Dismissed(inner) as NotificationEvent, cursor)
            }
            3 -> {
                val d_inner = readNotificationId(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(NotificationEvent.Snoozed(inner) as NotificationEvent, cursor)
            }
            4 -> {
                val d_inner = readFailure(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(NotificationEvent.Failed(inner) as NotificationEvent, cursor)
            }
            5 -> {
                val d_inner = readNotificationId(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(NotificationEvent.NotPromoted(inner) as NotificationEvent, cursor)
            }
            else -> Bincode.Decoded(NotificationEvent.Unknown(disc.value, bytes.copyOfRange(cursor, bytes.size)) as NotificationEvent, bytes.size)
        }
    }

    override fun writeNotificationEvent(out: ByteArrayOutputStream, value: NotificationEvent) {
        when (value) {
            is NotificationEvent.Delivered -> {
                Bincode.writeEnumDiscriminant(out, 0)
                writeNotificationId(out, value.value)
            }
            is NotificationEvent.DeliveredLate -> {
                Bincode.writeEnumDiscriminant(out, 1)
                writeNotificationId(out, value.value)
            }
            is NotificationEvent.Dismissed -> {
                Bincode.writeEnumDiscriminant(out, 2)
                writeDismissal(out, value.value)
            }
            is NotificationEvent.Snoozed -> {
                Bincode.writeEnumDiscriminant(out, 3)
                writeNotificationId(out, value.value)
            }
            is NotificationEvent.Failed -> {
                Bincode.writeEnumDiscriminant(out, 4)
                writeFailure(out, value.value)
            }
            is NotificationEvent.NotPromoted -> {
                Bincode.writeEnumDiscriminant(out, 5)
                writeNotificationId(out, value.value)
            }
            is NotificationEvent.Unknown -> {
                Bincode.writeEnumDiscriminant(out, value.discriminant)
                out.write(value.payload, 0, value.payload.size)
            }
        }
    }

    override fun readDismissal(bytes: ByteArray, offset: Int): Bincode.Decoded<Dismissal> {
        var cursor = offset
        val d_id = readNotificationId(bytes, cursor); cursor = d_id.consumed
        val id = d_id.value
        val d_reason = readDismissReason(bytes, cursor); cursor = d_reason.consumed
        val reason = d_reason.value
        return Bincode.Decoded(Dismissal(id = id, reason = reason), cursor)
    }

    override fun writeDismissal(out: ByteArrayOutputStream, value: Dismissal) {
        writeNotificationId(out, value.id)
        writeDismissReason(out, value.reason)
    }

    override fun readDismissReason(bytes: ByteArray, offset: Int): Bincode.Decoded<DismissReason> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> Bincode.Decoded(DismissReason.User, cursor)
            1 -> Bincode.Decoded(DismissReason.Timeout, cursor)
            2 -> Bincode.Decoded(DismissReason.App, cursor)
            3 -> Bincode.Decoded(DismissReason.Other, cursor)
            else -> Bincode.Decoded(DismissReason.Unknown(disc.value, bytes.copyOfRange(cursor, bytes.size)) as DismissReason, bytes.size)
        }
    }

    override fun writeDismissReason(out: ByteArrayOutputStream, value: DismissReason) {
        when (value) {
            DismissReason.User -> Bincode.writeEnumDiscriminant(out, 0)
            DismissReason.Timeout -> Bincode.writeEnumDiscriminant(out, 1)
            DismissReason.App -> Bincode.writeEnumDiscriminant(out, 2)
            DismissReason.Other -> Bincode.writeEnumDiscriminant(out, 3)
            is DismissReason.Unknown -> {
                Bincode.writeEnumDiscriminant(out, value.discriminant)
                out.write(value.payload, 0, value.payload.size)
            }
        }
    }

    override fun readFailure(bytes: ByteArray, offset: Int): Bincode.Decoded<Failure> {
        var cursor = offset
        val d_id = Bincode.readOption(bytes, cursor) { b1, c1 -> readNotificationId(b1, c1) }; cursor = d_id.consumed
        val id = d_id.value
        val d_message = Bincode.readString(bytes, cursor); cursor = d_message.consumed
        val message = d_message.value
        return Bincode.Decoded(Failure(id = id, message = message), cursor)
    }

    override fun writeFailure(out: ByteArrayOutputStream, value: Failure) {
        Bincode.writeOption(out, value.id) { s1, v1 -> writeNotificationId(s1, v1) }
        Bincode.writeString(out, value.message)
    }

    override fun readNotificationError(bytes: ByteArray, offset: Int): Bincode.Decoded<NotificationError> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> {
                val d_inner = readFeature(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(NotificationError.Unsupported(inner) as NotificationError, cursor)
            }
            1 -> Bincode.Decoded(NotificationError.PermissionDenied, cursor)
            2 -> Bincode.Decoded(NotificationError.NotBundled, cursor)
            3 -> Bincode.Decoded(NotificationError.Elevated, cursor)
            4 -> {
                val d_inner = readInvalidField(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(NotificationError.Invalid(inner) as NotificationError, cursor)
            }
            5 -> {
                val d_inner = Bincode.readU32(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(NotificationError.TooMany(inner) as NotificationError, cursor)
            }
            6 -> {
                val d_inner = Bincode.readString(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(NotificationError.UnknownChannel(inner) as NotificationError, cursor)
            }
            7 -> {
                val d_inner = Bincode.readString(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(NotificationError.NotFound(inner) as NotificationError, cursor)
            }
            8 -> {
                val d_inner = readPlatformError(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(NotificationError.Platform(inner) as NotificationError, cursor)
            }
            else -> Bincode.Decoded(NotificationError.Unknown(disc.value, bytes.copyOfRange(cursor, bytes.size)) as NotificationError, bytes.size)
        }
    }

    override fun writeNotificationError(out: ByteArrayOutputStream, value: NotificationError) {
        when (value) {
            is NotificationError.Unsupported -> {
                Bincode.writeEnumDiscriminant(out, 0)
                writeFeature(out, value.value)
            }
            NotificationError.PermissionDenied -> Bincode.writeEnumDiscriminant(out, 1)
            NotificationError.NotBundled -> Bincode.writeEnumDiscriminant(out, 2)
            NotificationError.Elevated -> Bincode.writeEnumDiscriminant(out, 3)
            is NotificationError.Invalid -> {
                Bincode.writeEnumDiscriminant(out, 4)
                writeInvalidField(out, value.value)
            }
            is NotificationError.TooMany -> {
                Bincode.writeEnumDiscriminant(out, 5)
                Bincode.writeU32(out, value.value)
            }
            is NotificationError.UnknownChannel -> {
                Bincode.writeEnumDiscriminant(out, 6)
                Bincode.writeString(out, value.value)
            }
            is NotificationError.NotFound -> {
                Bincode.writeEnumDiscriminant(out, 7)
                Bincode.writeString(out, value.value)
            }
            is NotificationError.Platform -> {
                Bincode.writeEnumDiscriminant(out, 8)
                writePlatformError(out, value.value)
            }
            is NotificationError.Unknown -> {
                Bincode.writeEnumDiscriminant(out, value.discriminant)
                out.write(value.payload, 0, value.payload.size)
            }
        }
    }

    override fun readInvalidField(bytes: ByteArray, offset: Int): Bincode.Decoded<InvalidField> {
        var cursor = offset
        val d_field = Bincode.readString(bytes, cursor); cursor = d_field.consumed
        val field = d_field.value
        val d_problem = readProblem(bytes, cursor); cursor = d_problem.consumed
        val problem = d_problem.value
        return Bincode.Decoded(InvalidField(field = field, problem = problem), cursor)
    }

    override fun writeInvalidField(out: ByteArrayOutputStream, value: InvalidField) {
        Bincode.writeString(out, value.field)
        writeProblem(out, value.problem)
    }

    override fun readProblem(bytes: ByteArray, offset: Int): Bincode.Decoded<Problem> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> Bincode.Decoded(Problem.Empty, cursor)
            1 -> Bincode.Decoded(Problem.TooLong, cursor)
            2 -> Bincode.Decoded(Problem.BadCharset, cursor)
            3 -> Bincode.Decoded(Problem.Duplicate, cursor)
            4 -> Bincode.Decoded(Problem.BadUrl, cursor)
            5 -> Bincode.Decoded(Problem.TooLarge, cursor)
            6 -> Bincode.Decoded(Problem.OutOfRange, cursor)
            7 -> Bincode.Decoded(Problem.Reserved, cursor)
            8 -> Bincode.Decoded(Problem.NotAllowedHere, cursor)
            else -> Bincode.Decoded(Problem.Unknown(disc.value, bytes.copyOfRange(cursor, bytes.size)) as Problem, bytes.size)
        }
    }

    override fun writeProblem(out: ByteArrayOutputStream, value: Problem) {
        when (value) {
            Problem.Empty -> Bincode.writeEnumDiscriminant(out, 0)
            Problem.TooLong -> Bincode.writeEnumDiscriminant(out, 1)
            Problem.BadCharset -> Bincode.writeEnumDiscriminant(out, 2)
            Problem.Duplicate -> Bincode.writeEnumDiscriminant(out, 3)
            Problem.BadUrl -> Bincode.writeEnumDiscriminant(out, 4)
            Problem.TooLarge -> Bincode.writeEnumDiscriminant(out, 5)
            Problem.OutOfRange -> Bincode.writeEnumDiscriminant(out, 6)
            Problem.Reserved -> Bincode.writeEnumDiscriminant(out, 7)
            Problem.NotAllowedHere -> Bincode.writeEnumDiscriminant(out, 8)
            is Problem.Unknown -> {
                Bincode.writeEnumDiscriminant(out, value.discriminant)
                out.write(value.payload, 0, value.payload.size)
            }
        }
    }

    override fun readPlatformError(bytes: ByteArray, offset: Int): Bincode.Decoded<PlatformError> {
        var cursor = offset
        val d_code = Bincode.readI64(bytes, cursor); cursor = d_code.consumed
        val code = d_code.value
        val d_message = Bincode.readString(bytes, cursor); cursor = d_message.consumed
        val message = d_message.value
        return Bincode.Decoded(PlatformError(code = code, message = message), cursor)
    }

    override fun writePlatformError(out: ByteArrayOutputStream, value: PlatformError) {
        Bincode.writeI64(out, value.code)
        Bincode.writeString(out, value.message)
    }

    override fun readResponseAction(bytes: ByteArray, offset: Int): Bincode.Decoded<ResponseAction> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> Bincode.Decoded(ResponseAction.Open, cursor)
            1 -> {
                val d_inner = readActionId(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(ResponseAction.Button(inner) as ResponseAction, cursor)
            }
            2 -> Bincode.Decoded(ResponseAction.Dismiss, cursor)
            3 -> Bincode.Decoded(ResponseAction.More, cursor)
            else -> Bincode.Decoded(ResponseAction.Unknown(disc.value, bytes.copyOfRange(cursor, bytes.size)) as ResponseAction, bytes.size)
        }
    }

    override fun writeResponseAction(out: ByteArrayOutputStream, value: ResponseAction) {
        when (value) {
            ResponseAction.Open -> Bincode.writeEnumDiscriminant(out, 0)
            is ResponseAction.Button -> {
                Bincode.writeEnumDiscriminant(out, 1)
                writeActionId(out, value.value)
            }
            ResponseAction.Dismiss -> Bincode.writeEnumDiscriminant(out, 2)
            ResponseAction.More -> Bincode.writeEnumDiscriminant(out, 3)
            is ResponseAction.Unknown -> {
                Bincode.writeEnumDiscriminant(out, value.discriminant)
                out.write(value.payload, 0, value.payload.size)
            }
        }
    }

    override fun readNotificationResponse(bytes: ByteArray, offset: Int): Bincode.Decoded<NotificationResponse> {
        var cursor = offset
        val d_id = readNotificationId(bytes, cursor); cursor = d_id.consumed
        val id = d_id.value
        val d_action = readResponseAction(bytes, cursor); cursor = d_action.consumed
        val action = d_action.value
        val d_reply = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_reply.consumed
        val reply = d_reply.value
        val d_inputRequested = Bincode.readBool(bytes, cursor); cursor = d_inputRequested.consumed
        val inputRequested = d_inputRequested.value
        val d_userData = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_userData.consumed
        val userData = d_userData.value
        val d_url = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_url.consumed
        val url = d_url.value
        val d_launchedApp = Bincode.readBool(bytes, cursor); cursor = d_launchedApp.consumed
        val launchedApp = d_launchedApp.value
        val d_overflowActions = Bincode.readVec(bytes, cursor) { b1, c1 -> readAction(b1, c1) }; cursor = d_overflowActions.consumed
        val overflowActions = d_overflowActions.value
        val d_ack = Bincode.readOption(bytes, cursor) { b1, c1 -> readAckToken(b1, c1) }; cursor = d_ack.consumed
        val ack = d_ack.value
        return Bincode.Decoded(NotificationResponse(id = id, action = action, reply = reply, inputRequested = inputRequested, userData = userData, url = url, launchedApp = launchedApp, overflowActions = overflowActions, ack = ack), cursor)
    }

    override fun writeNotificationResponse(out: ByteArrayOutputStream, value: NotificationResponse) {
        writeNotificationId(out, value.id)
        writeResponseAction(out, value.action)
        Bincode.writeOption(out, value.reply) { s1, v1 -> Bincode.writeString(s1, v1) }
        Bincode.writeBool(out, value.inputRequested)
        Bincode.writeOption(out, value.userData) { s1, v1 -> Bincode.writeString(s1, v1) }
        Bincode.writeOption(out, value.url) { s1, v1 -> Bincode.writeString(s1, v1) }
        Bincode.writeBool(out, value.launchedApp)
        Bincode.writeVec(out, value.overflowActions) { s1, v1 -> writeAction(s1, v1) }
        Bincode.writeOption(out, value.ack) { s1, v1 -> writeAckToken(s1, v1) }
    }
}
