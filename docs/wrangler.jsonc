{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "istmo",
  "compatibility_date": "2025-01-01",
  // `istmo*` (not `istmo/*`) so the bare `/istmo` reaches the docs too;
  // the asset handler redirects it to `/istmo/`. Everything else on the
  // zone stays with the site that owns it.
  "routes": [
    { "pattern": "sergioribera.rs/istmo*", "zone_name": "sergioribera.rs" }
  ],
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
