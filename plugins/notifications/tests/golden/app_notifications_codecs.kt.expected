        return Bincode.Decoded(Group(id = id, title = title, summary = summary), cursor)
    }

    override fun writeGroup(out: ByteArrayOutputStream, value: Group) {
        writeGroupId(out, value.id)
        Bincode.writeOption(out, value.title) { s1, v1 -> Bincode.writeString(s1, v1) }
        Bincode.writeOption(out, value.summary) { s1, v1 -> Bincode.writeString(s1, v1) }
    }

