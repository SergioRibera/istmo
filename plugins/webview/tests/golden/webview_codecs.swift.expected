    public func readDownloadAction(_ c: inout Bincode.Cursor) throws -> WebView.DownloadAction {
        let disc = try Bincode.readVarintU32(&c)
        guard let value = WebView.DownloadAction(rawValue: disc) else {
            throw Bincode.DecodeError.invalidTag(UInt8(clamping: disc))
        }
        return value
