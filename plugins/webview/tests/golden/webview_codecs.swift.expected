        let url = try Bincode.readOption(&c) { c1 in try Bincode.readString(&c1) }
        let name = try Bincode.readOption(&c) { c1 in try Bincode.readString(&c1) }
        return WebView.CookieFilter(url: url, name: name)
    }

    public func writeCookieFilter(_ out: inout Data, _ value: WebView.CookieFilter) {
