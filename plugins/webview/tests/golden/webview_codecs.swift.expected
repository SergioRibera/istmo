    public func readDownloadDone(_ c: inout Bincode.Cursor) throws -> WebView.DownloadDone {
        let downloadId = try Bincode.readVarintU64(&c)
        let path = try Bincode.readOption(&c) { c1 in try Bincode.readString(&c1) }
        let error = try Bincode.readOption(&c) { c1 in try Bincode.readString(&c1) }
        return WebView.DownloadDone(downloadId: downloadId, path: path, error: error)
