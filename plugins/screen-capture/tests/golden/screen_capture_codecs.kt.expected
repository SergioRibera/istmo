    override fun readAudioEvent(bytes: ByteArray, offset: Int): Bincode.Decoded<AudioEvent> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> {
                val d_inner = readAudioNegotiated(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(AudioEvent.Started(inner) as AudioEvent, cursor)
            }
            1 -> {
                val d_inner = readPauseReason(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(AudioEvent.Paused(inner) as AudioEvent, cursor)
            }
            2 -> Bincode.Decoded(AudioEvent.Resumed, cursor)
            3 -> Bincode.Decoded(AudioEvent.Muted, cursor)
            4 -> Bincode.Decoded(AudioEvent.Unmuted, cursor)
            5 -> {
                val d_inner = readCaptureError(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(AudioEvent.Failed(inner) as AudioEvent, cursor)
            }
            6 -> {
                val d_inner = readStopReason(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(AudioEvent.Stopped(inner) as AudioEvent, cursor)
            }
            else -> throw Bincode.DecodeException("AudioEvent: unknown discriminant ${disc.value}")
        }
    }

    override fun writeAudioEvent(out: ByteArrayOutputStream, value: AudioEvent) {
        when (value) {
            is AudioEvent.Started -> {
                Bincode.writeEnumDiscriminant(out, 0)
                writeAudioNegotiated(out, value.value)
            }
            is AudioEvent.Paused -> {
                Bincode.writeEnumDiscriminant(out, 1)
                writePauseReason(out, value.value)
            }
            AudioEvent.Resumed -> Bincode.writeEnumDiscriminant(out, 2)
            AudioEvent.Muted -> Bincode.writeEnumDiscriminant(out, 3)
            AudioEvent.Unmuted -> Bincode.writeEnumDiscriminant(out, 4)
            is AudioEvent.Failed -> {
                Bincode.writeEnumDiscriminant(out, 5)
                writeCaptureError(out, value.value)
            }
            is AudioEvent.Stopped -> {
                Bincode.writeEnumDiscriminant(out, 6)
                writeStopReason(out, value.value)
            }
        }
    }

