    }

    public func readControlEvent(_ c: inout Bincode.Cursor) throws -> WebView.ControlEvent {
        let disc = try Bincode.readVarintU32(&c)
        switch disc {
        case 0: return .navigationStarted(try self.readNavInfo(&c))
        case 1: return .navigationCommitted(try self.readNavInfo(&c))
        case 2: return .navigationFinished(try self.readNavInfo(&c))
        case 3: return .navigationFailed(try self.readNavFailure(&c))
        case 4: return .intercepted(try self.readInterceptedNav(&c))
        case 5: return .decisionRequested(try self.readDecisionRequest(&c))
        case 6: return .schemeRequest(try self.readSchemeRequestInfo(&c))
        case 7: return .message(try self.readBridgeMessage(&c))
        case 8: return .newView(try self.readNewViewInfo(&c))
        case 9: return .closeRequested
        case 10: return .fullscreenChanged(try Bincode.readBool(&c))
        case 11: return .processTerminated(try self.readTerminationInfo(&c))
        default: throw Bincode.DecodeError.invalidTag(UInt8(clamping: disc))
        }
    }

    public func writeControlEvent(_ out: inout Data, _ value: WebView.ControlEvent) {
        switch value {
        case .navigationStarted(let payload):
            Bincode.writeVarintU32(&out, 0)
            self.writeNavInfo(&out, payload)
        case .navigationCommitted(let payload):
            Bincode.writeVarintU32(&out, 1)
            self.writeNavInfo(&out, payload)
        case .navigationFinished(let payload):
            Bincode.writeVarintU32(&out, 2)
            self.writeNavInfo(&out, payload)
        case .navigationFailed(let payload):
            Bincode.writeVarintU32(&out, 3)
            self.writeNavFailure(&out, payload)
        case .intercepted(let payload):
            Bincode.writeVarintU32(&out, 4)
            self.writeInterceptedNav(&out, payload)
        case .decisionRequested(let payload):
            Bincode.writeVarintU32(&out, 5)
            self.writeDecisionRequest(&out, payload)
        case .schemeRequest(let payload):
            Bincode.writeVarintU32(&out, 6)
            self.writeSchemeRequestInfo(&out, payload)
        case .message(let payload):
            Bincode.writeVarintU32(&out, 7)
            self.writeBridgeMessage(&out, payload)
        case .newView(let payload):
            Bincode.writeVarintU32(&out, 8)
            self.writeNewViewInfo(&out, payload)
        case .closeRequested:
            Bincode.writeVarintU32(&out, 9)
        case .fullscreenChanged(let payload):
            Bincode.writeVarintU32(&out, 10)
            Bincode.writeBool(&out, payload)
        case .processTerminated(let payload):
            Bincode.writeVarintU32(&out, 11)
            self.writeTerminationInfo(&out, payload)
        }
    }

    public func readNavInfo(_ c: inout Bincode.Cursor) throws -> WebView.NavInfo {
        let navigationId = try Bincode.readVarintU64(&c)
