<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- istmo.share's own manifest (FileProvider, chooser callback,
         ShareReceiverActivity) is merged in by the istmo Gradle plugin
         loader; this file only opts in to what the app wants. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:hasCode="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <activity
            android:name="dev.istmo.sharedemo.ShareDemoActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|keyboardHidden|screenSize">
            <meta-data
                android:name="android.app.lib_name"
                android:value="share_demo" />
            <!-- Direct share: binds ShareClient::set_share_targets to the
                 ShareTarget alias below. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/istmo_share_shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receiving shares: the demo appears in other apps' share sheets
             for text, links, images, videos and any file. -->
        <activity-alias
            android:name="dev.istmo.plugins.share.ShareTarget"
            android:targetActivity="dev.istmo.plugins.share.ShareReceiverActivity"
            android:label="@string/share_target_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/*" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
