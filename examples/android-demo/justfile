# Docker image ships Rust 1.96 + Android SDK 37 + cargo-ndk.
# Same image ansync uses; keeps the toolchain pinned across projects.
image := "sergioribera/rust-android:1.96-sdk-37.0"

# ABI shipped by the demo. Extend the Gradle `abiFilters` in
# android/app/build.gradle.kts before adding more targets here.
abi := "arm64-v8a"

# Mount istmo/ (cargo workspace root) at /src. The justfile lives at
# examples/android-demo/, so ../../ climbs back to the workspace root.
mount := "-v $(pwd)/../../:/src -v gradle-cache:/root/.gradle -v cargo-cache:/root/.cargo"

# Gradle version the wrapper pulls. AGP 8.6 in app/build.gradle.kts
# requires 8.7+. Bump when AGP moves.
gradle_version := "8.9"

# ---- Top-level -------------------------------------------------------

# Full build: Rust cdylib -> jniLibs -> APK. Debug APK is auto-signed
# with the debug keystore, installable immediately.
build: build-so build-apk

# One-shot: use the image's system Gradle (8.2) to write the wrapper
# scripts + jar under android/gradle/wrapper/, pinned to gradle_version.
# Commit those files afterwards; every other recipe runs ./gradlew.
wrapper:
    docker run --rm -it {{mount}} \
        -w /src/examples/android-demo/android \
        --entrypoint bash {{image}} \
        -c 'gradle wrapper --gradle-version {{gradle_version}} --distribution-type bin --no-daemon'

# Wipe Gradle output.
clean:
    docker run --rm -it {{mount}} \
        -w /src/examples/android-demo/android \
        --entrypoint bash {{image}} \
        -c './gradlew clean --no-daemon'

# adb install the last debug APK. Requires a device / emulator visible
# to the host `adb`.
install:
    adb install -r android/app/build/outputs/apk/debug/app-debug.apk

# Convenience chain for iterating on a plugged device.
run: build install

# ---- Steps -----------------------------------------------------------

# Cross-compile the demo cdylib and drop `libistmo_android_demo.so` into
# app/src/main/jniLibs/<abi>/. cargo-ndk creates the ABI subdirectory
# on its own.
build-so:
    docker run --rm -it {{mount}} \
        -w /src/examples/android-demo \
        --entrypoint bash {{image}} \
        -c 'cargo ndk -t {{abi}} \
              -o android/app/src/main/jniLibs \
              build --release -p istmo-android-demo'

# Gradle assemble. Runs the in-repo wrapper (`./gradlew`) so the pinned
# AGP-compatible Gradle distribution is used regardless of what the
# image bundles. --no-daemon: no long-lived JVM in the ephemeral
# container.
build-apk:
    docker run --rm -it {{mount}} \
        -w /src/examples/android-demo/android \
        --entrypoint bash {{image}} \
        -c './gradlew :app:assembleDebug --no-daemon'
