    override fun readCaptureEvent(bytes: ByteArray, offset: Int): Bincode.Decoded<CaptureEvent> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> {
                val d_inner = readNegotiatedStream(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(CaptureEvent.Started(inner) as CaptureEvent, cursor)
            }
            1 -> {
                val d_inner = readNegotiatedStream(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(CaptureEvent.Renegotiated(inner) as CaptureEvent, cursor)
            }
            2 -> {
                val d_inner = readDowngrade(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(CaptureEvent.Downgraded(inner) as CaptureEvent, cursor)
            }
            3 -> {
                val d_inner = readSize(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(CaptureEvent.SourceResized(inner) as CaptureEvent, cursor)
            }
            4 -> Bincode.Decoded(CaptureEvent.SourceHidden, cursor)
            5 -> Bincode.Decoded(CaptureEvent.SourceVisible, cursor)
            6 -> {
                val d_inner = readPauseReason(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(CaptureEvent.Paused(inner) as CaptureEvent, cursor)
            }
            7 -> Bincode.Decoded(CaptureEvent.Resumed, cursor)
            8 -> {
                val d_inner = readExhaustionReport(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(CaptureEvent.Exhausted(inner) as CaptureEvent, cursor)
            }
            9 -> Bincode.Decoded(CaptureEvent.ConsentRevoked, cursor)
            10 -> Bincode.Decoded(CaptureEvent.SourceLost, cursor)
            11 -> {
                val d_inner = readCaptureError(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(CaptureEvent.Failed(inner) as CaptureEvent, cursor)
            }
            12 -> {
                val d_inner = readStopReason(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(CaptureEvent.Stopped(inner) as CaptureEvent, cursor)
            }
            else -> throw Bincode.DecodeException("CaptureEvent: unknown discriminant ${disc.value}")
        }
    }

    override fun writeCaptureEvent(out: ByteArrayOutputStream, value: CaptureEvent) {
        when (value) {
            is CaptureEvent.Started -> {
                Bincode.writeEnumDiscriminant(out, 0)
                writeNegotiatedStream(out, value.value)
            }
            is CaptureEvent.Renegotiated -> {
                Bincode.writeEnumDiscriminant(out, 1)
                writeNegotiatedStream(out, value.value)
            }
            is CaptureEvent.Downgraded -> {
                Bincode.writeEnumDiscriminant(out, 2)
                writeDowngrade(out, value.value)
            }
            is CaptureEvent.SourceResized -> {
                Bincode.writeEnumDiscriminant(out, 3)
                writeSize(out, value.value)
            }
            CaptureEvent.SourceHidden -> Bincode.writeEnumDiscriminant(out, 4)
            CaptureEvent.SourceVisible -> Bincode.writeEnumDiscriminant(out, 5)
            is CaptureEvent.Paused -> {
                Bincode.writeEnumDiscriminant(out, 6)
                writePauseReason(out, value.value)
            }
            CaptureEvent.Resumed -> Bincode.writeEnumDiscriminant(out, 7)
            is CaptureEvent.Exhausted -> {
                Bincode.writeEnumDiscriminant(out, 8)
                writeExhaustionReport(out, value.value)
            }
            CaptureEvent.ConsentRevoked -> Bincode.writeEnumDiscriminant(out, 9)
            CaptureEvent.SourceLost -> Bincode.writeEnumDiscriminant(out, 10)
            is CaptureEvent.Failed -> {
                Bincode.writeEnumDiscriminant(out, 11)
                writeCaptureError(out, value.value)
            }
            is CaptureEvent.Stopped -> {
                Bincode.writeEnumDiscriminant(out, 12)
                writeStopReason(out, value.value)
            }
        }
    }

