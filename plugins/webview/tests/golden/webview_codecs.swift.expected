    public func readTelemetryKind(_ c: inout Bincode.Cursor) throws -> WebView.TelemetryKind {
        let disc = try Bincode.readVarintU32(&c)
        guard let value = WebView.TelemetryKind(rawValue: disc) else {
            throw Bincode.DecodeError.invalidTag(UInt8(clamping: disc))
        }
        return value
    }

    public func writeTelemetryKind(_ out: inout Data, _ value: WebView.TelemetryKind) {
        Bincode.writeVarintU32(&out, value.rawValue)
    }

    public func readTelemetryEvent(_ c: inout Bincode.Cursor) throws -> WebView.TelemetryEvent {
        let disc = try Bincode.readVarintU32(&c)
        switch disc {
        case 0: return .progress(try Bincode.readF32(&c))
        case 1: return .title(try Bincode.readString(&c))
        case 2: return .url(try Bincode.readString(&c))
        case 3: return .favicon(try Bincode.readString(&c))
        case 4: return .history(try self.readHistoryState(&c))
        case 5: return .console(try self.readConsoleLine(&c))
        case 6: return .downloadUpdate(try self.readDownloadProgress(&c))
        case 7: return .downloadFinished(try self.readDownloadDone(&c))
        case 8: return .dropped(try Bincode.readVarintU32(&c))
        default: throw Bincode.DecodeError.invalidTag(UInt8(clamping: disc))
        }
    }

    public func writeTelemetryEvent(_ out: inout Data, _ value: WebView.TelemetryEvent) {
        switch value {
        case .progress(let payload):
            Bincode.writeVarintU32(&out, 0)
            Bincode.writeF32(&out, payload)
        case .title(let payload):
            Bincode.writeVarintU32(&out, 1)
            Bincode.writeString(&out, payload)
        case .url(let payload):
            Bincode.writeVarintU32(&out, 2)
            Bincode.writeString(&out, payload)
        case .favicon(let payload):
            Bincode.writeVarintU32(&out, 3)
            Bincode.writeString(&out, payload)
        case .history(let payload):
            Bincode.writeVarintU32(&out, 4)
            self.writeHistoryState(&out, payload)
        case .console(let payload):
            Bincode.writeVarintU32(&out, 5)
            self.writeConsoleLine(&out, payload)
        case .downloadUpdate(let payload):
            Bincode.writeVarintU32(&out, 6)
            self.writeDownloadProgress(&out, payload)
        case .downloadFinished(let payload):
            Bincode.writeVarintU32(&out, 7)
            self.writeDownloadDone(&out, payload)
        case .dropped(let payload):
            Bincode.writeVarintU32(&out, 8)
            Bincode.writeVarintU32(&out, payload)
        }
    }

    public func readHistoryState(_ c: inout Bincode.Cursor) throws -> WebView.HistoryState {
        let canGoBack = try Bincode.readBool(&c)
        let canGoForward = try Bincode.readBool(&c)
        return WebView.HistoryState(canGoBack: canGoBack, canGoForward: canGoForward)
    }

    public func writeHistoryState(_ out: inout Data, _ value: WebView.HistoryState) {
        Bincode.writeBool(&out, value.canGoBack)
        Bincode.writeBool(&out, value.canGoForward)
    }

    public func readConsoleLine(_ c: inout Bincode.Cursor) throws -> WebView.ConsoleLine {
        let level = try self.readConsoleLevel(&c)
        let message = try Bincode.readString(&c)
