        let disc = try Bincode.readVarintU32(&c)
        guard let value = WebView.WebPermission(rawValue: disc) else {
            throw Bincode.DecodeError.invalidTag(UInt8(clamping: disc))
        }
        return value
    }

    public func writeWebPermission(_ out: inout Data, _ value: WebView.WebPermission) {
