    public func readPendingNotification(_ c: inout Bincode.Cursor) throws -> Notifications.PendingNotification {
        let notification = try self.readNotification(&c)
        let trigger = try self.readTrigger(&c)
        let nextFireMs = try Bincode.readOption(&c) { c1 in try Bincode.readVarintI64(&c1) }
        return Notifications.PendingNotification(notification: notification, trigger: trigger, nextFireMs: nextFireMs)
    }

    public func writePendingNotification(_ out: inout Data, _ value: Notifications.PendingNotification) {
        self.writeNotification(&out, value.notification)
        self.writeTrigger(&out, value.trigger)
        Bincode.writeOption(&out, value.nextFireMs) { o1, v1 in Bincode.writeVarintI64(&o1, v1) }
    }

    public func readDeliveredNotification(_ c: inout Bincode.Cursor) throws -> Notifications.DeliveredNotification {
        let id = try self.readNotificationId(&c)
        let title = try Bincode.readOption(&c) { c1 in try Bincode.readString(&c1) }
        let body = try Bincode.readOption(&c) { c1 in try Bincode.readString(&c1) }
        let group = try Bincode.readOption(&c) { c1 in try self.readGroupId(&c1) }
        let deliveredMs = try Bincode.readOption(&c) { c1 in try Bincode.readVarintI64(&c1) }
        return Notifications.DeliveredNotification(id: id, title: title, body: body, group: group, deliveredMs: deliveredMs)
    }

    public func writeDeliveredNotification(_ out: inout Data, _ value: Notifications.DeliveredNotification) {
        self.writeNotificationId(&out, value.id)
        Bincode.writeOption(&out, value.title) { o1, v1 in Bincode.writeString(&o1, v1) }
        Bincode.writeOption(&out, value.body) { o1, v1 in Bincode.writeString(&o1, v1) }
        Bincode.writeOption(&out, value.group) { o1, v1 in self.writeGroupId(&o1, v1) }
        Bincode.writeOption(&out, value.deliveredMs) { o1, v1 in Bincode.writeVarintI64(&o1, v1) }
    }

    public func readAckToken(_ c: inout Bincode.Cursor) throws -> Notifications.AckToken {
        let value = try Bincode.readVarintU64(&c)
        return Notifications.AckToken(value: value)
    }

    public func writeAckToken(_ out: inout Data, _ value: Notifications.AckToken) {
        Bincode.writeVarintU64(&out, value.value)
    }

    public func readNotificationEvent(_ c: inout Bincode.Cursor) throws -> Notifications.NotificationEvent {
        let disc = try Bincode.readVarintU32(&c)
        switch disc {
        case 0: return .delivered(try self.readNotificationId(&c))
        case 1: return .deliveredLate(try self.readNotificationId(&c))
        case 2: return .dismissed(try self.readDismissal(&c))
        case 3: return .snoozed(try self.readNotificationId(&c))
        case 4: return .failed(try self.readFailure(&c))
        case 5: return .notPromoted(try self.readNotificationId(&c))
        default:
            let payload = c.data.subdata(in: (c.data.endIndex - c.remaining) ..< c.data.endIndex)
            c.offset += payload.count
            return .unknown(discriminant: disc, payload: payload)
        }
    }

    public func writeNotificationEvent(_ out: inout Data, _ value: Notifications.NotificationEvent) {
        switch value {
        case .delivered(let payload):
            Bincode.writeVarintU32(&out, 0)
            self.writeNotificationId(&out, payload)
        case .deliveredLate(let payload):
            Bincode.writeVarintU32(&out, 1)
            self.writeNotificationId(&out, payload)
        case .dismissed(let payload):
            Bincode.writeVarintU32(&out, 2)
            self.writeDismissal(&out, payload)
        case .snoozed(let payload):
            Bincode.writeVarintU32(&out, 3)
            self.writeNotificationId(&out, payload)
        case .failed(let payload):
            Bincode.writeVarintU32(&out, 4)
            self.writeFailure(&out, payload)
        case .notPromoted(let payload):
            Bincode.writeVarintU32(&out, 5)
            self.writeNotificationId(&out, payload)
        case .unknown(let discriminant, let payload):
            Bincode.writeVarintU32(&out, discriminant)
            out.append(payload)
        }
    }

    public func readDismissal(_ c: inout Bincode.Cursor) throws -> Notifications.Dismissal {
        let id = try self.readNotificationId(&c)
        let reason = try self.readDismissReason(&c)
        return Notifications.Dismissal(id: id, reason: reason)
    }

    public func writeDismissal(_ out: inout Data, _ value: Notifications.Dismissal) {
        self.writeNotificationId(&out, value.id)
        self.writeDismissReason(&out, value.reason)
    }

    public func readDismissReason(_ c: inout Bincode.Cursor) throws -> Notifications.DismissReason {
        let disc = try Bincode.readVarintU32(&c)
        switch disc {
        case 0: return .user
        case 1: return .timeout
        case 2: return .app
        case 3: return .other
        default:
            let payload = c.data.subdata(in: (c.data.endIndex - c.remaining) ..< c.data.endIndex)
            c.offset += payload.count
            return .unknown(discriminant: disc, payload: payload)
        }
    }

    public func writeDismissReason(_ out: inout Data, _ value: Notifications.DismissReason) {
        switch value {
        case .user:
            Bincode.writeVarintU32(&out, 0)
        case .timeout:
            Bincode.writeVarintU32(&out, 1)
        case .app:
            Bincode.writeVarintU32(&out, 2)
        case .other:
            Bincode.writeVarintU32(&out, 3)
        case .unknown(let discriminant, let payload):
            Bincode.writeVarintU32(&out, discriminant)
            out.append(payload)
        }
    }

    public func readFailure(_ c: inout Bincode.Cursor) throws -> Notifications.Failure {
        let id = try Bincode.readOption(&c) { c1 in try self.readNotificationId(&c1) }
        let message = try Bincode.readString(&c)
        return Notifications.Failure(id: id, message: message)
    }

    public func writeFailure(_ out: inout Data, _ value: Notifications.Failure) {
        Bincode.writeOption(&out, value.id) { o1, v1 in self.writeNotificationId(&o1, v1) }
        Bincode.writeString(&out, value.message)
    }

    public func readNotificationError(_ c: inout Bincode.Cursor) throws -> Notifications.NotificationError {
        let disc = try Bincode.readVarintU32(&c)
        switch disc {
        case 0: return .unsupported(try self.readFeature(&c))
        case 1: return .permissionDenied
        case 2: return .notBundled
        case 3: return .elevated
        case 4: return .invalid(try self.readInvalidField(&c))
        case 5: return .tooMany(try Bincode.readVarintU32(&c))
        case 6: return .unknownChannel(try Bincode.readString(&c))
        case 7: return .notFound(try Bincode.readString(&c))
        case 8: return .platform(try self.readPlatformError(&c))
        default:
            let payload = c.data.subdata(in: (c.data.endIndex - c.remaining) ..< c.data.endIndex)
            c.offset += payload.count
            return .unknown(discriminant: disc, payload: payload)
        }
    }

    public func writeNotificationError(_ out: inout Data, _ value: Notifications.NotificationError) {
        switch value {
        case .unsupported(let payload):
            Bincode.writeVarintU32(&out, 0)
            self.writeFeature(&out, payload)
        case .permissionDenied:
            Bincode.writeVarintU32(&out, 1)
        case .notBundled:
            Bincode.writeVarintU32(&out, 2)
        case .elevated:
            Bincode.writeVarintU32(&out, 3)
        case .invalid(let payload):
            Bincode.writeVarintU32(&out, 4)
            self.writeInvalidField(&out, payload)
        case .tooMany(let payload):
            Bincode.writeVarintU32(&out, 5)
            Bincode.writeVarintU32(&out, payload)
        case .unknownChannel(let payload):
            Bincode.writeVarintU32(&out, 6)
            Bincode.writeString(&out, payload)
        case .notFound(let payload):
            Bincode.writeVarintU32(&out, 7)
            Bincode.writeString(&out, payload)
        case .platform(let payload):
            Bincode.writeVarintU32(&out, 8)
            self.writePlatformError(&out, payload)
        case .unknown(let discriminant, let payload):
            Bincode.writeVarintU32(&out, discriminant)
            out.append(payload)
        }
    }

    public func readInvalidField(_ c: inout Bincode.Cursor) throws -> Notifications.InvalidField {
        let field = try Bincode.readString(&c)
        let problem = try self.readProblem(&c)
        return Notifications.InvalidField(field: field, problem: problem)
    }

    public func writeInvalidField(_ out: inout Data, _ value: Notifications.InvalidField) {
        Bincode.writeString(&out, value.field)
        self.writeProblem(&out, value.problem)
    }

    public func readProblem(_ c: inout Bincode.Cursor) throws -> Notifications.Problem {
        let disc = try Bincode.readVarintU32(&c)
        switch disc {
        case 0: return .empty
        case 1: return .tooLong
        case 2: return .badCharset
        case 3: return .duplicate
        case 4: return .badUrl
        case 5: return .tooLarge
        case 6: return .outOfRange
        case 7: return .reserved
        case 8: return .notAllowedHere
        default:
            let payload = c.data.subdata(in: (c.data.endIndex - c.remaining) ..< c.data.endIndex)
            c.offset += payload.count
            return .unknown(discriminant: disc, payload: payload)
        }
    }

    public func writeProblem(_ out: inout Data, _ value: Notifications.Problem) {
        switch value {
        case .empty:
            Bincode.writeVarintU32(&out, 0)
        case .tooLong:
            Bincode.writeVarintU32(&out, 1)
        case .badCharset:
            Bincode.writeVarintU32(&out, 2)
        case .duplicate:
            Bincode.writeVarintU32(&out, 3)
        case .badUrl:
            Bincode.writeVarintU32(&out, 4)
        case .tooLarge:
            Bincode.writeVarintU32(&out, 5)
        case .outOfRange:
            Bincode.writeVarintU32(&out, 6)
        case .reserved:
            Bincode.writeVarintU32(&out, 7)
        case .notAllowedHere:
            Bincode.writeVarintU32(&out, 8)
        case .unknown(let discriminant, let payload):
            Bincode.writeVarintU32(&out, discriminant)
            out.append(payload)
        }
    }

    public func readPlatformError(_ c: inout Bincode.Cursor) throws -> Notifications.PlatformError {
        let code = try Bincode.readVarintI64(&c)
        let message = try Bincode.readString(&c)
        return Notifications.PlatformError(code: code, message: message)
    }

    public func writePlatformError(_ out: inout Data, _ value: Notifications.PlatformError) {
        Bincode.writeVarintI64(&out, value.code)
        Bincode.writeString(&out, value.message)
    }

    public func readResponseAction(_ c: inout Bincode.Cursor) throws -> Notifications.ResponseAction {
        let disc = try Bincode.readVarintU32(&c)
        switch disc {
        case 0: return .`open`
        case 1: return .button(try self.readActionId(&c))
        case 2: return .dismiss
        case 3: return .more
        default:
            let payload = c.data.subdata(in: (c.data.endIndex - c.remaining) ..< c.data.endIndex)
            c.offset += payload.count
            return .unknown(discriminant: disc, payload: payload)
        }
    }

    public func writeResponseAction(_ out: inout Data, _ value: Notifications.ResponseAction) {
        switch value {
        case .`open`:
            Bincode.writeVarintU32(&out, 0)
        case .button(let payload):
            Bincode.writeVarintU32(&out, 1)
            self.writeActionId(&out, payload)
        case .dismiss:
            Bincode.writeVarintU32(&out, 2)
        case .more:
            Bincode.writeVarintU32(&out, 3)
        case .unknown(let discriminant, let payload):
            Bincode.writeVarintU32(&out, discriminant)
            out.append(payload)
        }
    }

    public func readNotificationResponse(_ c: inout Bincode.Cursor) throws -> Notifications.NotificationResponse {
        let id = try self.readNotificationId(&c)
        let action = try self.readResponseAction(&c)
        let reply = try Bincode.readOption(&c) { c1 in try Bincode.readString(&c1) }
        let inputRequested = try Bincode.readBool(&c)
        let userData = try Bincode.readOption(&c) { c1 in try Bincode.readString(&c1) }
        let url = try Bincode.readOption(&c) { c1 in try Bincode.readString(&c1) }
        let launchedApp = try Bincode.readBool(&c)
        let overflowActions = try Bincode.readVec(&c) { c1 in try self.readAction(&c1) }
        let ack = try Bincode.readOption(&c) { c1 in try self.readAckToken(&c1) }
        return Notifications.NotificationResponse(id: id, action: action, reply: reply, inputRequested: inputRequested, userData: userData, url: url, launchedApp: launchedApp, overflowActions: overflowActions, ack: ack)
    }

    public func writeNotificationResponse(_ out: inout Data, _ value: Notifications.NotificationResponse) {
        self.writeNotificationId(&out, value.id)
        self.writeResponseAction(&out, value.action)
        Bincode.writeOption(&out, value.reply) { o1, v1 in Bincode.writeString(&o1, v1) }
        Bincode.writeBool(&out, value.inputRequested)
        Bincode.writeOption(&out, value.userData) { o1, v1 in Bincode.writeString(&o1, v1) }
        Bincode.writeOption(&out, value.url) { o1, v1 in Bincode.writeString(&o1, v1) }
        Bincode.writeBool(&out, value.launchedApp)
        Bincode.writeVec(&out, value.overflowActions) { o1, v1 in self.writeAction(&o1, v1) }
        Bincode.writeOption(&out, value.ack) { o1, v1 in self.writeAckToken(&o1, v1) }
    }
}
