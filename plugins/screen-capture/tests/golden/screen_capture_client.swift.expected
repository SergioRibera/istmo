            throw ScreenCaptureException(payload: e.payload, decoded: decoded)
        }
        var c = Bincode.Cursor(bytes)
        return try codecs.readCaptureSession(&c)
    }

    public func update(session: NativeHandleId, update: ScreenCapture.SessionUpdate) async throws -> ScreenCapture.NegotiatedStream {
        var payload = Data()
        codecs.writeNativeHandleId(&payload, session)
        codecs.writeSessionUpdate(&payload, update)
        let bytes: Data
        do {
            bytes = try await IstmoRuntime.shared.call(pluginId: Self.PLUGIN_ID, method: "update", payload: payload)
        } catch let e as PluginException {
            var errCursor = Bincode.Cursor(e.payload)
            let decoded: ScreenCapture.CaptureError? = try? codecs.readCaptureError(&errCursor)
            throw ScreenCaptureException(payload: e.payload, decoded: decoded)
        }
        var c = Bincode.Cursor(bytes)
        return try codecs.readNegotiatedStream(&c)
    }

    public func close(session: NativeHandleId) async throws -> Void {
        var payload = Data()
        codecs.writeNativeHandleId(&payload, session)
        do {
            _ = try await IstmoRuntime.shared.call(pluginId: Self.PLUGIN_ID, method: "close", payload: payload)
        } catch let e as PluginException {
            var errCursor = Bincode.Cursor(e.payload)
            let decoded: ScreenCapture.CaptureError? = try? codecs.readCaptureError(&errCursor)
            throw ScreenCaptureException(payload: e.payload, decoded: decoded)
        }
    }

    public func events(session: NativeHandleId) -> AsyncThrowingStream<ScreenCapture.CaptureEvent, Error> {
        let codecs = self.codecs
        var payload = Data()
        codecs.writeNativeHandleId(&payload, session)
        var events = IstmoRuntime.shared.stream(pluginId: Self.PLUGIN_ID, method: "events", payload: payload).makeAsyncIterator()
        return AsyncThrowingStream(unfolding: {
            let next: Data?
            do {
                next = try await events.next()
            } catch IstmoRuntimeError.streamError(let errPayload) {
                var errCursor = Bincode.Cursor(errPayload)
                let decoded: ScreenCapture.CaptureError? = try? codecs.readCaptureError(&errCursor)
                throw ScreenCaptureException(payload: errPayload, decoded: decoded)
            }
            guard let bytes = next else { return nil }
            var c = Bincode.Cursor(bytes)
            return try codecs.readCaptureEvent(&c)
        })
    }
}

/// Swift-side view of a domain error decoded from `Frame::Respond { Err(bytes) }`.
public struct ScreenCaptureException: Error {
    public let payload: Data
    public let decoded: ScreenCapture.CaptureError?
}
