        Bincode.writeI32(out, value.y)
        Bincode.writeU32(out, value.width)
        Bincode.writeU32(out, value.height)
        Bincode.writeBool(out, value.visible)
    }

    override fun readLoadRequest(bytes: ByteArray, offset: Int): Bincode.Decoded<LoadRequest> {
        var cursor = offset
        val d_url = Bincode.readString(bytes, cursor); cursor = d_url.consumed
        val url = d_url.value
        val d_headers = Bincode.readVec(bytes, cursor) { b1, c1 -> readHttpHeader(b1, c1) }; cursor = d_headers.consumed
        val headers = d_headers.value
        val d_postBody = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readBytes(b1, c1) }; cursor = d_postBody.consumed
        val postBody = d_postBody.value
        return Bincode.Decoded(LoadRequest(url = url, headers = headers, postBody = postBody), cursor)
    }

    override fun writeLoadRequest(out: ByteArrayOutputStream, value: LoadRequest) {
        Bincode.writeString(out, value.url)
        Bincode.writeVec(out, value.headers) { s1, v1 -> writeHttpHeader(s1, v1) }
        Bincode.writeOption(out, value.postBody) { s1, v1 -> Bincode.writeBytes(s1, v1) }
    }

    override fun readHttpHeader(bytes: ByteArray, offset: Int): Bincode.Decoded<HttpHeader> {
        var cursor = offset
        val d_name = Bincode.readString(bytes, cursor); cursor = d_name.consumed
        val name = d_name.value
        val d_value = Bincode.readString(bytes, cursor); cursor = d_value.consumed
        val value = d_value.value
        return Bincode.Decoded(HttpHeader(name = name, value = value), cursor)
    }

    override fun writeHttpHeader(out: ByteArrayOutputStream, value: HttpHeader) {
        Bincode.writeString(out, value.name)
        Bincode.writeString(out, value.value)
    }

    override fun readHistoryNav(bytes: ByteArray, offset: Int): Bincode.Decoded<HistoryNav> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> Bincode.Decoded(HistoryNav.Back, cursor)
            1 -> Bincode.Decoded(HistoryNav.Forward, cursor)
            2 -> Bincode.Decoded(HistoryNav.Reload, cursor)
            3 -> Bincode.Decoded(HistoryNav.ReloadBypassCache, cursor)
            4 -> Bincode.Decoded(HistoryNav.Stop, cursor)
            5 -> {
                val d_inner = Bincode.readI32(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(HistoryNav.Offset(inner) as HistoryNav, cursor)
            }
            else -> throw Bincode.DecodeException("HistoryNav: unknown discriminant ${disc.value}")
        }
    }

    override fun writeHistoryNav(out: ByteArrayOutputStream, value: HistoryNav) {
        when (value) {
            HistoryNav.Back -> Bincode.writeEnumDiscriminant(out, 0)
            HistoryNav.Forward -> Bincode.writeEnumDiscriminant(out, 1)
            HistoryNav.Reload -> Bincode.writeEnumDiscriminant(out, 2)
            HistoryNav.ReloadBypassCache -> Bincode.writeEnumDiscriminant(out, 3)
            HistoryNav.Stop -> Bincode.writeEnumDiscriminant(out, 4)
            is HistoryNav.Offset -> {
                Bincode.writeEnumDiscriminant(out, 5)
                Bincode.writeI32(out, value.value)
            }
        }
    }

    override fun readWebHistory(bytes: ByteArray, offset: Int): Bincode.Decoded<WebHistory> {
        var cursor = offset
        val d_entries = Bincode.readVec(bytes, cursor) { b1, c1 -> readHistoryEntry(b1, c1) }; cursor = d_entries.consumed
        val entries = d_entries.value
        val d_current = Bincode.readU32(bytes, cursor); cursor = d_current.consumed
        val current = d_current.value
        return Bincode.Decoded(WebHistory(entries = entries, current = current), cursor)
    }

    override fun writeWebHistory(out: ByteArrayOutputStream, value: WebHistory) {
        Bincode.writeVec(out, value.entries) { s1, v1 -> writeHistoryEntry(s1, v1) }
        Bincode.writeU32(out, value.current)
    }

    override fun readHistoryEntry(bytes: ByteArray, offset: Int): Bincode.Decoded<HistoryEntry> {
        var cursor = offset
        val d_url = Bincode.readString(bytes, cursor); cursor = d_url.consumed
        val url = d_url.value
        val d_title = Bincode.readString(bytes, cursor); cursor = d_title.consumed
        val title = d_title.value
        return Bincode.Decoded(HistoryEntry(url = url, title = title), cursor)
    }

    override fun writeHistoryEntry(out: ByteArrayOutputStream, value: HistoryEntry) {
        Bincode.writeString(out, value.url)
        Bincode.writeString(out, value.title)
    }

    override fun readScriptCall(bytes: ByteArray, offset: Int): Bincode.Decoded<ScriptCall> {
        var cursor = offset
        val d_source = Bincode.readString(bytes, cursor); cursor = d_source.consumed
        val source = d_source.value
        val d_world = readScriptWorld(bytes, cursor); cursor = d_world.consumed
        val world = d_world.value
        val d_expectedOrigin = Bincode.readString(bytes, cursor); cursor = d_expectedOrigin.consumed
        val expectedOrigin = d_expectedOrigin.value
        return Bincode.Decoded(ScriptCall(source = source, world = world, expectedOrigin = expectedOrigin), cursor)
    }

    override fun writeScriptCall(out: ByteArrayOutputStream, value: ScriptCall) {
        Bincode.writeString(out, value.source)
        writeScriptWorld(out, value.world)
        Bincode.writeString(out, value.expectedOrigin)
    }

    override fun readOutgoingMessage(bytes: ByteArray, offset: Int): Bincode.Decoded<OutgoingMessage> {
        var cursor = offset
        val d_channel = Bincode.readString(bytes, cursor); cursor = d_channel.consumed
        val channel = d_channel.value
        val d_data = Bincode.readBytes(bytes, cursor); cursor = d_data.consumed
        val data = d_data.value
        val d_expectedOrigin = Bincode.readString(bytes, cursor); cursor = d_expectedOrigin.consumed
        val expectedOrigin = d_expectedOrigin.value
        return Bincode.Decoded(OutgoingMessage(channel = channel, data = data, expectedOrigin = expectedOrigin), cursor)
    }

    override fun writeOutgoingMessage(out: ByteArrayOutputStream, value: OutgoingMessage) {
        Bincode.writeString(out, value.channel)
        Bincode.writeBytes(out, value.data)
        Bincode.writeString(out, value.expectedOrigin)
    }

    override fun readBridgeReply(bytes: ByteArray, offset: Int): Bincode.Decoded<BridgeReply> {
        var cursor = offset
        val d_replyId = Bincode.readU64(bytes, cursor); cursor = d_replyId.consumed
        val replyId = d_replyId.value
        val d_result = readReplyResult(bytes, cursor); cursor = d_result.consumed
        val result = d_result.value
        return Bincode.Decoded(BridgeReply(replyId = replyId, result = result), cursor)
    }

    override fun writeBridgeReply(out: ByteArrayOutputStream, value: BridgeReply) {
        Bincode.writeU64(out, value.replyId)
        writeReplyResult(out, value.result)
    }

    override fun readReplyResult(bytes: ByteArray, offset: Int): Bincode.Decoded<ReplyResult> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> {
                val d_inner = Bincode.readBytes(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(ReplyResult.Ok(inner) as ReplyResult, cursor)
            }
            1 -> {
                val d_inner = Bincode.readString(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(ReplyResult.Err(inner) as ReplyResult, cursor)
            }
            else -> throw Bincode.DecodeException("ReplyResult: unknown discriminant ${disc.value}")
        }
    }

    override fun writeReplyResult(out: ByteArrayOutputStream, value: ReplyResult) {
        when (value) {
            is ReplyResult.Ok -> {
                Bincode.writeEnumDiscriminant(out, 0)
                Bincode.writeBytes(out, value.value)
            }
            is ReplyResult.Err -> {
                Bincode.writeEnumDiscriminant(out, 1)
                Bincode.writeString(out, value.value)
            }
        }
    }

    override fun readDecision(bytes: ByteArray, offset: Int): Bincode.Decoded<Decision> {
        var cursor = offset
        val d_requestId = Bincode.readU64(bytes, cursor); cursor = d_requestId.consumed
        val requestId = d_requestId.value
        val d_response = readDecisionResponse(bytes, cursor); cursor = d_response.consumed
        val response = d_response.value
        return Bincode.Decoded(Decision(requestId = requestId, response = response), cursor)
    }

    override fun writeDecision(out: ByteArrayOutputStream, value: Decision) {
        Bincode.writeU64(out, value.requestId)
        writeDecisionResponse(out, value.response)
    }

    override fun readDecisionResponse(bytes: ByteArray, offset: Int): Bincode.Decoded<DecisionResponse> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> Bincode.Decoded(DecisionResponse.Allow, cursor)
            1 -> Bincode.Decoded(DecisionResponse.Deny, cursor)
            2 -> {
                val d_inner = Bincode.readVec(bytes, cursor) { b1, c1 -> readWebPermission(b1, c1) }; cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(DecisionResponse.Grant(inner) as DecisionResponse, cursor)
            }
            3 -> {
                val d_inner = readHttpCredentials(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(DecisionResponse.Credentials(inner) as DecisionResponse, cursor)
            }
            4 -> {
                val d_inner = Bincode.readVec(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(DecisionResponse.Files(inner) as DecisionResponse, cursor)
            }
            5 -> {
                val d_inner = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(DecisionResponse.DialogAccept(inner) as DecisionResponse, cursor)
            }
            6 -> {
                val d_inner = Bincode.readString(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(DecisionResponse.DownloadTo(inner) as DecisionResponse, cursor)
            }
            else -> throw Bincode.DecodeException("DecisionResponse: unknown discriminant ${disc.value}")
        }
    }

    override fun writeDecisionResponse(out: ByteArrayOutputStream, value: DecisionResponse) {
        when (value) {
            DecisionResponse.Allow -> Bincode.writeEnumDiscriminant(out, 0)
            DecisionResponse.Deny -> Bincode.writeEnumDiscriminant(out, 1)
            is DecisionResponse.Grant -> {
                Bincode.writeEnumDiscriminant(out, 2)
                Bincode.writeVec(out, value.value) { s1, v1 -> writeWebPermission(s1, v1) }
            }
            is DecisionResponse.Credentials -> {
                Bincode.writeEnumDiscriminant(out, 3)
                writeHttpCredentials(out, value.value)
            }
            is DecisionResponse.Files -> {
                Bincode.writeEnumDiscriminant(out, 4)
                Bincode.writeVec(out, value.value) { s1, v1 -> Bincode.writeString(s1, v1) }
            }
            is DecisionResponse.DialogAccept -> {
                Bincode.writeEnumDiscriminant(out, 5)
                Bincode.writeOption(out, value.value) { s1, v1 -> Bincode.writeString(s1, v1) }
            }
            is DecisionResponse.DownloadTo -> {
                Bincode.writeEnumDiscriminant(out, 6)
                Bincode.writeString(out, value.value)
            }
        }
    }

    override fun readHttpCredentials(bytes: ByteArray, offset: Int): Bincode.Decoded<HttpCredentials> {
        var cursor = offset
        val d_user = Bincode.readString(bytes, cursor); cursor = d_user.consumed
        val user = d_user.value
        val d_password = Bincode.readString(bytes, cursor); cursor = d_password.consumed
        val password = d_password.value
        return Bincode.Decoded(HttpCredentials(user = user, password = password), cursor)
    }

    override fun writeHttpCredentials(out: ByteArrayOutputStream, value: HttpCredentials) {
        Bincode.writeString(out, value.user)
        Bincode.writeString(out, value.password)
    }

    override fun readSchemeResponseHead(bytes: ByteArray, offset: Int): Bincode.Decoded<SchemeResponseHead> {
        var cursor = offset
        val d_requestId = Bincode.readU64(bytes, cursor); cursor = d_requestId.consumed
        val requestId = d_requestId.value
        val d_status = Bincode.readU16(bytes, cursor); cursor = d_status.consumed
        val status = d_status.value
        val d_mimeType = Bincode.readString(bytes, cursor); cursor = d_mimeType.consumed
        val mimeType = d_mimeType.value
        val d_headers = Bincode.readVec(bytes, cursor) { b1, c1 -> readHttpHeader(b1, c1) }; cursor = d_headers.consumed
        val headers = d_headers.value
        val d_contentLength = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readU64(b1, c1) }; cursor = d_contentLength.consumed
        val contentLength = d_contentLength.value
        return Bincode.Decoded(SchemeResponseHead(requestId = requestId, status = status, mimeType = mimeType, headers = headers, contentLength = contentLength), cursor)
    }

    override fun writeSchemeResponseHead(out: ByteArrayOutputStream, value: SchemeResponseHead) {
        Bincode.writeU64(out, value.requestId)
        Bincode.writeU16(out, value.status)
        Bincode.writeString(out, value.mimeType)
        Bincode.writeVec(out, value.headers) { s1, v1 -> writeHttpHeader(s1, v1) }
        Bincode.writeOption(out, value.contentLength) { s1, v1 -> Bincode.writeU64(s1, v1) }
    }

    override fun readSchemeChunk(bytes: ByteArray, offset: Int): Bincode.Decoded<SchemeChunk> {
        var cursor = offset
        val d_requestId = Bincode.readU64(bytes, cursor); cursor = d_requestId.consumed
        val requestId = d_requestId.value
        val d_body = readSchemeBody(bytes, cursor); cursor = d_body.consumed
        val body = d_body.value
        return Bincode.Decoded(SchemeChunk(requestId = requestId, body = body), cursor)
    }

    override fun writeSchemeChunk(out: ByteArrayOutputStream, value: SchemeChunk) {
        Bincode.writeU64(out, value.requestId)
        writeSchemeBody(out, value.body)
    }

    override fun readSchemeBody(bytes: ByteArray, offset: Int): Bincode.Decoded<SchemeBody> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> {
                val d_inner = Bincode.readBytes(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(SchemeBody.Data(inner) as SchemeBody, cursor)
            }
            1 -> Bincode.Decoded(SchemeBody.End, cursor)
            2 -> {
                val d_inner = Bincode.readString(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(SchemeBody.Abort(inner) as SchemeBody, cursor)
            }
            else -> throw Bincode.DecodeException("SchemeBody: unknown discriminant ${disc.value}")
        }
    }

    override fun writeSchemeBody(out: ByteArrayOutputStream, value: SchemeBody) {
        when (value) {
            is SchemeBody.Data -> {
                Bincode.writeEnumDiscriminant(out, 0)
                Bincode.writeBytes(out, value.value)
            }
            SchemeBody.End -> Bincode.writeEnumDiscriminant(out, 1)
            is SchemeBody.Abort -> {
                Bincode.writeEnumDiscriminant(out, 2)
                Bincode.writeString(out, value.value)
            }
        }
    }

    override fun readWebCookie(bytes: ByteArray, offset: Int): Bincode.Decoded<WebCookie> {
        var cursor = offset
        val d_name = Bincode.readString(bytes, cursor); cursor = d_name.consumed
        val name = d_name.value
        val d_value = Bincode.readString(bytes, cursor); cursor = d_value.consumed
        val value = d_value.value
        val d_domain = Bincode.readString(bytes, cursor); cursor = d_domain.consumed
        val domain = d_domain.value
        val d_path = Bincode.readString(bytes, cursor); cursor = d_path.consumed
        val path = d_path.value
        val d_expiresUnixMs = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readI64(b1, c1) }; cursor = d_expiresUnixMs.consumed
        val expiresUnixMs = d_expiresUnixMs.value
        val d_secure = Bincode.readBool(bytes, cursor); cursor = d_secure.consumed
        val secure = d_secure.value
        val d_httpOnly = Bincode.readBool(bytes, cursor); cursor = d_httpOnly.consumed
        val httpOnly = d_httpOnly.value
        val d_sameSite = readSameSite(bytes, cursor); cursor = d_sameSite.consumed
        val sameSite = d_sameSite.value
        return Bincode.Decoded(WebCookie(name = name, value = value, domain = domain, path = path, expiresUnixMs = expiresUnixMs, secure = secure, httpOnly = httpOnly, sameSite = sameSite), cursor)
    }

    override fun writeWebCookie(out: ByteArrayOutputStream, value: WebCookie) {
        Bincode.writeString(out, value.name)
        Bincode.writeString(out, value.value)
        Bincode.writeString(out, value.domain)
        Bincode.writeString(out, value.path)
        Bincode.writeOption(out, value.expiresUnixMs) { s1, v1 -> Bincode.writeI64(s1, v1) }
        Bincode.writeBool(out, value.secure)
        Bincode.writeBool(out, value.httpOnly)
        writeSameSite(out, value.sameSite)
    }

    override fun readSameSite(bytes: ByteArray, offset: Int): Bincode.Decoded<SameSite> {
        val d = Bincode.readEnumDiscriminant(bytes, offset)
        val variant = SameSite.entries.getOrNull(d.value)
            ?: throw Bincode.DecodeException("SameSite: unknown discriminant ${d.value}")
        return Bincode.Decoded(variant, d.consumed)
    }

    override fun writeSameSite(out: ByteArrayOutputStream, value: SameSite) {
        Bincode.writeEnumDiscriminant(out, value.ordinal)
    }

    override fun readCookieFilter(bytes: ByteArray, offset: Int): Bincode.Decoded<CookieFilter> {
        var cursor = offset
        val d_url = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_url.consumed
        val url = d_url.value
        val d_name = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_name.consumed
        val name = d_name.value
        return Bincode.Decoded(CookieFilter(url = url, name = name), cursor)
    }

    override fun writeCookieFilter(out: ByteArrayOutputStream, value: CookieFilter) {
        Bincode.writeOption(out, value.url) { s1, v1 -> Bincode.writeString(s1, v1) }
        Bincode.writeOption(out, value.name) { s1, v1 -> Bincode.writeString(s1, v1) }
    }

    override fun readClearDataRequest(bytes: ByteArray, offset: Int): Bincode.Decoded<ClearDataRequest> {
        var cursor = offset
        val d_kinds = Bincode.readVec(bytes, cursor) { b1, c1 -> readDataKind(b1, c1) }; cursor = d_kinds.consumed
        val kinds = d_kinds.value
        val d_sinceUnixMs = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readI64(b1, c1) }; cursor = d_sinceUnixMs.consumed
        val sinceUnixMs = d_sinceUnixMs.value
        return Bincode.Decoded(ClearDataRequest(kinds = kinds, sinceUnixMs = sinceUnixMs), cursor)
    }

    override fun writeClearDataRequest(out: ByteArrayOutputStream, value: ClearDataRequest) {
        Bincode.writeVec(out, value.kinds) { s1, v1 -> writeDataKind(s1, v1) }
        Bincode.writeOption(out, value.sinceUnixMs) { s1, v1 -> Bincode.writeI64(s1, v1) }
    }

    override fun readDataKind(bytes: ByteArray, offset: Int): Bincode.Decoded<DataKind> {
        val d = Bincode.readEnumDiscriminant(bytes, offset)
        val variant = DataKind.entries.getOrNull(d.value)
            ?: throw Bincode.DecodeException("DataKind: unknown discriminant ${d.value}")
        return Bincode.Decoded(variant, d.consumed)
    }

    override fun writeDataKind(out: ByteArrayOutputStream, value: DataKind) {
        Bincode.writeEnumDiscriminant(out, value.ordinal)
    }

    override fun readFindQuery(bytes: ByteArray, offset: Int): Bincode.Decoded<FindQuery> {
        var cursor = offset
        val d_text = Bincode.readString(bytes, cursor); cursor = d_text.consumed
        val text = d_text.value
        val d_backwards = Bincode.readBool(bytes, cursor); cursor = d_backwards.consumed
        val backwards = d_backwards.value
        val d_caseSensitive = Bincode.readBool(bytes, cursor); cursor = d_caseSensitive.consumed
        val caseSensitive = d_caseSensitive.value
        val d_wrap = Bincode.readBool(bytes, cursor); cursor = d_wrap.consumed
        val wrap = d_wrap.value
        return Bincode.Decoded(FindQuery(text = text, backwards = backwards, caseSensitive = caseSensitive, wrap = wrap), cursor)
    }

    override fun writeFindQuery(out: ByteArrayOutputStream, value: FindQuery) {
        Bincode.writeString(out, value.text)
        Bincode.writeBool(out, value.backwards)
        Bincode.writeBool(out, value.caseSensitive)
        Bincode.writeBool(out, value.wrap)
    }

    override fun readFindResult(bytes: ByteArray, offset: Int): Bincode.Decoded<FindResult> {
        var cursor = offset
        val d_matches = Bincode.readU32(bytes, cursor); cursor = d_matches.consumed
        val matches = d_matches.value
        val d_active = Bincode.readU32(bytes, cursor); cursor = d_active.consumed
        val active = d_active.value
        return Bincode.Decoded(FindResult(matches = matches, active = active), cursor)
    }

    override fun writeFindResult(out: ByteArrayOutputStream, value: FindResult) {
        Bincode.writeU32(out, value.matches)
        Bincode.writeU32(out, value.active)
    }

    override fun readSnapshotOptions(bytes: ByteArray, offset: Int): Bincode.Decoded<SnapshotOptions> {
        var cursor = offset
        val d_maxWidth = Bincode.readU32(bytes, cursor); cursor = d_maxWidth.consumed
        val maxWidth = d_maxWidth.value
        val d_format = readSnapshotFormat(bytes, cursor); cursor = d_format.consumed
        val format = d_format.value
        return Bincode.Decoded(SnapshotOptions(maxWidth = maxWidth, format = format), cursor)
    }

    override fun writeSnapshotOptions(out: ByteArrayOutputStream, value: SnapshotOptions) {
        Bincode.writeU32(out, value.maxWidth)
        writeSnapshotFormat(out, value.format)
    }

    override fun readSnapshotFormat(bytes: ByteArray, offset: Int): Bincode.Decoded<SnapshotFormat> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> Bincode.Decoded(SnapshotFormat.Png, cursor)
            1 -> {
                val d_inner = Bincode.readU8(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(SnapshotFormat.Jpeg(inner) as SnapshotFormat, cursor)
            }
            else -> throw Bincode.DecodeException("SnapshotFormat: unknown discriminant ${disc.value}")
        }
    }

    override fun writeSnapshotFormat(out: ByteArrayOutputStream, value: SnapshotFormat) {
        when (value) {
            SnapshotFormat.Png -> Bincode.writeEnumDiscriminant(out, 0)
            is SnapshotFormat.Jpeg -> {
                Bincode.writeEnumDiscriminant(out, 1)
                Bincode.writeU8(out, value.value)
            }
        }
    }

    override fun readWebSnapshot(bytes: ByteArray, offset: Int): Bincode.Decoded<WebSnapshot> {
        var cursor = offset
        val d_width = Bincode.readU32(bytes, cursor); cursor = d_width.consumed
        val width = d_width.value
        val d_height = Bincode.readU32(bytes, cursor); cursor = d_height.consumed
        val height = d_height.value
        val d_format = readSnapshotFormat(bytes, cursor); cursor = d_format.consumed
        val format = d_format.value
        val d_bytes_ = Bincode.readBytes(bytes, cursor); cursor = d_bytes_.consumed
        val bytes_ = d_bytes_.value
        return Bincode.Decoded(WebSnapshot(width = width, height = height, format = format, bytes = bytes_), cursor)
    }

    override fun writeWebSnapshot(out: ByteArrayOutputStream, value: WebSnapshot) {
        Bincode.writeU32(out, value.width)
        Bincode.writeU32(out, value.height)
        writeSnapshotFormat(out, value.format)
        Bincode.writeBytes(out, value.bytes)
    }

    override fun readDownloadOp(bytes: ByteArray, offset: Int): Bincode.Decoded<DownloadOp> {
        var cursor = offset
        val d_downloadId = Bincode.readU64(bytes, cursor); cursor = d_downloadId.consumed
        val downloadId = d_downloadId.value
        val d_action = readDownloadAction(bytes, cursor); cursor = d_action.consumed
        val action = d_action.value
        return Bincode.Decoded(DownloadOp(downloadId = downloadId, action = action), cursor)
    }

    override fun writeDownloadOp(out: ByteArrayOutputStream, value: DownloadOp) {
        Bincode.writeU64(out, value.downloadId)
        writeDownloadAction(out, value.action)
    }

    override fun readDownloadAction(bytes: ByteArray, offset: Int): Bincode.Decoded<DownloadAction> {
        val d = Bincode.readEnumDiscriminant(bytes, offset)
        val variant = DownloadAction.entries.getOrNull(d.value)
            ?: throw Bincode.DecodeException("DownloadAction: unknown discriminant ${d.value}")
        return Bincode.Decoded(variant, d.consumed)
    }

    override fun writeDownloadAction(out: ByteArrayOutputStream, value: DownloadAction) {
        Bincode.writeEnumDiscriminant(out, value.ordinal)
    }

    override fun readControlEvent(bytes: ByteArray, offset: Int): Bincode.Decoded<ControlEvent> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> {
                val d_inner = readNavInfo(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(ControlEvent.NavigationStarted(inner) as ControlEvent, cursor)
            }
            1 -> {
                val d_inner = readNavInfo(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(ControlEvent.NavigationCommitted(inner) as ControlEvent, cursor)
            }
            2 -> {
                val d_inner = readNavInfo(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(ControlEvent.NavigationFinished(inner) as ControlEvent, cursor)
            }
            3 -> {
                val d_inner = readNavFailure(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(ControlEvent.NavigationFailed(inner) as ControlEvent, cursor)
            }
            4 -> {
                val d_inner = readInterceptedNav(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(ControlEvent.Intercepted(inner) as ControlEvent, cursor)
            }
            5 -> {
                val d_inner = readDecisionRequest(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(ControlEvent.DecisionRequested(inner) as ControlEvent, cursor)
            }
            6 -> {
                val d_inner = readSchemeRequestInfo(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(ControlEvent.SchemeRequest(inner) as ControlEvent, cursor)
            }
            7 -> {
                val d_inner = readBridgeMessage(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(ControlEvent.Message(inner) as ControlEvent, cursor)
            }
            8 -> {
                val d_inner = readNewViewInfo(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(ControlEvent.NewView(inner) as ControlEvent, cursor)
            }
            9 -> Bincode.Decoded(ControlEvent.CloseRequested, cursor)
            10 -> {
                val d_inner = Bincode.readBool(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(ControlEvent.FullscreenChanged(inner) as ControlEvent, cursor)
            }
            11 -> {
                val d_inner = readTerminationInfo(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(ControlEvent.ProcessTerminated(inner) as ControlEvent, cursor)
            }
            else -> throw Bincode.DecodeException("ControlEvent: unknown discriminant ${disc.value}")
        }
    }

    override fun writeControlEvent(out: ByteArrayOutputStream, value: ControlEvent) {
        when (value) {
            is ControlEvent.NavigationStarted -> {
                Bincode.writeEnumDiscriminant(out, 0)
                writeNavInfo(out, value.value)
            }
            is ControlEvent.NavigationCommitted -> {
                Bincode.writeEnumDiscriminant(out, 1)
                writeNavInfo(out, value.value)
            }
            is ControlEvent.NavigationFinished -> {
                Bincode.writeEnumDiscriminant(out, 2)
                writeNavInfo(out, value.value)
            }
            is ControlEvent.NavigationFailed -> {
                Bincode.writeEnumDiscriminant(out, 3)
                writeNavFailure(out, value.value)
            }
            is ControlEvent.Intercepted -> {
                Bincode.writeEnumDiscriminant(out, 4)
                writeInterceptedNav(out, value.value)
            }
            is ControlEvent.DecisionRequested -> {
                Bincode.writeEnumDiscriminant(out, 5)
                writeDecisionRequest(out, value.value)
            }
            is ControlEvent.SchemeRequest -> {
                Bincode.writeEnumDiscriminant(out, 6)
                writeSchemeRequestInfo(out, value.value)
            }
            is ControlEvent.Message -> {
                Bincode.writeEnumDiscriminant(out, 7)
                writeBridgeMessage(out, value.value)
            }
            is ControlEvent.NewView -> {
                Bincode.writeEnumDiscriminant(out, 8)
                writeNewViewInfo(out, value.value)
            }
            ControlEvent.CloseRequested -> Bincode.writeEnumDiscriminant(out, 9)
            is ControlEvent.FullscreenChanged -> {
                Bincode.writeEnumDiscriminant(out, 10)
                Bincode.writeBool(out, value.value)
            }
            is ControlEvent.ProcessTerminated -> {
                Bincode.writeEnumDiscriminant(out, 11)
                writeTerminationInfo(out, value.value)
            }
        }
    }

    override fun readNavInfo(bytes: ByteArray, offset: Int): Bincode.Decoded<NavInfo> {
        var cursor = offset
        val d_navigationId = Bincode.readU64(bytes, cursor); cursor = d_navigationId.consumed
        val navigationId = d_navigationId.value
        val d_url = Bincode.readString(bytes, cursor); cursor = d_url.consumed
        val url = d_url.value
        val d_isRedirect = Bincode.readBool(bytes, cursor); cursor = d_isRedirect.consumed
        val isRedirect = d_isRedirect.value
        val d_userGesture = Bincode.readBool(bytes, cursor); cursor = d_userGesture.consumed
        val userGesture = d_userGesture.value
        return Bincode.Decoded(NavInfo(navigationId = navigationId, url = url, isRedirect = isRedirect, userGesture = userGesture), cursor)
    }

    override fun writeNavInfo(out: ByteArrayOutputStream, value: NavInfo) {
        Bincode.writeU64(out, value.navigationId)
        Bincode.writeString(out, value.url)
        Bincode.writeBool(out, value.isRedirect)
        Bincode.writeBool(out, value.userGesture)
    }

    override fun readNavFailure(bytes: ByteArray, offset: Int): Bincode.Decoded<NavFailure> {
        var cursor = offset
        val d_navigationId = Bincode.readU64(bytes, cursor); cursor = d_navigationId.consumed
        val navigationId = d_navigationId.value
        val d_url = Bincode.readString(bytes, cursor); cursor = d_url.consumed
        val url = d_url.value
        val d_kind = readNavErrorKind(bytes, cursor); cursor = d_kind.consumed
        val kind = d_kind.value
        val d_description = Bincode.readString(bytes, cursor); cursor = d_description.consumed
        val description = d_description.value
        return Bincode.Decoded(NavFailure(navigationId = navigationId, url = url, kind = kind, description = description), cursor)
    }

    override fun writeNavFailure(out: ByteArrayOutputStream, value: NavFailure) {
        Bincode.writeU64(out, value.navigationId)
        Bincode.writeString(out, value.url)
        writeNavErrorKind(out, value.kind)
        Bincode.writeString(out, value.description)
    }

    override fun readNavErrorKind(bytes: ByteArray, offset: Int): Bincode.Decoded<NavErrorKind> {
        val d = Bincode.readEnumDiscriminant(bytes, offset)
        val variant = NavErrorKind.entries.getOrNull(d.value)
            ?: throw Bincode.DecodeException("NavErrorKind: unknown discriminant ${d.value}")
        return Bincode.Decoded(variant, d.consumed)
    }

    override fun writeNavErrorKind(out: ByteArrayOutputStream, value: NavErrorKind) {
        Bincode.writeEnumDiscriminant(out, value.ordinal)
    }

    override fun readInterceptedNav(bytes: ByteArray, offset: Int): Bincode.Decoded<InterceptedNav> {
        var cursor = offset
        val d_navigationId = Bincode.readU64(bytes, cursor); cursor = d_navigationId.consumed
        val navigationId = d_navigationId.value
        val d_url = Bincode.readString(bytes, cursor); cursor = d_url.consumed
        val url = d_url.value
        return Bincode.Decoded(InterceptedNav(navigationId = navigationId, url = url), cursor)
    }

    override fun writeInterceptedNav(out: ByteArrayOutputStream, value: InterceptedNav) {
        Bincode.writeU64(out, value.navigationId)
        Bincode.writeString(out, value.url)
    }

    override fun readDecisionRequest(bytes: ByteArray, offset: Int): Bincode.Decoded<DecisionRequest> {
        var cursor = offset
        val d_requestId = Bincode.readU64(bytes, cursor); cursor = d_requestId.consumed
        val requestId = d_requestId.value
        val d_kind = readDecisionKind(bytes, cursor); cursor = d_kind.consumed
        val kind = d_kind.value
        return Bincode.Decoded(DecisionRequest(requestId = requestId, kind = kind), cursor)
    }

    override fun writeDecisionRequest(out: ByteArrayOutputStream, value: DecisionRequest) {
        Bincode.writeU64(out, value.requestId)
        writeDecisionKind(out, value.kind)
    }

    override fun readDecisionKind(bytes: ByteArray, offset: Int): Bincode.Decoded<DecisionKind> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> {
                val d_inner = readNavInfo(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(DecisionKind.Navigation(inner) as DecisionKind, cursor)
            }
            1 -> {
                val d_inner = readNewWindowAsk(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(DecisionKind.NewWindow(inner) as DecisionKind, cursor)
            }
            2 -> {
                val d_inner = readPermissionAsk(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(DecisionKind.Permission(inner) as DecisionKind, cursor)
            }
            3 -> {
                val d_inner = readHttpAuthAsk(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(DecisionKind.HttpAuth(inner) as DecisionKind, cursor)
            }
            4 -> {
                val d_inner = readTlsErrorInfo(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(DecisionKind.TlsError(inner) as DecisionKind, cursor)
            }
            5 -> {
                val d_inner = readFileChooserAsk(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(DecisionKind.FileChooser(inner) as DecisionKind, cursor)
            }
            6 -> {
                val d_inner = readDialogAsk(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(DecisionKind.Dialog(inner) as DecisionKind, cursor)
            }
            7 -> {
                val d_inner = readDownloadAsk(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(DecisionKind.Download(inner) as DecisionKind, cursor)
            }
            else -> throw Bincode.DecodeException("DecisionKind: unknown discriminant ${disc.value}")
        }
    }

    override fun writeDecisionKind(out: ByteArrayOutputStream, value: DecisionKind) {
        when (value) {
            is DecisionKind.Navigation -> {
                Bincode.writeEnumDiscriminant(out, 0)
                writeNavInfo(out, value.value)
            }
            is DecisionKind.NewWindow -> {
                Bincode.writeEnumDiscriminant(out, 1)
                writeNewWindowAsk(out, value.value)
            }
            is DecisionKind.Permission -> {
                Bincode.writeEnumDiscriminant(out, 2)
                writePermissionAsk(out, value.value)
            }
            is DecisionKind.HttpAuth -> {
                Bincode.writeEnumDiscriminant(out, 3)
                writeHttpAuthAsk(out, value.value)
            }
            is DecisionKind.TlsError -> {
                Bincode.writeEnumDiscriminant(out, 4)
                writeTlsErrorInfo(out, value.value)
            }
            is DecisionKind.FileChooser -> {
                Bincode.writeEnumDiscriminant(out, 5)
                writeFileChooserAsk(out, value.value)
            }
            is DecisionKind.Dialog -> {
                Bincode.writeEnumDiscriminant(out, 6)
                writeDialogAsk(out, value.value)
            }
            is DecisionKind.Download -> {
                Bincode.writeEnumDiscriminant(out, 7)
                writeDownloadAsk(out, value.value)
            }
        }
    }

    override fun readNewWindowAsk(bytes: ByteArray, offset: Int): Bincode.Decoded<NewWindowAsk> {
        var cursor = offset
        val d_url = Bincode.readString(bytes, cursor); cursor = d_url.consumed
        val url = d_url.value
        val d_userGesture = Bincode.readBool(bytes, cursor); cursor = d_userGesture.consumed
        val userGesture = d_userGesture.value
        return Bincode.Decoded(NewWindowAsk(url = url, userGesture = userGesture), cursor)
    }

    override fun writeNewWindowAsk(out: ByteArrayOutputStream, value: NewWindowAsk) {
        Bincode.writeString(out, value.url)
        Bincode.writeBool(out, value.userGesture)
    }

    override fun readPermissionAsk(bytes: ByteArray, offset: Int): Bincode.Decoded<PermissionAsk> {
        var cursor = offset
        val d_permissions = Bincode.readVec(bytes, cursor) { b1, c1 -> readWebPermission(b1, c1) }; cursor = d_permissions.consumed
        val permissions = d_permissions.value
        val d_frameOrigin = Bincode.readString(bytes, cursor); cursor = d_frameOrigin.consumed
        val frameOrigin = d_frameOrigin.value
        val d_topOrigin = Bincode.readString(bytes, cursor); cursor = d_topOrigin.consumed
        val topOrigin = d_topOrigin.value
        return Bincode.Decoded(PermissionAsk(permissions = permissions, frameOrigin = frameOrigin, topOrigin = topOrigin), cursor)
    }

    override fun writePermissionAsk(out: ByteArrayOutputStream, value: PermissionAsk) {
        Bincode.writeVec(out, value.permissions) { s1, v1 -> writeWebPermission(s1, v1) }
        Bincode.writeString(out, value.frameOrigin)
        Bincode.writeString(out, value.topOrigin)
    }

    override fun readWebPermission(bytes: ByteArray, offset: Int): Bincode.Decoded<WebPermission> {
        val d = Bincode.readEnumDiscriminant(bytes, offset)
        val variant = WebPermission.entries.getOrNull(d.value)
            ?: throw Bincode.DecodeException("WebPermission: unknown discriminant ${d.value}")
        return Bincode.Decoded(variant, d.consumed)
    }

    override fun writeWebPermission(out: ByteArrayOutputStream, value: WebPermission) {
        Bincode.writeEnumDiscriminant(out, value.ordinal)
    }

    override fun readHttpAuthAsk(bytes: ByteArray, offset: Int): Bincode.Decoded<HttpAuthAsk> {
        var cursor = offset
        val d_host = Bincode.readString(bytes, cursor); cursor = d_host.consumed
        val host = d_host.value
        val d_realm = Bincode.readString(bytes, cursor); cursor = d_realm.consumed
        val realm = d_realm.value
        val d_isProxy = Bincode.readBool(bytes, cursor); cursor = d_isProxy.consumed
        val isProxy = d_isProxy.value
        return Bincode.Decoded(HttpAuthAsk(host = host, realm = realm, isProxy = isProxy), cursor)
    }

    override fun writeHttpAuthAsk(out: ByteArrayOutputStream, value: HttpAuthAsk) {
        Bincode.writeString(out, value.host)
        Bincode.writeString(out, value.realm)
        Bincode.writeBool(out, value.isProxy)
    }

    override fun readTlsErrorInfo(bytes: ByteArray, offset: Int): Bincode.Decoded<TlsErrorInfo> {
        var cursor = offset
        val d_url = Bincode.readString(bytes, cursor); cursor = d_url.consumed
        val url = d_url.value
        val d_host = Bincode.readString(bytes, cursor); cursor = d_host.consumed
        val host = d_host.value
        val d_description = Bincode.readString(bytes, cursor); cursor = d_description.consumed
        val description = d_description.value
        val d_fingerprintSha256 = Bincode.readString(bytes, cursor); cursor = d_fingerprintSha256.consumed
        val fingerprintSha256 = d_fingerprintSha256.value
        return Bincode.Decoded(TlsErrorInfo(url = url, host = host, description = description, fingerprintSha256 = fingerprintSha256), cursor)
    }

    override fun writeTlsErrorInfo(out: ByteArrayOutputStream, value: TlsErrorInfo) {
        Bincode.writeString(out, value.url)
        Bincode.writeString(out, value.host)
        Bincode.writeString(out, value.description)
        Bincode.writeString(out, value.fingerprintSha256)
    }

    override fun readFileChooserAsk(bytes: ByteArray, offset: Int): Bincode.Decoded<FileChooserAsk> {
        var cursor = offset
        val d_multiple = Bincode.readBool(bytes, cursor); cursor = d_multiple.consumed
        val multiple = d_multiple.value
        val d_accept = Bincode.readVec(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_accept.consumed
        val accept = d_accept.value
        val d_capture = Bincode.readBool(bytes, cursor); cursor = d_capture.consumed
        val capture = d_capture.value
        return Bincode.Decoded(FileChooserAsk(multiple = multiple, accept = accept, capture = capture), cursor)
    }

    override fun writeFileChooserAsk(out: ByteArrayOutputStream, value: FileChooserAsk) {
        Bincode.writeBool(out, value.multiple)
        Bincode.writeVec(out, value.accept) { s1, v1 -> Bincode.writeString(s1, v1) }
        Bincode.writeBool(out, value.capture)
    }

    override fun readDialogAsk(bytes: ByteArray, offset: Int): Bincode.Decoded<DialogAsk> {
        var cursor = offset
        val d_kind = readDialogKind(bytes, cursor); cursor = d_kind.consumed
        val kind = d_kind.value
        val d_message = Bincode.readString(bytes, cursor); cursor = d_message.consumed
        val message = d_message.value
        val d_defaultText = Bincode.readString(bytes, cursor); cursor = d_defaultText.consumed
        val defaultText = d_defaultText.value
        val d_origin = Bincode.readString(bytes, cursor); cursor = d_origin.consumed
        val origin = d_origin.value
        return Bincode.Decoded(DialogAsk(kind = kind, message = message, defaultText = defaultText, origin = origin), cursor)
    }

    override fun writeDialogAsk(out: ByteArrayOutputStream, value: DialogAsk) {
        writeDialogKind(out, value.kind)
        Bincode.writeString(out, value.message)
        Bincode.writeString(out, value.defaultText)
        Bincode.writeString(out, value.origin)
    }

    override fun readDialogKind(bytes: ByteArray, offset: Int): Bincode.Decoded<DialogKind> {
        val d = Bincode.readEnumDiscriminant(bytes, offset)
        val variant = DialogKind.entries.getOrNull(d.value)
            ?: throw Bincode.DecodeException("DialogKind: unknown discriminant ${d.value}")
        return Bincode.Decoded(variant, d.consumed)
    }

    override fun writeDialogKind(out: ByteArrayOutputStream, value: DialogKind) {
        Bincode.writeEnumDiscriminant(out, value.ordinal)
    }

    override fun readDownloadAsk(bytes: ByteArray, offset: Int): Bincode.Decoded<DownloadAsk> {
        var cursor = offset
        val d_downloadId = Bincode.readU64(bytes, cursor); cursor = d_downloadId.consumed
        val downloadId = d_downloadId.value
        val d_url = Bincode.readString(bytes, cursor); cursor = d_url.consumed
        val url = d_url.value
        val d_suggestedName = Bincode.readString(bytes, cursor); cursor = d_suggestedName.consumed
        val suggestedName = d_suggestedName.value
        val d_mimeType = Bincode.readString(bytes, cursor); cursor = d_mimeType.consumed
        val mimeType = d_mimeType.value
        val d_contentLength = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readU64(b1, c1) }; cursor = d_contentLength.consumed
        val contentLength = d_contentLength.value
        return Bincode.Decoded(DownloadAsk(downloadId = downloadId, url = url, suggestedName = suggestedName, mimeType = mimeType, contentLength = contentLength), cursor)
    }

    override fun writeDownloadAsk(out: ByteArrayOutputStream, value: DownloadAsk) {
        Bincode.writeU64(out, value.downloadId)
        Bincode.writeString(out, value.url)
        Bincode.writeString(out, value.suggestedName)
        Bincode.writeString(out, value.mimeType)
        Bincode.writeOption(out, value.contentLength) { s1, v1 -> Bincode.writeU64(s1, v1) }
    }

    override fun readSchemeRequestInfo(bytes: ByteArray, offset: Int): Bincode.Decoded<SchemeRequestInfo> {
        var cursor = offset
        val d_requestId = Bincode.readU64(bytes, cursor); cursor = d_requestId.consumed
        val requestId = d_requestId.value
        val d_scheme = Bincode.readString(bytes, cursor); cursor = d_scheme.consumed
        val scheme = d_scheme.value
        val d_method = Bincode.readString(bytes, cursor); cursor = d_method.consumed
        val method = d_method.value
        val d_url = Bincode.readString(bytes, cursor); cursor = d_url.consumed
        val url = d_url.value
        val d_headers = Bincode.readVec(bytes, cursor) { b1, c1 -> readHttpHeader(b1, c1) }; cursor = d_headers.consumed
        val headers = d_headers.value
        val d_hasBody = Bincode.readBool(bytes, cursor); cursor = d_hasBody.consumed
        val hasBody = d_hasBody.value
        val d_initiatorOrigin = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_initiatorOrigin.consumed
        val initiatorOrigin = d_initiatorOrigin.value
        return Bincode.Decoded(SchemeRequestInfo(requestId = requestId, scheme = scheme, method = method, url = url, headers = headers, hasBody = hasBody, initiatorOrigin = initiatorOrigin), cursor)
    }

    override fun writeSchemeRequestInfo(out: ByteArrayOutputStream, value: SchemeRequestInfo) {
        Bincode.writeU64(out, value.requestId)
        Bincode.writeString(out, value.scheme)
        Bincode.writeString(out, value.method)
        Bincode.writeString(out, value.url)
        Bincode.writeVec(out, value.headers) { s1, v1 -> writeHttpHeader(s1, v1) }
        Bincode.writeBool(out, value.hasBody)
        Bincode.writeOption(out, value.initiatorOrigin) { s1, v1 -> Bincode.writeString(s1, v1) }
    }

    override fun readBridgeMessage(bytes: ByteArray, offset: Int): Bincode.Decoded<BridgeMessage> {
        var cursor = offset
        val d_channel = Bincode.readString(bytes, cursor); cursor = d_channel.consumed
        val channel = d_channel.value
        val d_origin = Bincode.readString(bytes, cursor); cursor = d_origin.consumed
        val origin = d_origin.value
        val d_isMainFrame = Bincode.readBool(bytes, cursor); cursor = d_isMainFrame.consumed
        val isMainFrame = d_isMainFrame.value
        val d_documentId = Bincode.readU64(bytes, cursor); cursor = d_documentId.consumed
        val documentId = d_documentId.value
        val d_replyId = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readU64(b1, c1) }; cursor = d_replyId.consumed
        val replyId = d_replyId.value
        val d_data = Bincode.readBytes(bytes, cursor); cursor = d_data.consumed
        val data = d_data.value
        return Bincode.Decoded(BridgeMessage(channel = channel, origin = origin, isMainFrame = isMainFrame, documentId = documentId, replyId = replyId, data = data), cursor)
    }

    override fun writeBridgeMessage(out: ByteArrayOutputStream, value: BridgeMessage) {
        Bincode.writeString(out, value.channel)
        Bincode.writeString(out, value.origin)
        Bincode.writeBool(out, value.isMainFrame)
        Bincode.writeU64(out, value.documentId)
        Bincode.writeOption(out, value.replyId) { s1, v1 -> Bincode.writeU64(s1, v1) }
        Bincode.writeBytes(out, value.data)
    }

    override fun readNewViewInfo(bytes: ByteArray, offset: Int): Bincode.Decoded<NewViewInfo> {
        var cursor = offset
        val d_instance = readWebViewInstance(bytes, cursor); cursor = d_instance.consumed
        val instance = d_instance.value
        val d_url = Bincode.readString(bytes, cursor); cursor = d_url.consumed
        val url = d_url.value
        return Bincode.Decoded(NewViewInfo(instance = instance, url = url), cursor)
    }

    override fun writeNewViewInfo(out: ByteArrayOutputStream, value: NewViewInfo) {
        writeWebViewInstance(out, value.instance)
        Bincode.writeString(out, value.url)
    }

    override fun readTerminationInfo(bytes: ByteArray, offset: Int): Bincode.Decoded<TerminationInfo> {
        var cursor = offset
        val d_reason = readTerminationReason(bytes, cursor); cursor = d_reason.consumed
        val reason = d_reason.value
        return Bincode.Decoded(TerminationInfo(reason = reason), cursor)
    }

    override fun writeTerminationInfo(out: ByteArrayOutputStream, value: TerminationInfo) {
        writeTerminationReason(out, value.reason)
    }

    override fun readTerminationReason(bytes: ByteArray, offset: Int): Bincode.Decoded<TerminationReason> {
        val d = Bincode.readEnumDiscriminant(bytes, offset)
        val variant = TerminationReason.entries.getOrNull(d.value)
            ?: throw Bincode.DecodeException("TerminationReason: unknown discriminant ${d.value}")
        return Bincode.Decoded(variant, d.consumed)
    }

    override fun writeTerminationReason(out: ByteArrayOutputStream, value: TerminationReason) {
        Bincode.writeEnumDiscriminant(out, value.ordinal)
    }

    override fun readTelemetryKind(bytes: ByteArray, offset: Int): Bincode.Decoded<TelemetryKind> {
        val d = Bincode.readEnumDiscriminant(bytes, offset)
        val variant = TelemetryKind.entries.getOrNull(d.value)
            ?: throw Bincode.DecodeException("TelemetryKind: unknown discriminant ${d.value}")
        return Bincode.Decoded(variant, d.consumed)
    }

    override fun writeTelemetryKind(out: ByteArrayOutputStream, value: TelemetryKind) {
        Bincode.writeEnumDiscriminant(out, value.ordinal)
    }

    override fun readTelemetryEvent(bytes: ByteArray, offset: Int): Bincode.Decoded<TelemetryEvent> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> {
                val d_inner = Bincode.readF32(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(TelemetryEvent.Progress(inner) as TelemetryEvent, cursor)
            }
            1 -> {
                val d_inner = Bincode.readString(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(TelemetryEvent.Title(inner) as TelemetryEvent, cursor)
            }
            2 -> {
                val d_inner = Bincode.readString(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(TelemetryEvent.Url(inner) as TelemetryEvent, cursor)
            }
            3 -> {
                val d_inner = Bincode.readString(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(TelemetryEvent.Favicon(inner) as TelemetryEvent, cursor)
            }
            4 -> {
                val d_inner = readHistoryState(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(TelemetryEvent.History(inner) as TelemetryEvent, cursor)
            }
            5 -> {
                val d_inner = readConsoleLine(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(TelemetryEvent.Console(inner) as TelemetryEvent, cursor)
            }
            6 -> {
                val d_inner = readDownloadProgress(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(TelemetryEvent.DownloadUpdate(inner) as TelemetryEvent, cursor)
            }
            7 -> {
                val d_inner = readDownloadDone(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(TelemetryEvent.DownloadFinished(inner) as TelemetryEvent, cursor)
            }
            8 -> {
                val d_inner = Bincode.readU32(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(TelemetryEvent.Dropped(inner) as TelemetryEvent, cursor)
            }
            else -> throw Bincode.DecodeException("TelemetryEvent: unknown discriminant ${disc.value}")
        }
    }

    override fun writeTelemetryEvent(out: ByteArrayOutputStream, value: TelemetryEvent) {
        when (value) {
            is TelemetryEvent.Progress -> {
                Bincode.writeEnumDiscriminant(out, 0)
                Bincode.writeF32(out, value.value)
            }
            is TelemetryEvent.Title -> {
                Bincode.writeEnumDiscriminant(out, 1)
                Bincode.writeString(out, value.value)
            }
            is TelemetryEvent.Url -> {
                Bincode.writeEnumDiscriminant(out, 2)
                Bincode.writeString(out, value.value)
            }
            is TelemetryEvent.Favicon -> {
                Bincode.writeEnumDiscriminant(out, 3)
                Bincode.writeString(out, value.value)
            }
            is TelemetryEvent.History -> {
                Bincode.writeEnumDiscriminant(out, 4)
                writeHistoryState(out, value.value)
            }
            is TelemetryEvent.Console -> {
                Bincode.writeEnumDiscriminant(out, 5)
                writeConsoleLine(out, value.value)
            }
            is TelemetryEvent.DownloadUpdate -> {
                Bincode.writeEnumDiscriminant(out, 6)
                writeDownloadProgress(out, value.value)
            }
            is TelemetryEvent.DownloadFinished -> {
                Bincode.writeEnumDiscriminant(out, 7)
                writeDownloadDone(out, value.value)
            }
            is TelemetryEvent.Dropped -> {
                Bincode.writeEnumDiscriminant(out, 8)
                Bincode.writeU32(out, value.value)
            }
        }
    }

    override fun readHistoryState(bytes: ByteArray, offset: Int): Bincode.Decoded<HistoryState> {
        var cursor = offset
        val d_canGoBack = Bincode.readBool(bytes, cursor); cursor = d_canGoBack.consumed
        val canGoBack = d_canGoBack.value
        val d_canGoForward = Bincode.readBool(bytes, cursor); cursor = d_canGoForward.consumed
        val canGoForward = d_canGoForward.value
        return Bincode.Decoded(HistoryState(canGoBack = canGoBack, canGoForward = canGoForward), cursor)
    }

    override fun writeHistoryState(out: ByteArrayOutputStream, value: HistoryState) {
        Bincode.writeBool(out, value.canGoBack)
        Bincode.writeBool(out, value.canGoForward)
    }

    override fun readConsoleLine(bytes: ByteArray, offset: Int): Bincode.Decoded<ConsoleLine> {
        var cursor = offset
        val d_level = readConsoleLevel(bytes, cursor); cursor = d_level.consumed
        val level = d_level.value
        val d_message = Bincode.readString(bytes, cursor); cursor = d_message.consumed
        val message = d_message.value
        val d_source = Bincode.readString(bytes, cursor); cursor = d_source.consumed
        val source = d_source.value
        val d_line = Bincode.readU32(bytes, cursor); cursor = d_line.consumed
        val line = d_line.value
        return Bincode.Decoded(ConsoleLine(level = level, message = message, source = source, line = line), cursor)
    }

    override fun writeConsoleLine(out: ByteArrayOutputStream, value: ConsoleLine) {
        writeConsoleLevel(out, value.level)
        Bincode.writeString(out, value.message)
        Bincode.writeString(out, value.source)
        Bincode.writeU32(out, value.line)
    }

    override fun readConsoleLevel(bytes: ByteArray, offset: Int): Bincode.Decoded<ConsoleLevel> {
        val d = Bincode.readEnumDiscriminant(bytes, offset)
        val variant = ConsoleLevel.entries.getOrNull(d.value)
            ?: throw Bincode.DecodeException("ConsoleLevel: unknown discriminant ${d.value}")
        return Bincode.Decoded(variant, d.consumed)
    }

    override fun writeConsoleLevel(out: ByteArrayOutputStream, value: ConsoleLevel) {
        Bincode.writeEnumDiscriminant(out, value.ordinal)
    }

    override fun readDownloadProgress(bytes: ByteArray, offset: Int): Bincode.Decoded<DownloadProgress> {
        var cursor = offset
        val d_downloadId = Bincode.readU64(bytes, cursor); cursor = d_downloadId.consumed
        val downloadId = d_downloadId.value
        val d_received = Bincode.readU64(bytes, cursor); cursor = d_received.consumed
        val received = d_received.value
        val d_total = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readU64(b1, c1) }; cursor = d_total.consumed
        val total = d_total.value
        return Bincode.Decoded(DownloadProgress(downloadId = downloadId, received = received, total = total), cursor)
    }

    override fun writeDownloadProgress(out: ByteArrayOutputStream, value: DownloadProgress) {
        Bincode.writeU64(out, value.downloadId)
        Bincode.writeU64(out, value.received)
        Bincode.writeOption(out, value.total) { s1, v1 -> Bincode.writeU64(s1, v1) }
    }

    override fun readDownloadDone(bytes: ByteArray, offset: Int): Bincode.Decoded<DownloadDone> {
        var cursor = offset
        val d_downloadId = Bincode.readU64(bytes, cursor); cursor = d_downloadId.consumed
        val downloadId = d_downloadId.value
        val d_path = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_path.consumed
        val path = d_path.value
        val d_error = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_error.consumed
        val error = d_error.value
        return Bincode.Decoded(DownloadDone(downloadId = downloadId, path = path, error = error), cursor)
    }

    override fun writeDownloadDone(out: ByteArrayOutputStream, value: DownloadDone) {
        Bincode.writeU64(out, value.downloadId)
        Bincode.writeOption(out, value.path) { s1, v1 -> Bincode.writeString(s1, v1) }
        Bincode.writeOption(out, value.error) { s1, v1 -> Bincode.writeString(s1, v1) }
    }

    override fun readNativeHandleId(bytes: ByteArray, offset: Int): Bincode.Decoded<NativeHandleId> {
        return Bincode.readVarintU64(bytes, offset)
    }

    override fun writeNativeHandleId(out: ByteArrayOutputStream, value: NativeHandleId) {
        Bincode.writeU64(out, value.toULong())
    }
}
