        let segments = try Bincode.readVec(&c) { c1 in try self.readProgressSegment(&c1) }
        let points = try Bincode.readVec(&c) { c1 in try self.readProgressPoint(&c1) }
        return Notifications.Progress(value: value, label: label, segments: segments, points: points)
    }

    public func writeProgress(_ out: inout Data, _ value: Notifications.Progress) {
        Bincode.writeOption(&out, value.value) { o1, v1 in Bincode.writeF32(&o1, v1) }
        Bincode.writeOption(&out, value.label) { o1, v1 in Bincode.writeString(&o1, v1) }
        Bincode.writeVec(&out, value.segments) { o1, v1 in self.writeProgressSegment(&o1, v1) }
        Bincode.writeVec(&out, value.points) { o1, v1 in self.writeProgressPoint(&o1, v1) }
    }

    public func readProgressSegment(_ c: inout Bincode.Cursor) throws -> Notifications.ProgressSegment {
        let length = try Bincode.readVarintU32(&c)
        let color = try Bincode.readOption(&c) { c1 in try Bincode.readVarintU32(&c1) }
        return Notifications.ProgressSegment(length: length, color: color)
    }

    public func writeProgressSegment(_ out: inout Data, _ value: Notifications.ProgressSegment) {
        Bincode.writeVarintU32(&out, value.length)
        Bincode.writeOption(&out, value.color) { o1, v1 in Bincode.writeVarintU32(&o1, v1) }
    }

    public func readProgressPoint(_ c: inout Bincode.Cursor) throws -> Notifications.ProgressPoint {
        let position = try Bincode.readVarintU32(&c)
        let color = try Bincode.readOption(&c) { c1 in try Bincode.readVarintU32(&c1) }
        return Notifications.ProgressPoint(position: position, color: color)
