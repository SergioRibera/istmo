<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Echo section (M2) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Echo"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/inputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Type something"
            android:inputType="text"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/callButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Call Echo" />

        <TextView
            android:id="@+id/output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="8dp"
            android:textIsSelectable="true" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#E0E0E0" />

        <!-- Lifecycle section (M3) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lifecycle"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/lifecycleState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="current: (unknown)"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/lifecycleRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Poll lifecycle state" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#E0E0E0" />

        <!-- Deep links section (M3) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deep links"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="italic"
            android:textSize="12sp"
            android:text="adb shell am start -a android.intent.action.VIEW -d 'istmo://open?tab=home' dev.istmo.demo" />

        <TextView
            android:id="@+id/deeplinkList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textIsSelectable="true"
            android:minLines="2"
            android:hint="(no links yet)" />

        <Button
            android:id="@+id/deeplinkRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Poll deep links" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#E0E0E0" />

        <!-- Permissions section (M3) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Permissions"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/permissionInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="android.permission.CAMERA"
            android:inputType="text"
            android:importantForAutofill="no" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/permissionCheck"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Check" />
            <Button
                android:id="@+id/permissionRequest"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Request" />
        </LinearLayout>

        <TextView
            android:id="@+id/permissionOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textIsSelectable="true" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#E0E0E0" />

        <!-- Activity results section (M3) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activity results (VIEW intent)"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/intentUri"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="https://example.com"
            android:inputType="textUri"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/launchIntent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Launch VIEW intent" />

        <TextView
            android:id="@+id/intentOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
