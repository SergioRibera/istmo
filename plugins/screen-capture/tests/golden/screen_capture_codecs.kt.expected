    override fun readSessionConfig(bytes: ByteArray, offset: Int): Bincode.Decoded<SessionConfig> {
        var cursor = offset
        val d_source = readSourceSelector(bytes, cursor); cursor = d_source.consumed
        val source = d_source.value
        val d_backend = readBackendSelection(bytes, cursor); cursor = d_backend.consumed
        val backend = d_backend.value
        val d_video = readVideoConfig(bytes, cursor); cursor = d_video.consumed
        val video = d_video.value
        val d_audio = Bincode.readOption(bytes, cursor) { b1, c1 -> readAudioConfig(b1, c1) }; cursor = d_audio.consumed
        val audio = d_audio.value
        val d_consent = readConsentConfig(bytes, cursor); cursor = d_consent.consumed
        val consent = d_consent.value
        val d_composite = readCompositeConfig(bytes, cursor); cursor = d_composite.consumed
        val composite = d_composite.value
        val d_linux = readLinuxOptions(bytes, cursor); cursor = d_linux.consumed
        val linux = d_linux.value
        val d_windows = readWindowsOptions(bytes, cursor); cursor = d_windows.consumed
        val windows = d_windows.value
        return Bincode.Decoded(SessionConfig(source = source, backend = backend, video = video, audio = audio, consent = consent, composite = composite, linux = linux, windows = windows), cursor)
    }

    override fun writeSessionConfig(out: ByteArrayOutputStream, value: SessionConfig) {
        writeSourceSelector(out, value.source)
        writeBackendSelection(out, value.backend)
        writeVideoConfig(out, value.video)
        Bincode.writeOption(out, value.audio) { s1, v1 -> writeAudioConfig(s1, v1) }
        writeConsentConfig(out, value.consent)
        writeCompositeConfig(out, value.composite)
        writeLinuxOptions(out, value.linux)
        writeWindowsOptions(out, value.windows)
    }

    override fun readSessionUpdate(bytes: ByteArray, offset: Int): Bincode.Decoded<SessionUpdate> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> {
                val d_inner = readFrameRate(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(SessionUpdate.Fps(inner) as SessionUpdate, cursor)
            }
            1 -> {
                val d_inner = readCursorRequest(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(SessionUpdate.Cursor(inner) as SessionUpdate, cursor)
            }
            2 -> {
                val d_inner = readRegionSelector(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(SessionUpdate.Region(inner) as SessionUpdate, cursor)
            }
            3 -> {
                val d_inner = readFormatRequest(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(SessionUpdate.Formats(inner) as SessionUpdate, cursor)
            }
            4 -> Bincode.Decoded(SessionUpdate.Pause, cursor)
            5 -> Bincode.Decoded(SessionUpdate.Resume, cursor)
            else -> throw Bincode.DecodeException("SessionUpdate: unknown discriminant ${disc.value}")
        }
    }

    override fun writeSessionUpdate(out: ByteArrayOutputStream, value: SessionUpdate) {
        when (value) {
            is SessionUpdate.Fps -> {
                Bincode.writeEnumDiscriminant(out, 0)
                writeFrameRate(out, value.value)
            }
            is SessionUpdate.Cursor -> {
                Bincode.writeEnumDiscriminant(out, 1)
                writeCursorRequest(out, value.value)
            }
            is SessionUpdate.Region -> {
                Bincode.writeEnumDiscriminant(out, 2)
                writeRegionSelector(out, value.value)
            }
            is SessionUpdate.Formats -> {
                Bincode.writeEnumDiscriminant(out, 3)
                writeFormatRequest(out, value.value)
            }
            SessionUpdate.Pause -> Bincode.writeEnumDiscriminant(out, 4)
            SessionUpdate.Resume -> Bincode.writeEnumDiscriminant(out, 5)
        }
    }

    override fun readScreenshotRequest(bytes: ByteArray, offset: Int): Bincode.Decoded<ScreenshotRequest> {
        var cursor = offset
        val d_source = readSourceSelector(bytes, cursor); cursor = d_source.consumed
        val source = d_source.value
        val d_backend = readBackendSelection(bytes, cursor); cursor = d_backend.consumed
        val backend = d_backend.value
        val d_formats = readFormatRequest(bytes, cursor); cursor = d_formats.consumed
        val formats = d_formats.value
        val d_cursor_ = readCursorRequest(bytes, cursor); cursor = d_cursor_.consumed
        val cursor_ = d_cursor_.value
        val d_hdr = readHdrPolicy(bytes, cursor); cursor = d_hdr.consumed
        val hdr = d_hdr.value
        val d_composite = Bincode.readBool(bytes, cursor); cursor = d_composite.consumed
        val composite = d_composite.value
        val d_compositeConfig = readCompositeConfig(bytes, cursor); cursor = d_compositeConfig.consumed
        val compositeConfig = d_compositeConfig.value
        val d_consent = readConsentConfig(bytes, cursor); cursor = d_consent.consumed
        val consent = d_consent.value
        return Bincode.Decoded(ScreenshotRequest(source = source, backend = backend, formats = formats, cursor = cursor_, hdr = hdr, composite = composite, compositeConfig = compositeConfig, consent = consent), cursor)
    }

    override fun writeScreenshotRequest(out: ByteArrayOutputStream, value: ScreenshotRequest) {
        writeSourceSelector(out, value.source)
        writeBackendSelection(out, value.backend)
        writeFormatRequest(out, value.formats)
        writeCursorRequest(out, value.cursor)
        writeHdrPolicy(out, value.hdr)
        Bincode.writeBool(out, value.composite)
        writeCompositeConfig(out, value.compositeConfig)
        writeConsentConfig(out, value.consent)
    }

