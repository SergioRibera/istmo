        Bincode.writeOption(&out, value.backend) { o1, v1 in self.writeBackendId(&o1, v1) }
    }

    public func readAccessStatus(_ c: inout Bincode.Cursor) throws -> IstmoMedia.AccessStatus {
        let disc = try Bincode.readVarintU32(&c)
        switch disc {
        case 0: return .granted
        case 1: return .denied
        case 2: return .notDetermined
        case 3: return .restricted
        case 4: return .requiresRestart
        case 5: return .perSession
        case 6: return .notApplicable
        default:
            let payload = c.data.subdata(in: (c.data.endIndex - c.remaining) ..< c.data.endIndex)
            c.offset += payload.count
            return .unknown(discriminant: disc, payload: payload)
        }
    }

    public func writeAccessStatus(_ out: inout Data, _ value: IstmoMedia.AccessStatus) {
        switch value {
        case .granted:
            Bincode.writeVarintU32(&out, 0)
        case .denied:
            Bincode.writeVarintU32(&out, 1)
        case .notDetermined:
            Bincode.writeVarintU32(&out, 2)
        case .restricted:
            Bincode.writeVarintU32(&out, 3)
        case .requiresRestart:
            Bincode.writeVarintU32(&out, 4)
        case .perSession:
            Bincode.writeVarintU32(&out, 5)
        case .notApplicable:
            Bincode.writeVarintU32(&out, 6)
        case .unknown(let discriminant, let payload):
            Bincode.writeVarintU32(&out, discriminant)
            out.append(payload)
        }
    }

    public func readNativeHandleId(_ c: inout Bincode.Cursor) throws -> NativeHandleId {
        return try Bincode.readVarintU64(&c)
    }

    public func writeNativeHandleId(_ out: inout Data, _ value: NativeHandleId) {
        Bincode.writeVarintU64(&out, value)
    }
}
