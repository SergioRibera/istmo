---
const plugins = [
  { id: "istmo.google-sign-in",  code: "GS", title: "Google Sign-In",    body: "OAuth account handoff with native-handle credentials. Released + refresh.", platforms: ["Android","iOS"] },
  { id: "istmo.data-store",       code: "DS", title: "Data Store",        body: "Key-value + typed records on SharedPreferences, UserDefaults, filesystem.", platforms: ["Android","iOS","Desktop","WASM"] },
  { id: "istmo.biometric",        code: "BM", title: "Biometric",         body: "Face/Touch/Fingerprint auth with Rust-side vaulted secrets.",                 platforms: ["Android","iOS","Desktop"] },
  { id: "istmo.camera",           code: "CM", title: "Camera",            body: "Stream frames back to Rust, capture stills, flashlight control.",            platforms: ["Android","iOS"] },
  { id: "istmo.barcode-scanner",  code: "BS", title: "Barcode Scanner",   body: "QR, Code 128, PDF417, Aztec, DataMatrix. Plus a pure-Rust reader.",         platforms: ["Android","iOS","Desktop","WASM"] },
  { id: "istmo.share",            code: "SH", title: "Share",             body: "System share sheet, inbound share handler, dedupe nonce.",                   platforms: ["Android","iOS"] },
  { id: "istmo.power-devices",    code: "PD", title: "Power Devices",     body: "Battery + peripherals (controllers, UPS, Bluetooth HID).",                  platforms: ["Android","iOS","Desktop"] },
  { id: "istmo.lifecycle",        code: "AL", title: "App Lifecycle",     body: "Foreground/background phase, safe-area insets, deep links.",                 platforms: ["Android","iOS"] },
  { id: "istmo.notifications",    code: "NT", title: "Notifications",     body: "Local + remote push, permission flow, rich payloads.",                      platforms: ["Android","iOS"] },
  { id: "istmo.admob",            code: "AD", title: "AdMob",             body: "Banner, interstitial, rewarded ad formats. App-drawn UI.",                  platforms: ["Android","iOS"] },
  { id: "istmo.live-activity",    code: "LA", title: "Live Activities",   body: "iOS Lock Screen + Dynamic Island state stream.",                            platforms: ["iOS"] },
  { id: "istmo.system-info",      code: "SI", title: "System Info",       body: "Locale, timezone, formats, network, thermals, low-power.",                  platforms: ["Android","iOS","Desktop","WASM"] },
];
const PL: Record<string, string> = { Android: "#A4C639", iOS: "#C7C7CC", Desktop: "#E8B9A3", WASM: "#7FA7D4" };
---
<section class="plugins-showcase not-content">
  <div class="inner">
    <div class="hdr">
      <div class="left">
        <div class="kicker"><span class="bar"></span><span>03 OFFICIAL PLUGINS</span></div>
        <h2>Twelve plugins. Every one is a real crate you can read today.</h2>
      </div>
      <a class="see-all" href="plugins/built-in/">Browse all plugins</a>
    </div>
    <div class="grid">
      {plugins.map(p => (
        <article class="card">
          <h3>{p.title}</h3>
          <p>{p.body}</p>
          <div class="platforms">
            {p.platforms.map(pl => (
              <span class="pchip" style={`border-color: ${PL[pl]}80;`}>
                <span class="d" style={`background: ${PL[pl]};`}></span>{pl}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.plugins-showcase {
  background: #0a0a0a; color: #f5f5f2;
  padding: 5rem 0;
  border-top: 1px solid var(--sl-color-gray-5);
  border-bottom: 1px solid var(--sl-color-gray-5);
}
.plugins-showcase .inner { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }
.plugins-showcase .hdr {
  display: flex; align-items: end; justify-content: space-between; gap: 2rem;
  margin-bottom: 3rem;
}
.plugins-showcase .kicker {
  display: flex; align-items: center; gap: 0.75rem;
  font-family: var(--sl-font-mono); font-size: 0.75rem;
  letter-spacing: 0.12em; color: #8a8a85;
  text-transform: uppercase; margin-bottom: 1rem;
}
.plugins-showcase .kicker .bar { width: 1.5rem; height: 2px; background: #bfff00; }
.plugins-showcase h2 {
  font-size: clamp(1.75rem, 3.5vw, 2.75rem);
  line-height: 1.1; letter-spacing: -0.02em;
  margin: 0; color: #f5f5f2; font-weight: 700; max-width: 45rem;
}
.plugins-showcase .see-all {
  display: inline-flex; align-items: center; gap: 0.5rem;
  border: 1px solid #333; border-radius: 0.5rem;
  padding: 0.75rem 1rem; font-size: 0.875rem;
  color: #f5f5f2; text-decoration: none;
  white-space: nowrap;
}
.plugins-showcase .see-all:hover { border-color: #bfff00; }
.plugins-showcase .grid {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;
}
@media (max-width: 65rem) { .plugins-showcase .grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 40rem) { .plugins-showcase .grid { grid-template-columns: 1fr; } }
.plugins-showcase .card {
  background: #141414; border: 1px solid #1f1f1f; border-radius: 0.75rem;
  padding: 1.5rem; display: flex; flex-direction: column; gap: 0.75rem;
}
.plugins-showcase h3 {
  margin: 0; font-size: 1.05rem; font-weight: 600; letter-spacing: -0.01em; color: #f5f5f2;
}
.plugins-showcase .card p { margin: 0; font-size: 0.8rem; line-height: 1.55; color: #8a8a85; }
.plugins-showcase .platforms { display: flex; flex-wrap: wrap; gap: 0.35rem; }
.plugins-showcase .pchip {
  display: inline-flex; align-items: center; gap: 0.3rem;
  border: 1px solid; border-radius: 4px; padding: 0.15rem 0.4rem;
  font-family: var(--sl-font-mono); font-size: 0.65rem; color: #f5f5f2;
}
.plugins-showcase .pchip .d { width: 5px; height: 5px; border-radius: 50%; display: inline-block; }
</style>
