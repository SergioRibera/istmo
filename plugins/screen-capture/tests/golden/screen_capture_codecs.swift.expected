        self.writeFormatRequest(&out, value.formats)
        self.writeFrameRate(&out, value.fps)
        self.writeOutputSize(&out, value.size)
        self.writeCursorRequest(&out, value.cursor)
        self.writeStrength(&out, value.damage)
        self.writeHdrPolicy(&out, value.hdr)
        Bincode.writeU8(&out, value.poolDepth)
        self.writeExhaustion(&out, value.exhaustion)
        self.writeGpuPreference(&out, value.gpu)
        self.writeOrientationHandling(&out, value.orientation)
        Bincode.writeVec(&out, value.exclude) { o1, v1 in self.writeSourceId(&o1, v1) }
        Bincode.writeBool(&out, value.excludeOwnProcess)
        Bincode.writeBool(&out, value.liveBuffers)
    }

