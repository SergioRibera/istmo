        writePersistMode(out, value.persist)
        Bincode.writeOption(out, value.grant) { s1, v1 -> writeProjectionGrant(s1, v1) }
    }

    override fun readRequirement(bytes: ByteArray, offset: Int): Bincode.Decoded<Requirement> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> {
                val d_inner = readSourceKind(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(Requirement.Kind(inner) as Requirement, cursor)
            }
            1 -> Bincode.Decoded(Requirement.WindowById, cursor)
            2 -> Bincode.Decoded(Requirement.Picker, cursor)
            3 -> Bincode.Decoded(Requirement.SourceSelector, cursor)
            4 -> Bincode.Decoded(Requirement.MultiMonitor, cursor)
            5 -> Bincode.Decoded(Requirement.CompositeStreaming, cursor)
            6 -> Bincode.Decoded(Requirement.PreviewAndFrames, cursor)
            7 -> Bincode.Decoded(Requirement.Formats, cursor)
            8 -> Bincode.Decoded(Requirement.Scaling, cursor)
            9 -> Bincode.Decoded(Requirement.Cursor, cursor)
            10 -> Bincode.Decoded(Requirement.Damage, cursor)
            11 -> Bincode.Decoded(Requirement.Hdr, cursor)
            12 -> Bincode.Decoded(Requirement.ExhaustionReadback, cursor)
            13 -> Bincode.Decoded(Requirement.Gpu, cursor)
            14 -> Bincode.Decoded(Requirement.Borderless, cursor)
            15 -> Bincode.Decoded(Requirement.Upright, cursor)
            16 -> Bincode.Decoded(Requirement.Audio, cursor)
            17 -> Bincode.Decoded(Requirement.Region, cursor)
            18 -> Bincode.Decoded(Requirement.Operation, cursor)
            19 -> Bincode.Decoded(Requirement.CompositeSize, cursor)
            else -> throw Bincode.DecodeException("Requirement: unknown discriminant ${disc.value}")
        }
    }

    override fun writeRequirement(out: ByteArrayOutputStream, value: Requirement) {
        when (value) {
            is Requirement.Kind -> {
                Bincode.writeEnumDiscriminant(out, 0)
                writeSourceKind(out, value.value)
            }
            Requirement.WindowById -> Bincode.writeEnumDiscriminant(out, 1)
            Requirement.Picker -> Bincode.writeEnumDiscriminant(out, 2)
            Requirement.SourceSelector -> Bincode.writeEnumDiscriminant(out, 3)
            Requirement.MultiMonitor -> Bincode.writeEnumDiscriminant(out, 4)
            Requirement.CompositeStreaming -> Bincode.writeEnumDiscriminant(out, 5)
            Requirement.PreviewAndFrames -> Bincode.writeEnumDiscriminant(out, 6)
            Requirement.Formats -> Bincode.writeEnumDiscriminant(out, 7)
            Requirement.Scaling -> Bincode.writeEnumDiscriminant(out, 8)
            Requirement.Cursor -> Bincode.writeEnumDiscriminant(out, 9)
            Requirement.Damage -> Bincode.writeEnumDiscriminant(out, 10)
            Requirement.Hdr -> Bincode.writeEnumDiscriminant(out, 11)
            Requirement.ExhaustionReadback -> Bincode.writeEnumDiscriminant(out, 12)
            Requirement.Gpu -> Bincode.writeEnumDiscriminant(out, 13)
            Requirement.Borderless -> Bincode.writeEnumDiscriminant(out, 14)
            Requirement.Upright -> Bincode.writeEnumDiscriminant(out, 15)
            Requirement.Audio -> Bincode.writeEnumDiscriminant(out, 16)
            Requirement.Region -> Bincode.writeEnumDiscriminant(out, 17)
            Requirement.Operation -> Bincode.writeEnumDiscriminant(out, 18)
            Requirement.CompositeSize -> Bincode.writeEnumDiscriminant(out, 19)
        }
    }

    override fun readUnmet(bytes: ByteArray, offset: Int): Bincode.Decoded<Unmet> {
        var cursor = offset
        val d_backend = Bincode.readOption(bytes, cursor) { b1, c1 -> readBackendId(b1, c1) }; cursor = d_backend.consumed
        val backend = d_backend.value
        val d_requirements = Bincode.readVec(bytes, cursor) { b1, c1 -> readRequirement(b1, c1) }; cursor = d_requirements.consumed
        val requirements = d_requirements.value
        return Bincode.Decoded(Unmet(backend = backend, requirements = requirements), cursor)
    }

    override fun writeUnmet(out: ByteArrayOutputStream, value: Unmet) {
        Bincode.writeOption(out, value.backend) { s1, v1 -> writeBackendId(s1, v1) }
        Bincode.writeVec(out, value.requirements) { s1, v1 -> writeRequirement(s1, v1) }
    }

    override fun readAttemptFailure(bytes: ByteArray, offset: Int): Bincode.Decoded<AttemptFailure> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> {
                val d_inner = readAvailability(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(AttemptFailure.Unavailable(inner) as AttemptFailure, cursor)
            }
            1 -> {
                val d_inner = Bincode.readVec(bytes, cursor) { b1, c1 -> readRequirement(b1, c1) }; cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(AttemptFailure.Unsatisfiable(inner) as AttemptFailure, cursor)
            }
            2 -> {
                val d_inner = Bincode.readString(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(AttemptFailure.Failed(inner) as AttemptFailure, cursor)
            }
            else -> throw Bincode.DecodeException("AttemptFailure: unknown discriminant ${disc.value}")
        }
    }

    override fun writeAttemptFailure(out: ByteArrayOutputStream, value: AttemptFailure) {
        when (value) {
            is AttemptFailure.Unavailable -> {
                Bincode.writeEnumDiscriminant(out, 0)
                writeAvailability(out, value.value)
            }
            is AttemptFailure.Unsatisfiable -> {
                Bincode.writeEnumDiscriminant(out, 1)
                Bincode.writeVec(out, value.value) { s1, v1 -> writeRequirement(s1, v1) }
            }
            is AttemptFailure.Failed -> {
                Bincode.writeEnumDiscriminant(out, 2)
                Bincode.writeString(out, value.value)
            }
        }
    }

    override fun readBackendAttempt(bytes: ByteArray, offset: Int): Bincode.Decoded<BackendAttempt> {
        var cursor = offset
        val d_backend = readBackendId(bytes, cursor); cursor = d_backend.consumed
        val backend = d_backend.value
        val d_failure = readAttemptFailure(bytes, cursor); cursor = d_failure.consumed
        val failure = d_failure.value
        return Bincode.Decoded(BackendAttempt(backend = backend, failure = failure), cursor)
    }

    override fun writeBackendAttempt(out: ByteArrayOutputStream, value: BackendAttempt) {
        writeBackendId(out, value.backend)
        writeAttemptFailure(out, value.failure)
    }

    override fun readBackendReason(bytes: ByteArray, offset: Int): Bincode.Decoded<BackendReason> {
        var cursor = offset
        val d_backend = readBackendId(bytes, cursor); cursor = d_backend.consumed
        val backend = d_backend.value
        val d_availability = readAvailability(bytes, cursor); cursor = d_availability.consumed
        val availability = d_availability.value
        return Bincode.Decoded(BackendReason(backend = backend, availability = availability), cursor)
    }

    override fun writeBackendReason(out: ByteArrayOutputStream, value: BackendReason) {
        writeBackendId(out, value.backend)
        writeAvailability(out, value.availability)
    }

    override fun readBackendDetail(bytes: ByteArray, offset: Int): Bincode.Decoded<BackendDetail> {
        var cursor = offset
        val d_backend = Bincode.readOption(bytes, cursor) { b1, c1 -> readBackendId(b1, c1) }; cursor = d_backend.consumed
        val backend = d_backend.value
        val d_step = Bincode.readString(bytes, cursor); cursor = d_step.consumed
        val step = d_step.value
        val d_message = Bincode.readString(bytes, cursor); cursor = d_message.consumed
        val message = d_message.value
        return Bincode.Decoded(BackendDetail(backend = backend, step = step, message = message), cursor)
    }

    override fun writeBackendDetail(out: ByteArrayOutputStream, value: BackendDetail) {
        Bincode.writeOption(out, value.backend) { s1, v1 -> writeBackendId(s1, v1) }
        Bincode.writeString(out, value.step)
        Bincode.writeString(out, value.message)
    }

    override fun readOsFailure(bytes: ByteArray, offset: Int): Bincode.Decoded<OsFailure> {
        var cursor = offset
        val d_backend = readBackendId(bytes, cursor); cursor = d_backend.consumed
        val backend = d_backend.value
        val d_operation = Bincode.readString(bytes, cursor); cursor = d_operation.consumed
        val operation = d_operation.value
        val d_code = Bincode.readI64(bytes, cursor); cursor = d_code.consumed
        val code = d_code.value
        return Bincode.Decoded(OsFailure(backend = backend, operation = operation, code = code), cursor)
    }

    override fun writeOsFailure(out: ByteArrayOutputStream, value: OsFailure) {
        writeBackendId(out, value.backend)
        Bincode.writeString(out, value.operation)
        Bincode.writeI64(out, value.code)
    }

    override fun readCaptureError(bytes: ByteArray, offset: Int): Bincode.Decoded<CaptureError> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> Bincode.Decoded(CaptureError.NoBackendCompiled, cursor)
            1 -> {
                val d_inner = readBackendId(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(CaptureError.BackendNotCompiled(inner) as CaptureError, cursor)
            }
            2 -> {
                val d_inner = readBackendReason(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(CaptureError.BackendUnavailable(inner) as CaptureError, cursor)
            }
            3 -> {
                val d_inner = readUnmet(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(CaptureError.Unsatisfiable(inner) as CaptureError, cursor)
            }
            4 -> {
                val d_inner = Bincode.readVec(bytes, cursor) { b1, c1 -> readBackendAttempt(b1, c1) }; cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(CaptureError.NoBackend(inner) as CaptureError, cursor)
            }
            5 -> {
                val d_inner = readSourceId(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(CaptureError.SourceNotFound(inner) as CaptureError, cursor)
            }
            6 -> Bincode.Decoded(CaptureError.SourceLost, cursor)
            7 -> Bincode.Decoded(CaptureError.ConsentRequired, cursor)
            8 -> Bincode.Decoded(CaptureError.ConsentDenied, cursor)
            9 -> Bincode.Decoded(CaptureError.ConsentRevoked, cursor)
            10 -> Bincode.Decoded(CaptureError.AccessRequiresRestart, cursor)
            11 -> {
                val d_inner = readOsVersion(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(CaptureError.OsTooOld(inner) as CaptureError, cursor)
            }
            12 -> Bincode.Decoded(CaptureError.OriginRefused, cursor)
            13 -> {
                val d_inner = Bincode.readString(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(CaptureError.PolicyDenied(inner) as CaptureError, cursor)
            }
            14 -> Bincode.Decoded(CaptureError.SinkUnreachable, cursor)
            15 -> Bincode.Decoded(CaptureError.SessionNotFound, cursor)
            16 -> Bincode.Decoded(CaptureError.GrantExpired, cursor)
            17 -> Bincode.Decoded(CaptureError.FormatLost, cursor)
            18 -> {
                val d_inner = readBackendDetail(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(CaptureError.Protocol(inner) as CaptureError, cursor)
            }
            19 -> {
                val d_inner = readOsFailure(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(CaptureError.Os(inner) as CaptureError, cursor)
            }
            20 -> Bincode.Decoded(CaptureError.SinkFull, cursor)
            else -> Bincode.Decoded(CaptureError.Unknown(disc.value, bytes.copyOfRange(cursor, bytes.size)) as CaptureError, bytes.size)
        }
    }

    override fun writeCaptureError(out: ByteArrayOutputStream, value: CaptureError) {
        when (value) {
            CaptureError.NoBackendCompiled -> Bincode.writeEnumDiscriminant(out, 0)
            is CaptureError.BackendNotCompiled -> {
                Bincode.writeEnumDiscriminant(out, 1)
                writeBackendId(out, value.value)
            }
            is CaptureError.BackendUnavailable -> {
                Bincode.writeEnumDiscriminant(out, 2)
                writeBackendReason(out, value.value)
            }
            is CaptureError.Unsatisfiable -> {
                Bincode.writeEnumDiscriminant(out, 3)
                writeUnmet(out, value.value)
            }
            is CaptureError.NoBackend -> {
                Bincode.writeEnumDiscriminant(out, 4)
                Bincode.writeVec(out, value.value) { s1, v1 -> writeBackendAttempt(s1, v1) }
            }
            is CaptureError.SourceNotFound -> {
                Bincode.writeEnumDiscriminant(out, 5)
                writeSourceId(out, value.value)
            }
            CaptureError.SourceLost -> Bincode.writeEnumDiscriminant(out, 6)
            CaptureError.ConsentRequired -> Bincode.writeEnumDiscriminant(out, 7)
            CaptureError.ConsentDenied -> Bincode.writeEnumDiscriminant(out, 8)
            CaptureError.ConsentRevoked -> Bincode.writeEnumDiscriminant(out, 9)
            CaptureError.AccessRequiresRestart -> Bincode.writeEnumDiscriminant(out, 10)
            is CaptureError.OsTooOld -> {
                Bincode.writeEnumDiscriminant(out, 11)
                writeOsVersion(out, value.value)
            }
            CaptureError.OriginRefused -> Bincode.writeEnumDiscriminant(out, 12)
            is CaptureError.PolicyDenied -> {
                Bincode.writeEnumDiscriminant(out, 13)
                Bincode.writeString(out, value.value)
            }
            CaptureError.SinkUnreachable -> Bincode.writeEnumDiscriminant(out, 14)
            CaptureError.SessionNotFound -> Bincode.writeEnumDiscriminant(out, 15)
            CaptureError.GrantExpired -> Bincode.writeEnumDiscriminant(out, 16)
            CaptureError.FormatLost -> Bincode.writeEnumDiscriminant(out, 17)
            is CaptureError.Protocol -> {
                Bincode.writeEnumDiscriminant(out, 18)
                writeBackendDetail(out, value.value)
            }
            is CaptureError.Os -> {
                Bincode.writeEnumDiscriminant(out, 19)
                writeOsFailure(out, value.value)
            }
            CaptureError.SinkFull -> Bincode.writeEnumDiscriminant(out, 20)
            is CaptureError.Unknown -> {
                Bincode.writeEnumDiscriminant(out, value.discriminant)
                out.write(value.payload, 0, value.payload.size)
            }
        }
    }

    override fun readPtsClock(bytes: ByteArray, offset: Int): Bincode.Decoded<PtsClock> {
        val d = Bincode.readEnumDiscriminant(bytes, offset)
        val variant = PtsClock.entries.getOrNull(d.value)
            ?: throw Bincode.DecodeException("PtsClock: unknown discriminant ${d.value}")
        return Bincode.Decoded(variant, d.consumed)
    }

    override fun writePtsClock(out: ByteArrayOutputStream, value: PtsClock) {
        Bincode.writeEnumDiscriminant(out, value.ordinal)
    }

    override fun readPlaneLayout(bytes: ByteArray, offset: Int): Bincode.Decoded<PlaneLayout> {
        var cursor = offset
        val d_offset_ = Bincode.readU32(bytes, cursor); cursor = d_offset_.consumed
        val offset_ = d_offset_.value
        val d_stride = Bincode.readU32(bytes, cursor); cursor = d_stride.consumed
        val stride = d_stride.value
        val d_size = Bincode.readU64(bytes, cursor); cursor = d_size.consumed
        val size = d_size.value
        return Bincode.Decoded(PlaneLayout(offset = offset_, stride = stride, size = size), cursor)
    }

    override fun writePlaneLayout(out: ByteArrayOutputStream, value: PlaneLayout) {
        Bincode.writeU32(out, value.offset)
        Bincode.writeU32(out, value.stride)
        Bincode.writeU64(out, value.size)
    }

    override fun readBufferIdentity(bytes: ByteArray, offset: Int): Bincode.Decoded<BufferIdentity> {
        var cursor = offset
        val d_poolGeneration = Bincode.readU64(bytes, cursor); cursor = d_poolGeneration.consumed
        val poolGeneration = d_poolGeneration.value
        val d_slot = Bincode.readU32(bytes, cursor); cursor = d_slot.consumed
        val slot = d_slot.value
        return Bincode.Decoded(BufferIdentity(poolGeneration = poolGeneration, slot = slot), cursor)
    }

    override fun writeBufferIdentity(out: ByteArrayOutputStream, value: BufferIdentity) {
        Bincode.writeU64(out, value.poolGeneration)
        Bincode.writeU32(out, value.slot)
    }

    override fun readDamage(bytes: ByteArray, offset: Int): Bincode.Decoded<Damage> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> Bincode.Decoded(Damage.Full, cursor)
            1 -> {
                val d_inner = Bincode.readVec(bytes, cursor) { b1, c1 -> readRect(b1, c1) }; cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(Damage.Rects(inner) as Damage, cursor)
            }
            2 -> Bincode.Decoded(Damage.Unchanged, cursor)
            else -> throw Bincode.DecodeException("Damage: unknown discriminant ${disc.value}")
        }
    }

    override fun writeDamage(out: ByteArrayOutputStream, value: Damage) {
        when (value) {
            Damage.Full -> Bincode.writeEnumDiscriminant(out, 0)
            is Damage.Rects -> {
                Bincode.writeEnumDiscriminant(out, 1)
                Bincode.writeVec(out, value.value) { s1, v1 -> writeRect(s1, v1) }
            }
            Damage.Unchanged -> Bincode.writeEnumDiscriminant(out, 2)
        }
    }

    override fun readCursorState(bytes: ByteArray, offset: Int): Bincode.Decoded<CursorState> {
        var cursor = offset
        val d_position = readPoint(bytes, cursor); cursor = d_position.consumed
        val position = d_position.value
        val d_hotspot = readPoint(bytes, cursor); cursor = d_hotspot.consumed
        val hotspot = d_hotspot.value
        val d_visible = Bincode.readBool(bytes, cursor); cursor = d_visible.consumed
        val visible = d_visible.value
        return Bincode.Decoded(CursorState(position = position, hotspot = hotspot, visible = visible), cursor)
    }

    override fun writeCursorState(out: ByteArrayOutputStream, value: CursorState) {
        writePoint(out, value.position)
        writePoint(out, value.hotspot)
        Bincode.writeBool(out, value.visible)
    }

    override fun readCompositePart(bytes: ByteArray, offset: Int): Bincode.Decoded<CompositePart> {
        var cursor = offset
        val d_source = readSourceId(bytes, cursor); cursor = d_source.consumed
        val source = d_source.value
        val d_rect = readRect(bytes, cursor); cursor = d_rect.consumed
        val rect = d_rect.value
        val d_ptsNs = Bincode.readU64(bytes, cursor); cursor = d_ptsNs.consumed
        val ptsNs = d_ptsNs.value
        val d_scalePermille = Bincode.readU32(bytes, cursor); cursor = d_scalePermille.consumed
        val scalePermille = d_scalePermille.value
        return Bincode.Decoded(CompositePart(source = source, rect = rect, ptsNs = ptsNs, scalePermille = scalePermille), cursor)
    }

    override fun writeCompositePart(out: ByteArrayOutputStream, value: CompositePart) {
        writeSourceId(out, value.source)
        writeRect(out, value.rect)
        Bincode.writeU64(out, value.ptsNs)
        Bincode.writeU32(out, value.scalePermille)
    }

    override fun readCompositeInfo(bytes: ByteArray, offset: Int): Bincode.Decoded<CompositeInfo> {
        var cursor = offset
        val d_parts = Bincode.readVec(bytes, cursor) { b1, c1 -> readCompositePart(b1, c1) }; cursor = d_parts.consumed
        val parts = d_parts.value
        val d_skewNs = Bincode.readU64(bytes, cursor); cursor = d_skewNs.consumed
        val skewNs = d_skewNs.value
        return Bincode.Decoded(CompositeInfo(parts = parts, skewNs = skewNs), cursor)
    }

    override fun writeCompositeInfo(out: ByteArrayOutputStream, value: CompositeInfo) {
        Bincode.writeVec(out, value.parts) { s1, v1 -> writeCompositePart(s1, v1) }
        Bincode.writeU64(out, value.skewNs)
    }

    override fun readHdrMetadata(bytes: ByteArray, offset: Int): Bincode.Decoded<HdrMetadata> {
        var cursor = offset
        val d_maxLuminanceNits = Bincode.readU32(bytes, cursor); cursor = d_maxLuminanceNits.consumed
        val maxLuminanceNits = d_maxLuminanceNits.value
        val d_minLuminance = Bincode.readU32(bytes, cursor); cursor = d_minLuminance.consumed
        val minLuminance = d_minLuminance.value
        val d_maxCll = Bincode.readU32(bytes, cursor); cursor = d_maxCll.consumed
        val maxCll = d_maxCll.value
        val d_maxFall = Bincode.readU32(bytes, cursor); cursor = d_maxFall.consumed
        val maxFall = d_maxFall.value
        return Bincode.Decoded(HdrMetadata(maxLuminanceNits = maxLuminanceNits, minLuminance = minLuminance, maxCll = maxCll, maxFall = maxFall), cursor)
    }

    override fun writeHdrMetadata(out: ByteArrayOutputStream, value: HdrMetadata) {
        Bincode.writeU32(out, value.maxLuminanceNits)
        Bincode.writeU32(out, value.minLuminance)
        Bincode.writeU32(out, value.maxCll)
        Bincode.writeU32(out, value.maxFall)
    }

    override fun readFrameMeta(bytes: ByteArray, offset: Int): Bincode.Decoded<FrameMeta> {
        var cursor = offset
        val d_seq = Bincode.readU64(bytes, cursor); cursor = d_seq.consumed
        val seq = d_seq.value
        val d_ptsNs = Bincode.readU64(bytes, cursor); cursor = d_ptsNs.consumed
        val ptsNs = d_ptsNs.value
        val d_ptsClock = readPtsClock(bytes, cursor); cursor = d_ptsClock.consumed
        val ptsClock = d_ptsClock.value
        val d_wallUs = Bincode.readU64(bytes, cursor); cursor = d_wallUs.consumed
        val wallUs = d_wallUs.value
        val d_size = readSize(bytes, cursor); cursor = d_size.consumed
        val size = d_size.value
        val d_contentRect = readRect(bytes, cursor); cursor = d_contentRect.consumed
        val contentRect = d_contentRect.value
        val d_format = readPixelFormat(bytes, cursor); cursor = d_format.consumed
        val format = d_format.value
        val d_memory = readBufferMemory(bytes, cursor); cursor = d_memory.consumed
        val memory = d_memory.value
        val d_planes = Bincode.readVec(bytes, cursor) { b1, c1 -> readPlaneLayout(b1, c1) }; cursor = d_planes.consumed
        val planes = d_planes.value
        val d_modifier = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readU64(b1, c1) }; cursor = d_modifier.consumed
        val modifier = d_modifier.value
        val d_buffer = readBufferIdentity(bytes, cursor); cursor = d_buffer.consumed
        val buffer = d_buffer.value
        val d_tier = Bincode.readU8(bytes, cursor); cursor = d_tier.consumed
        val tier = d_tier.value
        val d_copied = Bincode.readOption(bytes, cursor) { b1, c1 -> readCopyStage(b1, c1) }; cursor = d_copied.consumed
        val copied = d_copied.value
        val d_producer = Bincode.readOption(bytes, cursor) { b1, c1 -> readGpuIdentity(b1, c1) }; cursor = d_producer.consumed
        val producer = d_producer.value
        val d_colour = readColour(bytes, cursor); cursor = d_colour.consumed
        val colour = d_colour.value
        val d_hdr = Bincode.readOption(bytes, cursor) { b1, c1 -> readHdrMetadata(b1, c1) }; cursor = d_hdr.consumed
        val hdr = d_hdr.value
        val d_orientation = readOrientation(bytes, cursor); cursor = d_orientation.consumed
        val orientation = d_orientation.value
        val d_damage = readDamage(bytes, cursor); cursor = d_damage.consumed
        val damage = d_damage.value
        val d_cursor_ = Bincode.readOption(bytes, cursor) { b1, c1 -> readCursorState(b1, c1) }; cursor = d_cursor_.consumed
        val cursor_ = d_cursor_.value
        val d_sync = readSyncKind(bytes, cursor); cursor = d_sync.consumed
        val sync = d_sync.value
        val d_scalePermille = Bincode.readU32(bytes, cursor); cursor = d_scalePermille.consumed
        val scalePermille = d_scalePermille.value
        val d_sourceId = readSourceId(bytes, cursor); cursor = d_sourceId.consumed
        val sourceId = d_sourceId.value
        val d_repeat = Bincode.readBool(bytes, cursor); cursor = d_repeat.consumed
        val repeat = d_repeat.value
        val d_skippedBefore = Bincode.readU32(bytes, cursor); cursor = d_skippedBefore.consumed
        val skippedBefore = d_skippedBefore.value
        val d_protectedContent = Bincode.readBool(bytes, cursor); cursor = d_protectedContent.consumed
        val protectedContent = d_protectedContent.value
        val d_composite = Bincode.readOption(bytes, cursor) { b1, c1 -> readCompositeInfo(b1, c1) }; cursor = d_composite.consumed
        val composite = d_composite.value
        return Bincode.Decoded(FrameMeta(seq = seq, ptsNs = ptsNs, ptsClock = ptsClock, wallUs = wallUs, size = size, contentRect = contentRect, format = format, memory = memory, planes = planes, modifier = modifier, buffer = buffer, tier = tier, copied = copied, producer = producer, colour = colour, hdr = hdr, orientation = orientation, damage = damage, cursor = cursor_, sync = sync, scalePermille = scalePermille, sourceId = sourceId, repeat = repeat, skippedBefore = skippedBefore, protectedContent = protectedContent, composite = composite), cursor)
    }

    override fun writeFrameMeta(out: ByteArrayOutputStream, value: FrameMeta) {
        Bincode.writeU64(out, value.seq)
        Bincode.writeU64(out, value.ptsNs)
        writePtsClock(out, value.ptsClock)
        Bincode.writeU64(out, value.wallUs)
        writeSize(out, value.size)
        writeRect(out, value.contentRect)
        writePixelFormat(out, value.format)
        writeBufferMemory(out, value.memory)
        Bincode.writeVec(out, value.planes) { s1, v1 -> writePlaneLayout(s1, v1) }
        Bincode.writeOption(out, value.modifier) { s1, v1 -> Bincode.writeU64(s1, v1) }
        writeBufferIdentity(out, value.buffer)
        Bincode.writeU8(out, value.tier)
        Bincode.writeOption(out, value.copied) { s1, v1 -> writeCopyStage(s1, v1) }
        Bincode.writeOption(out, value.producer) { s1, v1 -> writeGpuIdentity(s1, v1) }
        writeColour(out, value.colour)
        Bincode.writeOption(out, value.hdr) { s1, v1 -> writeHdrMetadata(s1, v1) }
        writeOrientation(out, value.orientation)
