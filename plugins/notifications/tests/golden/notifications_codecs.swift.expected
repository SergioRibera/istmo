    public func readChannelSpec(_ c: inout Bincode.Cursor) throws -> Notifications.ChannelSpec {
        let id = try self.readChannelId(&c)
        let name = try Bincode.readString(&c)
        let description = try Bincode.readOption(&c) { c1 in try Bincode.readString(&c1) }
        let importance = try self.readInterruption(&c)
        let sound = try Bincode.readOption(&c) { c1 in try self.readSound(&c1) }
        let vibration = try Bincode.readOption(&c) { c1 in try Bincode.readVec(&c1) { c2 in try Bincode.readVarintU32(&c2) } }
        let lightColor = try Bincode.readOption(&c) { c1 in try Bincode.readVarintU32(&c1) }
        let showBadge = try Bincode.readBool(&c)
        let lockScreen = try Bincode.readOption(&c) { c1 in try self.readLockScreen(&c1) }
        let bypassDnd = try Bincode.readBool(&c)
        let group = try Bincode.readOption(&c) { c1 in try Bincode.readString(&c1) }
        return Notifications.ChannelSpec(id: id, name: name, description: description, importance: importance, sound: sound, vibration: vibration, lightColor: lightColor, showBadge: showBadge, lockScreen: lockScreen, bypassDnd: bypassDnd, group: group)
    }

    public func writeChannelSpec(_ out: inout Data, _ value: Notifications.ChannelSpec) {
        self.writeChannelId(&out, value.id)
        Bincode.writeString(&out, value.name)
        Bincode.writeOption(&out, value.description) { o1, v1 in Bincode.writeString(&o1, v1) }
        self.writeInterruption(&out, value.importance)
        Bincode.writeOption(&out, value.sound) { o1, v1 in self.writeSound(&o1, v1) }
        Bincode.writeOption(&out, value.vibration) { o1, v1 in Bincode.writeVec(&o1, v1) { o2, v2 in Bincode.writeVarintU32(&o2, v2) } }
        Bincode.writeOption(&out, value.lightColor) { o1, v1 in Bincode.writeVarintU32(&o1, v1) }
        Bincode.writeBool(&out, value.showBadge)
        Bincode.writeOption(&out, value.lockScreen) { o1, v1 in self.writeLockScreen(&o1, v1) }
        Bincode.writeBool(&out, value.bypassDnd)
        Bincode.writeOption(&out, value.group) { o1, v1 in Bincode.writeString(&o1, v1) }
    }

    public func readFeature(_ c: inout Bincode.Cursor) throws -> Notifications.Feature {
        let disc = try Bincode.readVarintU32(&c)
        switch disc {
        case 0: return .show
        case 1: return .update
        case 2: return .silentUpdate
        case 3: return .progressBar
        case 4: return .livePromotion
        case 5: return .schedule
        case 6: return .`repeat`
        case 7: return .missed
        case 8: return .actions
        case 9: return .inlineReply
        case 10: return .choices
        case 11: return .snooze
        case 12: return .avatar
        case 13: return .picture
        case 14: return .messaging
        case 15: return .callStyle
        case 16: return .groups
        case 17: return .channels
        case 18: return .customSound
        case 19: return .interruption
        case 20: return .ongoing
        case 21: return .timeout
        case 22: return .lockScreen
        case 23: return .chronometer
        case 24: return .listDelivered
        case 25: return .listPending
        case 26: return .dismissal
        case 27: return .tapWhenClosed
        case 28: return .backgroundAction
        case 29: return .permissionRequest
        case 30: return .exactAlarms
        case 31: return .doNotDisturb
        case 32: return .openSettings
        default:
            let payload = c.data.subdata(in: (c.data.endIndex - c.remaining) ..< c.data.endIndex)
            c.offset += payload.count
            return .unknown(discriminant: disc, payload: payload)
        }
    }

    public func writeFeature(_ out: inout Data, _ value: Notifications.Feature) {
        switch value {
        case .show:
            Bincode.writeVarintU32(&out, 0)
        case .update:
            Bincode.writeVarintU32(&out, 1)
        case .silentUpdate:
            Bincode.writeVarintU32(&out, 2)
        case .progressBar:
            Bincode.writeVarintU32(&out, 3)
        case .livePromotion:
            Bincode.writeVarintU32(&out, 4)
        case .schedule:
            Bincode.writeVarintU32(&out, 5)
        case .`repeat`:
            Bincode.writeVarintU32(&out, 6)
        case .missed:
            Bincode.writeVarintU32(&out, 7)
        case .actions:
            Bincode.writeVarintU32(&out, 8)
        case .inlineReply:
            Bincode.writeVarintU32(&out, 9)
        case .choices:
            Bincode.writeVarintU32(&out, 10)
        case .snooze:
            Bincode.writeVarintU32(&out, 11)
        case .avatar:
            Bincode.writeVarintU32(&out, 12)
        case .picture:
            Bincode.writeVarintU32(&out, 13)
        case .messaging:
            Bincode.writeVarintU32(&out, 14)
        case .callStyle:
            Bincode.writeVarintU32(&out, 15)
        case .groups:
            Bincode.writeVarintU32(&out, 16)
        case .channels:
            Bincode.writeVarintU32(&out, 17)
        case .customSound:
            Bincode.writeVarintU32(&out, 18)
        case .interruption:
            Bincode.writeVarintU32(&out, 19)
        case .ongoing:
            Bincode.writeVarintU32(&out, 20)
        case .timeout:
            Bincode.writeVarintU32(&out, 21)
        case .lockScreen:
            Bincode.writeVarintU32(&out, 22)
        case .chronometer:
            Bincode.writeVarintU32(&out, 23)
        case .listDelivered:
            Bincode.writeVarintU32(&out, 24)
        case .listPending:
            Bincode.writeVarintU32(&out, 25)
        case .dismissal:
            Bincode.writeVarintU32(&out, 26)
        case .tapWhenClosed:
            Bincode.writeVarintU32(&out, 27)
        case .backgroundAction:
            Bincode.writeVarintU32(&out, 28)
        case .permissionRequest:
            Bincode.writeVarintU32(&out, 29)
        case .exactAlarms:
            Bincode.writeVarintU32(&out, 30)
        case .doNotDisturb:
            Bincode.writeVarintU32(&out, 31)
        case .openSettings:
            Bincode.writeVarintU32(&out, 32)
        case .unknown(let discriminant, let payload):
            Bincode.writeVarintU32(&out, discriminant)
            out.append(payload)
        }
    }

    public func readSupport(_ c: inout Bincode.Cursor) throws -> Notifications.Support {
        let disc = try Bincode.readVarintU32(&c)
        switch disc {
        case 0: return .native
        case 1: return .simulated
        case 2: return .whileRunning
        case 3: return .unsupported
        default:
            let payload = c.data.subdata(in: (c.data.endIndex - c.remaining) ..< c.data.endIndex)
            c.offset += payload.count
            return .unknown(discriminant: disc, payload: payload)
        }
    }

    public func writeSupport(_ out: inout Data, _ value: Notifications.Support) {
        switch value {
        case .native:
            Bincode.writeVarintU32(&out, 0)
        case .simulated:
            Bincode.writeVarintU32(&out, 1)
        case .whileRunning:
            Bincode.writeVarintU32(&out, 2)
        case .unsupported:
            Bincode.writeVarintU32(&out, 3)
        case .unknown(let discriminant, let payload):
            Bincode.writeVarintU32(&out, discriminant)
            out.append(payload)
        }
    }

    public func readFeatureSupport(_ c: inout Bincode.Cursor) throws -> Notifications.FeatureSupport {
        let feature = try self.readFeature(&c)
        let support = try self.readSupport(&c)
        return Notifications.FeatureSupport(feature: feature, support: support)
    }

    public func writeFeatureSupport(_ out: inout Data, _ value: Notifications.FeatureSupport) {
        self.writeFeature(&out, value.feature)
        self.writeSupport(&out, value.support)
    }

    public func readCapabilities(_ c: inout Bincode.Cursor) throws -> Notifications.Capabilities {
        let backend = try Bincode.readString(&c)
        let features = try Bincode.readVec(&c) { c1 in try self.readFeatureSupport(&c1) }
        let maxActions = try Bincode.readVarintU32(&c)
        let maxPending = try Bincode.readOption(&c) { c1 in try Bincode.readVarintU32(&c1) }
        let maxActive = try Bincode.readOption(&c) { c1 in try Bincode.readVarintU32(&c1) }
        return Notifications.Capabilities(backend: backend, features: features, maxActions: maxActions, maxPending: maxPending, maxActive: maxActive)
    }

    public func writeCapabilities(_ out: inout Data, _ value: Notifications.Capabilities) {
        Bincode.writeString(&out, value.backend)
        Bincode.writeVec(&out, value.features) { o1, v1 in self.writeFeatureSupport(&o1, v1) }
        Bincode.writeVarintU32(&out, value.maxActions)
        Bincode.writeOption(&out, value.maxPending) { o1, v1 in Bincode.writeVarintU32(&o1, v1) }
        Bincode.writeOption(&out, value.maxActive) { o1, v1 in Bincode.writeVarintU32(&o1, v1) }
    }

