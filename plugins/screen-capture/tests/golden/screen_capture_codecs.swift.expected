    public func readCaptureError(_ c: inout Bincode.Cursor) throws -> CaptureError {
        let disc = try Bincode.readVarintU32(&c)
        switch disc {
        case 0: return .noBackendCompiled
        case 1: return .backendNotCompiled(try self.readBackendId(&c))
        case 2: return .backendUnavailable(try self.readBackendReason(&c))
        case 3: return .unsatisfiable(try self.readUnmet(&c))
        case 4: return .noBackend(try Bincode.readVec(&c) { c1 in try self.readBackendAttempt(&c1) })
        case 5: return .sourceNotFound(try self.readSourceId(&c))
        case 6: return .sourceLost
        case 7: return .consentRequired
        case 8: return .consentDenied
        case 9: return .consentRevoked
        case 10: return .accessRequiresRestart
        case 11: return .osTooOld(try self.readOsVersion(&c))
        case 12: return .originRefused
        case 13: return .policyDenied(try Bincode.readString(&c))
        case 14: return .sinkUnreachable
        case 15: return .sessionNotFound
        case 16: return .grantExpired
        case 17: return .formatLost
        case 18: return .`protocol`(try self.readBackendDetail(&c))
        case 19: return .os(try self.readOsFailure(&c))
        case 20: return .sinkFull
        default: throw Bincode.DecodeError.invalidTag(UInt8(clamping: disc))
        }
    }

    public func writeCaptureError(_ out: inout Data, _ value: CaptureError) {
        switch value {
        case .noBackendCompiled:
            Bincode.writeVarintU32(&out, 0)
        case .backendNotCompiled(let payload):
            Bincode.writeVarintU32(&out, 1)
            self.writeBackendId(&out, payload)
        case .backendUnavailable(let payload):
            Bincode.writeVarintU32(&out, 2)
            self.writeBackendReason(&out, payload)
        case .unsatisfiable(let payload):
            Bincode.writeVarintU32(&out, 3)
            self.writeUnmet(&out, payload)
        case .noBackend(let payload):
            Bincode.writeVarintU32(&out, 4)
            Bincode.writeVec(&out, payload) { o1, v1 in self.writeBackendAttempt(&o1, v1) }
        case .sourceNotFound(let payload):
            Bincode.writeVarintU32(&out, 5)
            self.writeSourceId(&out, payload)
        case .sourceLost:
            Bincode.writeVarintU32(&out, 6)
        case .consentRequired:
            Bincode.writeVarintU32(&out, 7)
        case .consentDenied:
            Bincode.writeVarintU32(&out, 8)
        case .consentRevoked:
            Bincode.writeVarintU32(&out, 9)
        case .accessRequiresRestart:
            Bincode.writeVarintU32(&out, 10)
        case .osTooOld(let payload):
            Bincode.writeVarintU32(&out, 11)
            self.writeOsVersion(&out, payload)
        case .originRefused:
            Bincode.writeVarintU32(&out, 12)
        case .policyDenied(let payload):
            Bincode.writeVarintU32(&out, 13)
            Bincode.writeString(&out, payload)
        case .sinkUnreachable:
            Bincode.writeVarintU32(&out, 14)
        case .sessionNotFound:
            Bincode.writeVarintU32(&out, 15)
        case .grantExpired:
            Bincode.writeVarintU32(&out, 16)
        case .formatLost:
            Bincode.writeVarintU32(&out, 17)
        case .`protocol`(let payload):
            Bincode.writeVarintU32(&out, 18)
            self.writeBackendDetail(&out, payload)
        case .os(let payload):
            Bincode.writeVarintU32(&out, 19)
            self.writeOsFailure(&out, payload)
        case .sinkFull:
            Bincode.writeVarintU32(&out, 20)
        }
    }

