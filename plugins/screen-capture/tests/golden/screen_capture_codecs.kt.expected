    override fun writeAudioSource(out: ByteArrayOutputStream, value: AudioSource) {
        when (value) {
            AudioSource.System -> Bincode.writeEnumDiscriminant(out, 0)
            is AudioSource.Application -> {
                Bincode.writeEnumDiscriminant(out, 1)
                Bincode.writeString(out, value.value)
            }
            AudioSource.ExcludeSelf -> Bincode.writeEnumDiscriminant(out, 2)
            is AudioSource.Node -> {
