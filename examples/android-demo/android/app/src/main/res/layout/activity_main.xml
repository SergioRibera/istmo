<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Echo — Kotlin → EchoClient → Frame::Call → EchoImpl.echo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Echo"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/inputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Type something"
            android:inputType="text"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/callButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Call Echo" />

        <TextView
            android:id="@+id/output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textIsSelectable="true" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#E0E0E0" />

        <!-- Permissions — EchoClient.checkPermission / requestPermission →
             EchoImpl uses PermissionsClient → PermissionsImpl (Android) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Permissions (via Rust)"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/permissionInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="android.permission.CAMERA"
            android:inputType="text"
            android:importantForAutofill="no" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/permissionCheck"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Check" />
            <Button
                android:id="@+id/permissionRequest"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Request" />
        </LinearLayout>

        <TextView
            android:id="@+id/permissionOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textIsSelectable="true" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#E0E0E0" />

        <!-- Activity results — EchoClient.openUrl → EchoImpl uses
             ActivityResultsClient → ActivityResultsImpl (startActivity) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activity result (VIEW intent via Rust)"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/intentUri"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="https://example.com"
            android:inputType="textUri"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/launchIntent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open URL" />

        <TextView
            android:id="@+id/intentOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textIsSelectable="true" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#E0E0E0" />

        <!-- Lifecycle — Kotlin observer publishes early events; Rust reads
             via AppLifecycle.current() when EchoClient.lifecycleSnapshot()
             fires -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lifecycle snapshot (via Rust)"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/lifecycleState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="(press to poll Rust)"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/lifecycleRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Snapshot current state" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#E0E0E0" />

        <!-- Deep links — Kotlin submits early events on intent arrival; Rust
             drains via DeepLinks.stream() when EchoClient.drainDeeplinks() fires -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deep links (Rust drain)"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="italic"
            android:textSize="12sp"
            android:text="adb shell am start -a android.intent.action.VIEW -d 'istmo://open?tab=home' dev.istmo.demo" />

        <TextView
            android:id="@+id/deeplinkList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textIsSelectable="true"
            android:minLines="2"
            android:hint="(no links drained)" />

        <Button
            android:id="@+id/deeplinkRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Drain deep links via Rust" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#E0E0E0" />

        <!-- Notifier — Rust-initiated calls into Kotlin. Kotlin invokes
             EchoClient.spamNotify(N); Rust responds by firing N outbound
             Frame::Call frames back to NotifierImpl, which appends to the
             log below in real time. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notifier (Rust → Mobile)"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="italic"
            android:textSize="12sp"
            android:text="Rust triggers N outbound calls into Kotlin's NotifierImpl." />

        <EditText
            android:id="@+id/notifyCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="5"
            android:inputType="number"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/notifyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Spam notifications from Rust" />

        <TextView
            android:id="@+id/notifyOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/notifyLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:background="#F5F5F5"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:minLines="3"
            android:hint="(notifications appear here)" />
    </LinearLayout>
</ScrollView>
