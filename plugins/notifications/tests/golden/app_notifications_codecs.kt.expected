    override fun readCallInfo(bytes: ByteArray, offset: Int): Bincode.Decoded<CallInfo> {
        var cursor = offset
        val d_caller = readParticipant(bytes, cursor); cursor = d_caller.consumed
        val caller = d_caller.value
        val d_kind = readCallKind(bytes, cursor); cursor = d_kind.consumed
        val kind = d_kind.value
        val d_video = Bincode.readBool(bytes, cursor); cursor = d_video.consumed
        val video = d_video.value
        return Bincode.Decoded(CallInfo(caller = caller, kind = kind, video = video), cursor)
    }

    override fun writeCallInfo(out: ByteArrayOutputStream, value: CallInfo) {
        writeParticipant(out, value.caller)
        writeCallKind(out, value.kind)
        Bincode.writeBool(out, value.video)
    }

    override fun readCallKind(bytes: ByteArray, offset: Int): Bincode.Decoded<CallKind> {
        val d = Bincode.readEnumDiscriminant(bytes, offset)
        val variant = CallKind.entries.getOrNull(d.value)
            ?: throw Bincode.DecodeException("CallKind: unknown discriminant ${d.value}")
        return Bincode.Decoded(variant, d.consumed)
    }

    override fun writeCallKind(out: ByteArrayOutputStream, value: CallKind) {
        Bincode.writeEnumDiscriminant(out, value.ordinal)
    }

    override fun readAction(bytes: ByteArray, offset: Int): Bincode.Decoded<Action> {
        var cursor = offset
        val d_id = readActionId(bytes, cursor); cursor = d_id.consumed
        val id = d_id.value
        val d_title = Bincode.readString(bytes, cursor); cursor = d_title.consumed
        val title = d_title.value
        val d_kind = readActionKind(bytes, cursor); cursor = d_kind.consumed
        val kind = d_kind.value
        val d_opensApp = Bincode.readBool(bytes, cursor); cursor = d_opensApp.consumed
        val opensApp = d_opensApp.value
        val d_destructive = Bincode.readBool(bytes, cursor); cursor = d_destructive.consumed
        val destructive = d_destructive.value
        val d_requiresUnlock = Bincode.readBool(bytes, cursor); cursor = d_requiresUnlock.consumed
        val requiresUnlock = d_requiresUnlock.value
        val d_url = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_url.consumed
        val url = d_url.value
        val d_icon = Bincode.readOption(bytes, cursor) { b1, c1 -> readNotificationImage(b1, c1) }; cursor = d_icon.consumed
        val icon = d_icon.value
        return Bincode.Decoded(Action(id = id, title = title, kind = kind, opensApp = opensApp, destructive = destructive, requiresUnlock = requiresUnlock, url = url, icon = icon), cursor)
    }

    override fun writeAction(out: ByteArrayOutputStream, value: Action) {
        writeActionId(out, value.id)
        Bincode.writeString(out, value.title)
        writeActionKind(out, value.kind)
        Bincode.writeBool(out, value.opensApp)
        Bincode.writeBool(out, value.destructive)
        Bincode.writeBool(out, value.requiresUnlock)
        Bincode.writeOption(out, value.url) { s1, v1 -> Bincode.writeString(s1, v1) }
        Bincode.writeOption(out, value.icon) { s1, v1 -> writeNotificationImage(s1, v1) }
    }

    override fun readActionKind(bytes: ByteArray, offset: Int): Bincode.Decoded<ActionKind> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> Bincode.Decoded(ActionKind.Button, cursor)
            1 -> {
                val d_inner = readReplyOptions(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(ActionKind.Reply(inner) as ActionKind, cursor)
            }
            2 -> {
                val d_inner = Bincode.readVec(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(ActionKind.Select(inner) as ActionKind, cursor)
            }
            3 -> {
                val d_inner = Bincode.readU64(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(ActionKind.Snooze(inner) as ActionKind, cursor)
            }
            else -> throw Bincode.DecodeException("ActionKind: unknown discriminant ${disc.value}")
        }
    }

    override fun writeActionKind(out: ByteArrayOutputStream, value: ActionKind) {
        when (value) {
            ActionKind.Button -> Bincode.writeEnumDiscriminant(out, 0)
            is ActionKind.Reply -> {
                Bincode.writeEnumDiscriminant(out, 1)
                writeReplyOptions(out, value.value)
            }
            is ActionKind.Select -> {
                Bincode.writeEnumDiscriminant(out, 2)
                Bincode.writeVec(out, value.value) { s1, v1 -> Bincode.writeString(s1, v1) }
            }
            is ActionKind.Snooze -> {
                Bincode.writeEnumDiscriminant(out, 3)
                Bincode.writeU64(out, value.value)
            }
        }
    }

    override fun readReplyOptions(bytes: ByteArray, offset: Int): Bincode.Decoded<ReplyOptions> {
        var cursor = offset
        val d_placeholder = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_placeholder.consumed
        val placeholder = d_placeholder.value
        val d_submitTitle = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_submitTitle.consumed
        val submitTitle = d_submitTitle.value
        val d_suggestions = Bincode.readVec(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_suggestions.consumed
        val suggestions = d_suggestions.value
        return Bincode.Decoded(ReplyOptions(placeholder = placeholder, submitTitle = submitTitle, suggestions = suggestions), cursor)
    }

    override fun writeReplyOptions(out: ByteArrayOutputStream, value: ReplyOptions) {
        Bincode.writeOption(out, value.placeholder) { s1, v1 -> Bincode.writeString(s1, v1) }
        Bincode.writeOption(out, value.submitTitle) { s1, v1 -> Bincode.writeString(s1, v1) }
        Bincode.writeVec(out, value.suggestions) { s1, v1 -> Bincode.writeString(s1, v1) }
    }

    override fun readGroup(bytes: ByteArray, offset: Int): Bincode.Decoded<Group> {
        var cursor = offset
        val d_id = readGroupId(bytes, cursor); cursor = d_id.consumed
        val id = d_id.value
        val d_title = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_title.consumed
