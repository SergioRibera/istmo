    override fun readNegotiatedStream(bytes: ByteArray, offset: Int): Bincode.Decoded<NegotiatedStream> {
        var cursor = offset
        val d_backend = readBackendId(bytes, cursor); cursor = d_backend.consumed
        val backend = d_backend.value
        val d_source = readSource(bytes, cursor); cursor = d_source.consumed
        val source = d_source.value
        val d_size = readSize(bytes, cursor); cursor = d_size.consumed
        val size = d_size.value
        val d_contentRect = readRect(bytes, cursor); cursor = d_contentRect.consumed
        val contentRect = d_contentRect.value
        val d_format = readPixelFormat(bytes, cursor); cursor = d_format.consumed
        val format = d_format.value
        val d_memory = readBufferMemory(bytes, cursor); cursor = d_memory.consumed
        val memory = d_memory.value
        val d_modifier = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readU64(b1, c1) }; cursor = d_modifier.consumed
        val modifier = d_modifier.value
        val d_tier = Bincode.readU8(bytes, cursor); cursor = d_tier.consumed
        val tier = d_tier.value
        val d_copies = Bincode.readVec(bytes, cursor) { b1, c1 -> readCopyStage(b1, c1) }; cursor = d_copies.consumed
        val copies = d_copies.value
        val d_fps = readFrameRate(bytes, cursor); cursor = d_fps.consumed
        val fps = d_fps.value
        val d_sourceRateMhz = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readU32(b1, c1) }; cursor = d_sourceRateMhz.consumed
        val sourceRateMhz = d_sourceRateMhz.value
        val d_producer = Bincode.readOption(bytes, cursor) { b1, c1 -> readGpuIdentity(b1, c1) }; cursor = d_producer.consumed
        val producer = d_producer.value
        val d_sync = readSyncKind(bytes, cursor); cursor = d_sync.consumed
        val sync = d_sync.value
        val d_poolDepth = Bincode.readU8(bytes, cursor); cursor = d_poolDepth.consumed
        val poolDepth = d_poolDepth.value
        val d_exhaustion = readExhaustion(bytes, cursor); cursor = d_exhaustion.consumed
        val exhaustion = d_exhaustion.value
        val d_orientation = readOrientationSupport(bytes, cursor); cursor = d_orientation.consumed
        val orientation = d_orientation.value
        val d_crop = readRegionCrop(bytes, cursor); cursor = d_crop.consumed
        val crop = d_crop.value
        val d_damage = readDamageSupport(bytes, cursor); cursor = d_damage.consumed
        val damage = d_damage.value
        val d_cursor_ = readCursorMode(bytes, cursor); cursor = d_cursor_.consumed
        val cursor_ = d_cursor_.value
        val d_colour = readColour(bytes, cursor); cursor = d_colour.consumed
        val colour = d_colour.value
        val d_hdr = Bincode.readBool(bytes, cursor); cursor = d_hdr.consumed
        val hdr = d_hdr.value
        val d_composite = Bincode.readOption(bytes, cursor) { b1, c1 -> readCompositeInfo(b1, c1) }; cursor = d_composite.consumed
        val composite = d_composite.value
        val d_consent = readConsentModel(bytes, cursor); cursor = d_consent.consumed
        val consent = d_consent.value
        val d_indicator = readIndicatorState(bytes, cursor); cursor = d_indicator.consumed
        val indicator = d_indicator.value
        val d_border = readBorderState(bytes, cursor); cursor = d_border.consumed
        val border = d_border.value
        val d_restoreToken = Bincode.readOption(bytes, cursor) { b1, c1 -> readRestoreToken(b1, c1) }; cursor = d_restoreToken.consumed
        val restoreToken = d_restoreToken.value
        val d_restored = Bincode.readBool(bytes, cursor); cursor = d_restored.consumed
        val restored = d_restored.value
        val d_audio = Bincode.readOption(bytes, cursor) { b1, c1 -> readAudioNegotiated(b1, c1) }; cursor = d_audio.consumed
        val audio = d_audio.value
        return Bincode.Decoded(NegotiatedStream(backend = backend, source = source, size = size, contentRect = contentRect, format = format, memory = memory, modifier = modifier, tier = tier, copies = copies, fps = fps, sourceRateMhz = sourceRateMhz, producer = producer, sync = sync, poolDepth = poolDepth, exhaustion = exhaustion, orientation = orientation, crop = crop, damage = damage, cursor = cursor_, colour = colour, hdr = hdr, composite = composite, consent = consent, indicator = indicator, border = border, restoreToken = restoreToken, restored = restored, audio = audio), cursor)
    }

    override fun writeNegotiatedStream(out: ByteArrayOutputStream, value: NegotiatedStream) {
        writeBackendId(out, value.backend)
        writeSource(out, value.source)
        writeSize(out, value.size)
        writeRect(out, value.contentRect)
        writePixelFormat(out, value.format)
        writeBufferMemory(out, value.memory)
        Bincode.writeOption(out, value.modifier) { s1, v1 -> Bincode.writeU64(s1, v1) }
        Bincode.writeU8(out, value.tier)
        Bincode.writeVec(out, value.copies) { s1, v1 -> writeCopyStage(s1, v1) }
        writeFrameRate(out, value.fps)
        Bincode.writeOption(out, value.sourceRateMhz) { s1, v1 -> Bincode.writeU32(s1, v1) }
        Bincode.writeOption(out, value.producer) { s1, v1 -> writeGpuIdentity(s1, v1) }
        writeSyncKind(out, value.sync)
        Bincode.writeU8(out, value.poolDepth)
        writeExhaustion(out, value.exhaustion)
        writeOrientationSupport(out, value.orientation)
        writeRegionCrop(out, value.crop)
        writeDamageSupport(out, value.damage)
        writeCursorMode(out, value.cursor)
        writeColour(out, value.colour)
        Bincode.writeBool(out, value.hdr)
        Bincode.writeOption(out, value.composite) { s1, v1 -> writeCompositeInfo(s1, v1) }
        writeConsentModel(out, value.consent)
        writeIndicatorState(out, value.indicator)
        writeBorderState(out, value.border)
        Bincode.writeOption(out, value.restoreToken) { s1, v1 -> writeRestoreToken(s1, v1) }
        Bincode.writeBool(out, value.restored)
        Bincode.writeOption(out, value.audio) { s1, v1 -> writeAudioNegotiated(s1, v1) }
    }

