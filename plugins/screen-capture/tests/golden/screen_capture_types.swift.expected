public enum DowngradeReason: UInt32, Sendable {
    case importRejected = 0
    case allocationFailed = 1
    case modifierUnreadable = 2
    case producerChanged = 3
    case poolChanged = 4
}

public struct Downgrade: Sendable {
    public let fromTier: UInt8
    public let toTier: UInt8
    public let reason: DowngradeReason

    public init(fromTier: UInt8, toTier: UInt8, reason: DowngradeReason) {
        self.fromTier = fromTier
        self.toTier = toTier
        self.reason = reason
    }
}

public enum PauseReason: UInt32, Sendable {
    case backgrounded = 0
    case secureDesktop = 1
    case systemPaused = 2
    case requested = 3
}

public struct ExhaustionReport: Sendable {
    public let episode: UInt32
    public let poolDepth: UInt8
    public let policy: Exhaustion

    public init(episode: UInt32, poolDepth: UInt8, policy: Exhaustion) {
        self.episode = episode
        self.poolDepth = poolDepth
        self.policy = policy
    }
}

public enum StopReason: UInt32, Sendable {
    case closed = 0
    case consentRevoked = 1
    case sourceLost = 2
    case failed = 3
    case shutdown = 4
}

public enum CaptureEvent: Sendable {
    case started(NegotiatedStream)
    case renegotiated(NegotiatedStream)
    case downgraded(Downgrade)
    case sourceResized(Size)
    case sourceHidden
    case sourceVisible
    case paused(PauseReason)
    case resumed
    case exhausted(ExhaustionReport)
    case consentRevoked
    case sourceLost
    case failed(CaptureError)
    case stopped(StopReason)
}

