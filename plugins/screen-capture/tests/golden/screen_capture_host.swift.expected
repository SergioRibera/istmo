/// Decodes wire calls, invokes `ScreenCaptureBackend`, encodes the response.
/// Register with `IstmoRuntime.shared.registerHandler(PLUGIN_ID, dispatcher)`.
public final class ScreenCaptureDispatcher: PluginHandler, HandleReleaser {
    public static let PLUGIN_ID: String = "istmo.screen_capture"

    private let backend: ScreenCaptureBackend
    private let codecs: ScreenCaptureCodecs

    public init(backend: ScreenCaptureBackend, codecs: ScreenCaptureCodecs) {
        self.backend = backend
        self.codecs = codecs
    }

    public func releaseNativeHandle(_ handleId: UInt64) {
        (backend as? HandleReleaser)?.releaseNativeHandle(handleId)
    }

    public func handleCall(instanceId: UInt64, method: String, payload: Data) async throws -> PluginResult {
        switch method {
        case "backends":
            let result = try await backend.backends()
            var out = Data()
            Bincode.writeVec(&out, result) { o1, v1 in codecs.writeBackendStatus(&o1, v1) }
            return .unary(out)
        case "capabilities":
            do {
                var c = Bincode.Cursor(payload)
                let query = try codecs.readCapabilityQuery(&c)
                let result = try await backend.capabilities(query: query)
                var out = Data()
                codecs.writeCapabilityReport(&out, result)
                return .unary(out)
            } catch let err as ScreenCapture.CaptureError {
                var errOut = Data()
                codecs.writeCaptureError(&errOut, err)
                throw PluginException(payload: errOut)
            }
