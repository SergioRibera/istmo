    public func readCaptureEvent(_ c: inout Bincode.Cursor) throws -> CaptureEvent {
        let disc = try Bincode.readVarintU32(&c)
        switch disc {
        case 0: return .started(try self.readNegotiatedStream(&c))
        case 1: return .renegotiated(try self.readNegotiatedStream(&c))
        case 2: return .downgraded(try self.readDowngrade(&c))
        case 3: return .sourceResized(try self.readSize(&c))
        case 4: return .sourceHidden
        case 5: return .sourceVisible
        case 6: return .paused(try self.readPauseReason(&c))
        case 7: return .resumed
        case 8: return .exhausted(try self.readExhaustionReport(&c))
        case 9: return .consentRevoked
        case 10: return .sourceLost
        case 11: return .failed(try self.readCaptureError(&c))
        case 12: return .stopped(try self.readStopReason(&c))
        default: throw Bincode.DecodeError.invalidTag(UInt8(clamping: disc))
        }
    }

    public func writeCaptureEvent(_ out: inout Data, _ value: CaptureEvent) {
        switch value {
        case .started(let payload):
            Bincode.writeVarintU32(&out, 0)
            self.writeNegotiatedStream(&out, payload)
        case .renegotiated(let payload):
            Bincode.writeVarintU32(&out, 1)
            self.writeNegotiatedStream(&out, payload)
        case .downgraded(let payload):
            Bincode.writeVarintU32(&out, 2)
            self.writeDowngrade(&out, payload)
        case .sourceResized(let payload):
            Bincode.writeVarintU32(&out, 3)
            self.writeSize(&out, payload)
        case .sourceHidden:
            Bincode.writeVarintU32(&out, 4)
        case .sourceVisible:
            Bincode.writeVarintU32(&out, 5)
        case .paused(let payload):
            Bincode.writeVarintU32(&out, 6)
            self.writePauseReason(&out, payload)
        case .resumed:
            Bincode.writeVarintU32(&out, 7)
        case .exhausted(let payload):
            Bincode.writeVarintU32(&out, 8)
            self.writeExhaustionReport(&out, payload)
        case .consentRevoked:
            Bincode.writeVarintU32(&out, 9)
        case .sourceLost:
            Bincode.writeVarintU32(&out, 10)
        case .failed(let payload):
            Bincode.writeVarintU32(&out, 11)
            self.writeCaptureError(&out, payload)
        case .stopped(let payload):
            Bincode.writeVarintU32(&out, 12)
            self.writeStopReason(&out, payload)
        }
    }

