    public func readDecisionRequest(_ c: inout Bincode.Cursor) throws -> WebView.DecisionRequest {
        let requestId = try Bincode.readVarintU64(&c)
        let kind = try self.readDecisionKind(&c)
        return WebView.DecisionRequest(requestId: requestId, kind: kind)
    }

    public func writeDecisionRequest(_ out: inout Data, _ value: WebView.DecisionRequest) {
        Bincode.writeVarintU64(&out, value.requestId)
        self.writeDecisionKind(&out, value.kind)
    }

    public func readDecisionKind(_ c: inout Bincode.Cursor) throws -> WebView.DecisionKind {
        let disc = try Bincode.readVarintU32(&c)
        switch disc {
        case 0: return .navigation(try self.readNavInfo(&c))
        case 1: return .newWindow(try self.readNewWindowAsk(&c))
        case 2: return .permission(try self.readPermissionAsk(&c))
        case 3: return .httpAuth(try self.readHttpAuthAsk(&c))
        case 4: return .tlsError(try self.readTlsErrorInfo(&c))
        case 5: return .fileChooser(try self.readFileChooserAsk(&c))
        case 6: return .dialog(try self.readDialogAsk(&c))
        case 7: return .download(try self.readDownloadAsk(&c))
        default: throw Bincode.DecodeError.invalidTag(UInt8(clamping: disc))
        }
    }

    public func writeDecisionKind(_ out: inout Data, _ value: WebView.DecisionKind) {
        switch value {
        case .navigation(let payload):
            Bincode.writeVarintU32(&out, 0)
            self.writeNavInfo(&out, payload)
        case .newWindow(let payload):
            Bincode.writeVarintU32(&out, 1)
            self.writeNewWindowAsk(&out, payload)
        case .permission(let payload):
            Bincode.writeVarintU32(&out, 2)
            self.writePermissionAsk(&out, payload)
        case .httpAuth(let payload):
            Bincode.writeVarintU32(&out, 3)
            self.writeHttpAuthAsk(&out, payload)
        case .tlsError(let payload):
            Bincode.writeVarintU32(&out, 4)
            self.writeTlsErrorInfo(&out, payload)
        case .fileChooser(let payload):
            Bincode.writeVarintU32(&out, 5)
            self.writeFileChooserAsk(&out, payload)
        case .dialog(let payload):
            Bincode.writeVarintU32(&out, 6)
            self.writeDialogAsk(&out, payload)
        case .download(let payload):
            Bincode.writeVarintU32(&out, 7)
            self.writeDownloadAsk(&out, payload)
        }
    }

    public func readNewWindowAsk(_ c: inout Bincode.Cursor) throws -> WebView.NewWindowAsk {
        let url = try Bincode.readString(&c)
        let userGesture = try Bincode.readBool(&c)
        return WebView.NewWindowAsk(url: url, userGesture: userGesture)
    }

    public func writeNewWindowAsk(_ out: inout Data, _ value: WebView.NewWindowAsk) {
        Bincode.writeString(&out, value.url)
        Bincode.writeBool(&out, value.userGesture)
    }

    public func readPermissionAsk(_ c: inout Bincode.Cursor) throws -> WebView.PermissionAsk {
        let permissions = try Bincode.readVec(&c) { c1 in try self.readWebPermission(&c1) }
        let frameOrigin = try Bincode.readString(&c)
        let topOrigin = try Bincode.readString(&c)
        return WebView.PermissionAsk(permissions: permissions, frameOrigin: frameOrigin, topOrigin: topOrigin)
    }

    public func writePermissionAsk(_ out: inout Data, _ value: WebView.PermissionAsk) {
        Bincode.writeVec(&out, value.permissions) { o1, v1 in self.writeWebPermission(&o1, v1) }
        Bincode.writeString(&out, value.frameOrigin)
        Bincode.writeString(&out, value.topOrigin)
    }

