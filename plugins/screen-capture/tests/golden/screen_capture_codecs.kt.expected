    override fun writeAudioConfig(out: ByteArrayOutputStream, value: AudioConfig) {
        writeAudioSource(out, value.source)
        Bincode.writeOption(out, value.rate) { s1, v1 -> Bincode.writeU32(s1, v1) }
        Bincode.writeOption(out, value.channels) { s1, v1 -> Bincode.writeU8(s1, v1) }
        writeSampleFormat(out, value.format)
    }

    override fun readAudioUpdate(bytes: ByteArray, offset: Int): Bincode.Decoded<AudioUpdate> {
