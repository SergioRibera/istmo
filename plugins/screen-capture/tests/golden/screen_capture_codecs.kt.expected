        val status = d_status.value
        val d_model = readConsentModel(bytes, cursor); cursor = d_model.consumed
        val model = d_model.value
        val d_persistence = readPersistence(bytes, cursor); cursor = d_persistence.consumed
        val persistence = d_persistence.value
        val d_revocableMidSession = Bincode.readBool(bytes, cursor); cursor = d_revocableMidSession.consumed
        val revocableMidSession = d_revocableMidSession.value
        val d_indicator = readIndicatorState(bytes, cursor); cursor = d_indicator.consumed
        val indicator = d_indicator.value
        return Bincode.Decoded(AccessState(scope = scope, status = status, model = model, persistence = persistence, revocableMidSession = revocableMidSession, indicator = indicator), cursor)
    }

    override fun writeAccessState(out: ByteArrayOutputStream, value: AccessState) {
        writeAccessScope(out, value.scope)
        writeAccessStatus(out, value.status)
        writeConsentModel(out, value.model)
        writePersistence(out, value.persistence)
        Bincode.writeBool(out, value.revocableMidSession)
