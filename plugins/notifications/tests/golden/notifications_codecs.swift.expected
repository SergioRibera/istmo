    public func readChronometer(_ c: inout Bincode.Cursor) throws -> Notifications.Chronometer {
        let baseMs = try Bincode.readVarintI64(&c)
        let countDown = try Bincode.readBool(&c)
        return Notifications.Chronometer(baseMs: baseMs, countDown: countDown)
    }

    public func writeChronometer(_ out: inout Data, _ value: Notifications.Chronometer) {
        Bincode.writeVarintI64(&out, value.baseMs)
        Bincode.writeBool(&out, value.countDown)
    }

    public func readMissedPolicy(_ c: inout Bincode.Cursor) throws -> Notifications.MissedPolicy {
        let disc = try Bincode.readVarintU32(&c)
        switch disc {
        case 0: return .drop
        case 1: return .deliverLate(try Bincode.readVarintU64(&c))
        default: throw Bincode.DecodeError.invalidTag(UInt8(clamping: disc))
        }
    }

    public func writeMissedPolicy(_ out: inout Data, _ value: Notifications.MissedPolicy) {
        switch value {
        case .drop:
            Bincode.writeVarintU32(&out, 0)
        case .deliverLate(let payload):
            Bincode.writeVarintU32(&out, 1)
            Bincode.writeVarintU64(&out, payload)
        }
    }

    public func readTrigger(_ c: inout Bincode.Cursor) throws -> Notifications.Trigger {
        let disc = try Bincode.readVarintU32(&c)
        switch disc {
        case 0: return .after(try Bincode.readVarintU64(&c))
        case 1: return .at(try Bincode.readVarintI64(&c))
        case 2: return .every(try Bincode.readVarintU64(&c))
        case 3: return .calendar(try self.readCalendarRule(&c))
        default: throw Bincode.DecodeError.invalidTag(UInt8(clamping: disc))
        }
    }

    public func writeTrigger(_ out: inout Data, _ value: Notifications.Trigger) {
        switch value {
        case .after(let payload):
            Bincode.writeVarintU32(&out, 0)
            Bincode.writeVarintU64(&out, payload)
        case .at(let payload):
            Bincode.writeVarintU32(&out, 1)
            Bincode.writeVarintI64(&out, payload)
        case .every(let payload):
            Bincode.writeVarintU32(&out, 2)
            Bincode.writeVarintU64(&out, payload)
        case .calendar(let payload):
            Bincode.writeVarintU32(&out, 3)
            self.writeCalendarRule(&out, payload)
        }
    }

    public func readCalendarRule(_ c: inout Bincode.Cursor) throws -> Notifications.CalendarRule {
        let hour = try Bincode.readU8(&c)
        let minute = try Bincode.readU8(&c)
        let weekdays = try Bincode.readVec(&c) { c1 in try self.readWeekday(&c1) }
        let dayOfMonth = try Bincode.readOption(&c) { c1 in try Bincode.readU8(&c1) }
        let month = try Bincode.readOption(&c) { c1 in try Bincode.readU8(&c1) }
        let timeZone = try Bincode.readOption(&c) { c1 in try Bincode.readString(&c1) }
        let untilMs = try Bincode.readOption(&c) { c1 in try Bincode.readVarintI64(&c1) }
        return Notifications.CalendarRule(hour: hour, minute: minute, weekdays: weekdays, dayOfMonth: dayOfMonth, month: month, timeZone: timeZone, untilMs: untilMs)
    }

    public func writeCalendarRule(_ out: inout Data, _ value: Notifications.CalendarRule) {
        Bincode.writeU8(&out, value.hour)
        Bincode.writeU8(&out, value.minute)
        Bincode.writeVec(&out, value.weekdays) { o1, v1 in self.writeWeekday(&o1, v1) }
        Bincode.writeOption(&out, value.dayOfMonth) { o1, v1 in Bincode.writeU8(&o1, v1) }
        Bincode.writeOption(&out, value.month) { o1, v1 in Bincode.writeU8(&o1, v1) }
        Bincode.writeOption(&out, value.timeZone) { o1, v1 in Bincode.writeString(&o1, v1) }
        Bincode.writeOption(&out, value.untilMs) { o1, v1 in Bincode.writeVarintI64(&o1, v1) }
    }

    public func readWeekday(_ c: inout Bincode.Cursor) throws -> Notifications.Weekday {
        let disc = try Bincode.readVarintU32(&c)
        guard let value = Notifications.Weekday(rawValue: disc) else {
            throw Bincode.DecodeError.invalidTag(UInt8(clamping: disc))
        }
        return value
    }

    public func writeWeekday(_ out: inout Data, _ value: Notifications.Weekday) {
        Bincode.writeVarintU32(&out, value.rawValue)
    }

    public func readNotificationPatch(_ c: inout Bincode.Cursor) throws -> Notifications.NotificationPatch {
        let title = try Bincode.readOption(&c) { c1 in try Bincode.readString(&c1) }
        let subtitle = try Bincode.readOption(&c) { c1 in try Bincode.readString(&c1) }
        let body = try Bincode.readOption(&c) { c1 in try Bincode.readString(&c1) }
        let style = try Bincode.readOption(&c) { c1 in try self.readStyle(&c1) }
        let icon = try Bincode.readOption(&c) { c1 in try self.readNotificationImage(&c1) }
        let actions = try Bincode.readOption(&c) { c1 in try Bincode.readVec(&c1) { c2 in try self.readAction(&c2) } }
        let progress = try Bincode.readOption(&c) { c1 in try self.readProgress(&c1) }
        let statusText = try Bincode.readOption(&c) { c1 in try Bincode.readString(&c1) }
        let count = try Bincode.readOption(&c) { c1 in try Bincode.readVarintU32(&c1) }
        let ongoing = try Bincode.readOption(&c) { c1 in try Bincode.readBool(&c1) }
        let url = try Bincode.readOption(&c) { c1 in try Bincode.readString(&c1) }
        let userData = try Bincode.readOption(&c) { c1 in try Bincode.readString(&c1) }
        let clear = try Bincode.readVec(&c) { c1 in try self.readPatchField(&c1) }
        let alertAgain = try Bincode.readBool(&c)
        return Notifications.NotificationPatch(title: title, subtitle: subtitle, body: body, style: style, icon: icon, actions: actions, progress: progress, statusText: statusText, count: count, ongoing: ongoing, url: url, userData: userData, clear: clear, alertAgain: alertAgain)
    }

    public func writeNotificationPatch(_ out: inout Data, _ value: Notifications.NotificationPatch) {
        Bincode.writeOption(&out, value.title) { o1, v1 in Bincode.writeString(&o1, v1) }
        Bincode.writeOption(&out, value.subtitle) { o1, v1 in Bincode.writeString(&o1, v1) }
        Bincode.writeOption(&out, value.body) { o1, v1 in Bincode.writeString(&o1, v1) }
        Bincode.writeOption(&out, value.style) { o1, v1 in self.writeStyle(&o1, v1) }
        Bincode.writeOption(&out, value.icon) { o1, v1 in self.writeNotificationImage(&o1, v1) }
        Bincode.writeOption(&out, value.actions) { o1, v1 in Bincode.writeVec(&o1, v1) { o2, v2 in self.writeAction(&o2, v2) } }
        Bincode.writeOption(&out, value.progress) { o1, v1 in self.writeProgress(&o1, v1) }
        Bincode.writeOption(&out, value.statusText) { o1, v1 in Bincode.writeString(&o1, v1) }
        Bincode.writeOption(&out, value.count) { o1, v1 in Bincode.writeVarintU32(&o1, v1) }
        Bincode.writeOption(&out, value.ongoing) { o1, v1 in Bincode.writeBool(&o1, v1) }
        Bincode.writeOption(&out, value.url) { o1, v1 in Bincode.writeString(&o1, v1) }
        Bincode.writeOption(&out, value.userData) { o1, v1 in Bincode.writeString(&o1, v1) }
        Bincode.writeVec(&out, value.clear) { o1, v1 in self.writePatchField(&o1, v1) }
        Bincode.writeBool(&out, value.alertAgain)
    }

    public func readPatchField(_ c: inout Bincode.Cursor) throws -> Notifications.PatchField {
