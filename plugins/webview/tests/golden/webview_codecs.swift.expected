        let disc = try Bincode.readVarintU32(&c)
        switch disc {
        case 0: return .png
        case 1: return .jpeg(try Bincode.readU8(&c))
        default: throw Bincode.DecodeError.invalidTag(UInt8(clamping: disc))
        }
    }

    public func writeSnapshotFormat(_ out: inout Data, _ value: WebView.SnapshotFormat) {
