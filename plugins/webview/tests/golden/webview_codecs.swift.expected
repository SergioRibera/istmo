        let result = try self.readReplyResult(&c)
        return WebView.BridgeReply(replyId: replyId, result: result)
    }

    public func writeBridgeReply(_ out: inout Data, _ value: WebView.BridgeReply) {
        Bincode.writeVarintU64(&out, value.replyId)
