    }

    override fun readInterruption(bytes: ByteArray, offset: Int): Bincode.Decoded<Interruption> {
        val d = Bincode.readEnumDiscriminant(bytes, offset)
        val variant = Interruption.entries.getOrNull(d.value)
            ?: throw Bincode.DecodeException("Interruption: unknown discriminant ${d.value}")
        return Bincode.Decoded(variant, d.consumed)
    }

    override fun writeInterruption(out: ByteArrayOutputStream, value: Interruption) {
