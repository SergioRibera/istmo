                let audio = IstmoFrameSender<AudioMeta>.open(sinkId: try Bincode.readVarintU64(&c), fingerprint: 0x5ea3f68f61510434, encode: { [codecs = codecs] v1 in var o1 = Data(); codecs.writeAudioMeta(&o1, v1); return o1 })
                let result = try await backend.open_with_audio(config: config_, video: video, audio: audio)
                var out = Data()
                codecs.writeCaptureSession(&out, result)
                return .unary(out)
            } catch let err as CaptureError {
                var errOut = Data()
                codecs.writeCaptureError(&errOut, err)
                throw PluginException(payload: errOut)
            }
        case "open_preview":
            do {
                var c = Bincode.Cursor(payload)
                let config_ = try codecs.readSessionConfig(&c)
                let target = try codecs.readPreviewTarget(&c)
                let result = try await backend.open_preview(config: config_, target: target)
                var out = Data()
                codecs.writeCaptureSession(&out, result)
                return .unary(out)
            } catch let err as CaptureError {
                var errOut = Data()
                codecs.writeCaptureError(&errOut, err)
                throw PluginException(payload: errOut)
            }
        case "open_preview_with_frames":
            do {
                var c = Bincode.Cursor(payload)
                let config_ = try codecs.readSessionConfig(&c)
                let target = try codecs.readPreviewTarget(&c)
                let video = IstmoFrameSender<FrameMeta>.open(sinkId: try Bincode.readVarintU64(&c), fingerprint: 0x43359369b748c21b, encode: { [codecs = codecs] v1 in var o1 = Data(); codecs.writeFrameMeta(&o1, v1); return o1 })
                let result = try await backend.open_preview_with_frames(config: config_, target: target, video: video)
                var out = Data()
                codecs.writeCaptureSession(&out, result)
                return .unary(out)
            } catch let err as CaptureError {
                var errOut = Data()
                codecs.writeCaptureError(&errOut, err)
                throw PluginException(payload: errOut)
            }
        case "update":
            do {
                var c = Bincode.Cursor(payload)
                let session = try codecs.readNativeHandleId(&c)
                let update = try codecs.readSessionUpdate(&c)
                let result = try await backend.update(session: session, update: update)
                var out = Data()
                codecs.writeNegotiatedStream(&out, result)
                return .unary(out)
            } catch let err as CaptureError {
                var errOut = Data()
                codecs.writeCaptureError(&errOut, err)
                throw PluginException(payload: errOut)
            }
        case "close":
            do {
                var c = Bincode.Cursor(payload)
                let session = try codecs.readNativeHandleId(&c)
                try await backend.close(session: session)
                return .unary(Data())
            } catch let err as CaptureError {
                var errOut = Data()
                codecs.writeCaptureError(&errOut, err)
                throw PluginException(payload: errOut)
            }
        case "events":
            var c = Bincode.Cursor(payload)
            let session = try codecs.readNativeHandleId(&c)
            let codecs = self.codecs
            return PluginResult.encoding(backend.events(session: session), encode: { item in
                var out = Data()
                codecs.writeCaptureEvent(&out, item)
                return out
            }, mapError: { error in
                guard let err = error as? CaptureError else { return error }
                var errOut = Data()
                codecs.writeCaptureError(&errOut, err)
                return PluginException(payload: errOut)
            })
        default:
            throw PluginRuntimeError.unknownMethod(plugin: "ScreenCapture", method: method)
        }
    }
}
