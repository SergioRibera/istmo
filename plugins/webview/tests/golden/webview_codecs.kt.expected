        Bincode.writeVec(out, value.rules) { s1, v1 -> writeNavigationRule(s1, v1) }
    }

    override fun readNavigationRule(bytes: ByteArray, offset: Int): Bincode.Decoded<NavigationRule> {
        var cursor = offset
        val d_pattern = readUrlPattern(bytes, cursor); cursor = d_pattern.consumed
        val pattern = d_pattern.value
        val d_action = readRuleAction(bytes, cursor); cursor = d_action.consumed
        val action = d_action.value
        return Bincode.Decoded(NavigationRule(pattern = pattern, action = action), cursor)
    }

