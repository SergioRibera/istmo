        val port = d_port.value
        val d_pathPrefix = Bincode.readString(bytes, cursor); cursor = d_pathPrefix.consumed
        val pathPrefix = d_pathPrefix.value
        return Bincode.Decoded(UrlPattern(scheme = scheme, host = host, port = port, pathPrefix = pathPrefix), cursor)
