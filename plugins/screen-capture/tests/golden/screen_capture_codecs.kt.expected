    override fun readIndicatorState(bytes: ByteArray, offset: Int): Bincode.Decoded<IndicatorState> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> Bincode.Decoded(IndicatorState.Shown, cursor)
            1 -> {
                val d_inner = Bincode.readString(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(IndicatorState.Hidden(inner) as IndicatorState, cursor)
            }
            2 -> Bincode.Decoded(IndicatorState.NotApplicable, cursor)
            else -> throw Bincode.DecodeException("IndicatorState: unknown discriminant ${disc.value}")
        }
    }

    override fun writeIndicatorState(out: ByteArrayOutputStream, value: IndicatorState) {
        when (value) {
            IndicatorState.Shown -> Bincode.writeEnumDiscriminant(out, 0)
            is IndicatorState.Hidden -> {
                Bincode.writeEnumDiscriminant(out, 1)
                Bincode.writeString(out, value.value)
            }
            IndicatorState.NotApplicable -> Bincode.writeEnumDiscriminant(out, 2)
        }
    }

