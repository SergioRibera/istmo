    }

    public func readClearDataRequest(_ c: inout Bincode.Cursor) throws -> WebView.ClearDataRequest {
        let kinds = try Bincode.readVec(&c) { c1 in try self.readDataKind(&c1) }
        let sinceUnixMs = try Bincode.readOption(&c) { c1 in try Bincode.readVarintI64(&c1) }
        return WebView.ClearDataRequest(kinds: kinds, sinceUnixMs: sinceUnixMs)
