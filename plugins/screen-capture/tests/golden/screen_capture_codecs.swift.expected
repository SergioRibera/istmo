    public func readAudioMeta(_ c: inout Bincode.Cursor) throws -> ScreenCapture.AudioMeta {
        let seq = try Bincode.readVarintU64(&c)
        let ptsNs = try Bincode.readVarintU64(&c)
        let wallUs = try Bincode.readVarintU64(&c)
        let rate = try Bincode.readVarintU32(&c)
        let channels = try Bincode.readU8(&c)
        let format = try self.readSampleFormat(&c)
