                    backend.scheme_head(view, head)
                    PluginResult.Unary(ByteArray(0))
                } catch (e: BackendException) {
                    val err = e.error as? WebViewError ?: throw e
                    val errOut = ByteArrayOutputStream()
                    codecs.writeWebViewError(errOut, err)
                    throw PluginException(errOut.toByteArray())
                }
            }
            "scheme_chunk" -> {
                try {
                    var cursor = 0
                    val d_view = codecs.readViewRef(payload, cursor); cursor = d_view.consumed
                    val view = d_view.value
                    val chunk = codecs.readSchemeChunk(payload, cursor).value
                    backend.scheme_chunk(view, chunk)
                    PluginResult.Unary(ByteArray(0))
                } catch (e: BackendException) {
                    val err = e.error as? WebViewError ?: throw e
                    val errOut = ByteArrayOutputStream()
                    codecs.writeWebViewError(errOut, err)
                    throw PluginException(errOut.toByteArray())
                }
            }
            "scheme_request_body" -> {
                var cursor = 0
                val d_view = codecs.readViewRef(payload, cursor); cursor = d_view.consumed
                val view = d_view.value
                val request_id = Bincode.readU64(payload, cursor).value
                val __istmo_flow = backend.scheme_request_body(view, request_id)
                PluginResult.Stream(
                    __istmo_flow.map { __istmo_item ->
                        val out = ByteArrayOutputStream()
                        Bincode.writeBytes(out, __istmo_item)
                        out.toByteArray()
                    }.catch { e ->
                        val err = (e as? BackendException)?.error as? WebViewError ?: throw e
                        val errOut = ByteArrayOutputStream()
                        codecs.writeWebViewError(errOut, err)
                        throw PluginException(errOut.toByteArray())
                    }
                )
            }
            "cookies" -> {
                try {
                    var cursor = 0
                    val d_view = codecs.readViewRef(payload, cursor); cursor = d_view.consumed
                    val view = d_view.value
                    val filter = codecs.readCookieFilter(payload, cursor).value
                    val result = backend.cookies(view, filter)
                    val out = ByteArrayOutputStream()
                    Bincode.writeVec(out, result) { s1, v1 -> codecs.writeWebCookie(s1, v1) }
                    PluginResult.Unary(out.toByteArray())
                } catch (e: BackendException) {
                    val err = e.error as? WebViewError ?: throw e
                    val errOut = ByteArrayOutputStream()
                    codecs.writeWebViewError(errOut, err)
                    throw PluginException(errOut.toByteArray())
                }
            }
            "set_cookie" -> {
                try {
                    var cursor = 0
                    val d_view = codecs.readViewRef(payload, cursor); cursor = d_view.consumed
                    val view = d_view.value
                    val cookie = codecs.readWebCookie(payload, cursor).value
                    backend.set_cookie(view, cookie)
                    PluginResult.Unary(ByteArray(0))
                } catch (e: BackendException) {
                    val err = e.error as? WebViewError ?: throw e
                    val errOut = ByteArrayOutputStream()
                    codecs.writeWebViewError(errOut, err)
                    throw PluginException(errOut.toByteArray())
                }
            }
            "clear_data" -> {
                try {
                    var cursor = 0
                    val d_view = codecs.readViewRef(payload, cursor); cursor = d_view.consumed
                    val view = d_view.value
                    val request = codecs.readClearDataRequest(payload, cursor).value
                    backend.clear_data(view, request)
                    PluginResult.Unary(ByteArray(0))
                } catch (e: BackendException) {
                    val err = e.error as? WebViewError ?: throw e
                    val errOut = ByteArrayOutputStream()
                    codecs.writeWebViewError(errOut, err)
                    throw PluginException(errOut.toByteArray())
                }
            }
            "set_zoom" -> {
                try {
                    var cursor = 0
                    val d_view = codecs.readViewRef(payload, cursor); cursor = d_view.consumed
                    val view = d_view.value
                    val factor = Bincode.readF32(payload, cursor).value
                    backend.set_zoom(view, factor)
                    PluginResult.Unary(ByteArray(0))
                } catch (e: BackendException) {
                    val err = e.error as? WebViewError ?: throw e
                    val errOut = ByteArrayOutputStream()
                    codecs.writeWebViewError(errOut, err)
                    throw PluginException(errOut.toByteArray())
                }
            }
            "find" -> {
                try {
                    var cursor = 0
                    val d_view = codecs.readViewRef(payload, cursor); cursor = d_view.consumed
                    val view = d_view.value
                    val query = codecs.readFindQuery(payload, cursor).value
                    val result = backend.find(view, query)
                    val out = ByteArrayOutputStream()
                    codecs.writeFindResult(out, result)
                    PluginResult.Unary(out.toByteArray())
                } catch (e: BackendException) {
                    val err = e.error as? WebViewError ?: throw e
                    val errOut = ByteArrayOutputStream()
                    codecs.writeWebViewError(errOut, err)
                    throw PluginException(errOut.toByteArray())
                }
            }
            "snapshot" -> {
                try {
                    var cursor = 0
                    val d_view = codecs.readViewRef(payload, cursor); cursor = d_view.consumed
                    val view = d_view.value
                    val options = codecs.readSnapshotOptions(payload, cursor).value
                    val result = backend.snapshot(view, options)
                    val out = ByteArrayOutputStream()
                    codecs.writeWebSnapshot(out, result)
                    PluginResult.Unary(out.toByteArray())
                } catch (e: BackendException) {
                    val err = e.error as? WebViewError ?: throw e
                    val errOut = ByteArrayOutputStream()
                    codecs.writeWebViewError(errOut, err)
                    throw PluginException(errOut.toByteArray())
                }
            }
            "print" -> {
                try {
                    val view = codecs.readViewRef(payload, 0).value
                    backend.print(view)
                    PluginResult.Unary(ByteArray(0))
                } catch (e: BackendException) {
                    val err = e.error as? WebViewError ?: throw e
                    val errOut = ByteArrayOutputStream()
                    codecs.writeWebViewError(errOut, err)
                    throw PluginException(errOut.toByteArray())
                }
            }
            "set_inspector" -> {
                try {
                    var cursor = 0
                    val d_view = codecs.readViewRef(payload, cursor); cursor = d_view.consumed
                    val view = d_view.value
                    val open = Bincode.readBool(payload, cursor).value
                    backend.set_inspector(view, open)
                    PluginResult.Unary(ByteArray(0))
                } catch (e: BackendException) {
                    val err = e.error as? WebViewError ?: throw e
                    val errOut = ByteArrayOutputStream()
                    codecs.writeWebViewError(errOut, err)
                    throw PluginException(errOut.toByteArray())
                }
            }
            "download_control" -> {
                try {
                    var cursor = 0
                    val d_view = codecs.readViewRef(payload, cursor); cursor = d_view.consumed
                    val view = d_view.value
                    val op = codecs.readDownloadOp(payload, cursor).value
                    backend.download_control(view, op)
                    PluginResult.Unary(ByteArray(0))
                } catch (e: BackendException) {
                    val err = e.error as? WebViewError ?: throw e
                    val errOut = ByteArrayOutputStream()
                    codecs.writeWebViewError(errOut, err)
                    throw PluginException(errOut.toByteArray())
                }
            }
            "control_events" -> {
                val view = codecs.readViewRef(payload, 0).value
                val __istmo_flow = backend.control_events(view)
                PluginResult.Stream(
                    __istmo_flow.map { __istmo_item ->
                        val out = ByteArrayOutputStream()
                        codecs.writeControlEvent(out, __istmo_item)
                        out.toByteArray()
                    }.catch { e ->
                        val err = (e as? BackendException)?.error as? WebViewError ?: throw e
                        val errOut = ByteArrayOutputStream()
                        codecs.writeWebViewError(errOut, err)
                        throw PluginException(errOut.toByteArray())
                    }
                )
            }
            "telemetry" -> {
                var cursor = 0
                val d_view = codecs.readViewRef(payload, cursor); cursor = d_view.consumed
                val view = d_view.value
                val kinds = Bincode.readVec(payload, cursor) { b1, c1 -> codecs.readTelemetryKind(b1, c1) }.value
                val __istmo_flow = backend.telemetry(view, kinds)
                PluginResult.Stream(
                    __istmo_flow.map { __istmo_item ->
                        val out = ByteArrayOutputStream()
                        codecs.writeTelemetryEvent(out, __istmo_item)
                        out.toByteArray()
                    }.catch { e ->
                        val err = (e as? BackendException)?.error as? WebViewError ?: throw e
                        val errOut = ByteArrayOutputStream()
                        codecs.writeWebViewError(errOut, err)
                        throw PluginException(errOut.toByteArray())
                    }
                )
            }
            else -> error("unknown WebView method: $method")
        }
    }
}
