        return Bincode.Decoded(Rect(x = x, y = y, width = width, height = height), cursor)
    }

    override fun writeRect(out: ByteArrayOutputStream, value: Rect) {
        Bincode.writeI32(out, value.x)
        Bincode.writeI32(out, value.y)
        Bincode.writeU32(out, value.width)
        Bincode.writeU32(out, value.height)
    }

    override fun readRotation(bytes: ByteArray, offset: Int): Bincode.Decoded<Rotation> {
        val d = Bincode.readEnumDiscriminant(bytes, offset)
        val variant = Rotation.entries.getOrNull(d.value)
            ?: throw Bincode.DecodeException("Rotation: unknown discriminant ${d.value}")
        return Bincode.Decoded(variant, d.consumed)
    }

    override fun writeRotation(out: ByteArrayOutputStream, value: Rotation) {
        Bincode.writeEnumDiscriminant(out, value.ordinal)
    }

    override fun readOrientation(bytes: ByteArray, offset: Int): Bincode.Decoded<Orientation> {
        var cursor = offset
        val d_mirrored = Bincode.readBool(bytes, cursor); cursor = d_mirrored.consumed
        val mirrored = d_mirrored.value
        val d_rotation = readRotation(bytes, cursor); cursor = d_rotation.consumed
        val rotation = d_rotation.value
        return Bincode.Decoded(Orientation(mirrored = mirrored, rotation = rotation), cursor)
    }

    override fun writeOrientation(out: ByteArrayOutputStream, value: Orientation) {
        Bincode.writeBool(out, value.mirrored)
        writeRotation(out, value.rotation)
    }

    override fun readSourceFlags(bytes: ByteArray, offset: Int): Bincode.Decoded<SourceFlags> {
        var cursor = offset
        val d_primary = Bincode.readBool(bytes, cursor); cursor = d_primary.consumed
        val primary = d_primary.value
        val d_minimised = Bincode.readBool(bytes, cursor); cursor = d_minimised.consumed
        val minimised = d_minimised.value
        val d_occluded = Bincode.readBool(bytes, cursor); cursor = d_occluded.consumed
        val occluded = d_occluded.value
        val d_protected = Bincode.readBool(bytes, cursor); cursor = d_protected.consumed
        val protected = d_protected.value
        val d_ownProcess = Bincode.readBool(bytes, cursor); cursor = d_ownProcess.consumed
        val ownProcess = d_ownProcess.value
        return Bincode.Decoded(SourceFlags(primary = primary, minimised = minimised, occluded = occluded, protected = protected, ownProcess = ownProcess), cursor)
    }

    override fun writeSourceFlags(out: ByteArrayOutputStream, value: SourceFlags) {
        Bincode.writeBool(out, value.primary)
        Bincode.writeBool(out, value.minimised)
        Bincode.writeBool(out, value.occluded)
        Bincode.writeBool(out, value.protected)
        Bincode.writeBool(out, value.ownProcess)
    }

    override fun readSourceCapture(bytes: ByteArray, offset: Int): Bincode.Decoded<SourceCapture> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> Bincode.Decoded(SourceCapture.ById, cursor)
            1 -> {
                val d_inner = Bincode.readVec(bytes, cursor) { b1, c1 -> readBackendId(b1, c1) }; cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(SourceCapture.PickerOnly(inner) as SourceCapture, cursor)
            }
            else -> throw Bincode.DecodeException("SourceCapture: unknown discriminant ${disc.value}")
        }
    }

    override fun writeSourceCapture(out: ByteArrayOutputStream, value: SourceCapture) {
        when (value) {
            SourceCapture.ById -> Bincode.writeEnumDiscriminant(out, 0)
            is SourceCapture.PickerOnly -> {
                Bincode.writeEnumDiscriminant(out, 1)
                Bincode.writeVec(out, value.value) { s1, v1 -> writeBackendId(s1, v1) }
            }
        }
    }

    override fun readSource(bytes: ByteArray, offset: Int): Bincode.Decoded<Source> {
        var cursor = offset
        val d_id = readSourceId(bytes, cursor); cursor = d_id.consumed
        val id = d_id.value
        val d_kind = readSourceKind(bytes, cursor); cursor = d_kind.consumed
        val kind = d_kind.value
        val d_name = Bincode.readString(bytes, cursor); cursor = d_name.consumed
        val name = d_name.value
        val d_appId = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_appId.consumed
        val appId = d_appId.value
        val d_pid = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readU32(b1, c1) }; cursor = d_pid.consumed
        val pid = d_pid.value
        val d_geometry = Bincode.readOption(bytes, cursor) { b1, c1 -> readRect(b1, c1) }; cursor = d_geometry.consumed
        val geometry = d_geometry.value
        val d_physicalSize = Bincode.readOption(bytes, cursor) { b1, c1 -> readSize(b1, c1) }; cursor = d_physicalSize.consumed
        val physicalSize = d_physicalSize.value
        val d_scalePermille = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readU32(b1, c1) }; cursor = d_scalePermille.consumed
        val scalePermille = d_scalePermille.value
        val d_refreshMhz = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readU32(b1, c1) }; cursor = d_refreshMhz.consumed
        val refreshMhz = d_refreshMhz.value
        val d_orientation = readOrientation(bytes, cursor); cursor = d_orientation.consumed
        val orientation = d_orientation.value
        val d_flags = readSourceFlags(bytes, cursor); cursor = d_flags.consumed
        val flags = d_flags.value
        val d_make = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_make.consumed
        val make = d_make.value
        val d_model = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_model.consumed
        val model = d_model.value
        val d_connector = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_connector.consumed
        val connector = d_connector.value
        val d_description = Bincode.readOption(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_description.consumed
        val description = d_description.value
        val d_capture = readSourceCapture(bytes, cursor); cursor = d_capture.consumed
        val capture = d_capture.value
        return Bincode.Decoded(Source(id = id, kind = kind, name = name, appId = appId, pid = pid, geometry = geometry, physicalSize = physicalSize, scalePermille = scalePermille, refreshMhz = refreshMhz, orientation = orientation, flags = flags, make = make, model = model, connector = connector, description = description, capture = capture), cursor)
    }

    override fun writeSource(out: ByteArrayOutputStream, value: Source) {
        writeSourceId(out, value.id)
        writeSourceKind(out, value.kind)
        Bincode.writeString(out, value.name)
        Bincode.writeOption(out, value.appId) { s1, v1 -> Bincode.writeString(s1, v1) }
        Bincode.writeOption(out, value.pid) { s1, v1 -> Bincode.writeU32(s1, v1) }
        Bincode.writeOption(out, value.geometry) { s1, v1 -> writeRect(s1, v1) }
        Bincode.writeOption(out, value.physicalSize) { s1, v1 -> writeSize(s1, v1) }
        Bincode.writeOption(out, value.scalePermille) { s1, v1 -> Bincode.writeU32(s1, v1) }
        Bincode.writeOption(out, value.refreshMhz) { s1, v1 -> Bincode.writeU32(s1, v1) }
        writeOrientation(out, value.orientation)
        writeSourceFlags(out, value.flags)
        Bincode.writeOption(out, value.make) { s1, v1 -> Bincode.writeString(s1, v1) }
        Bincode.writeOption(out, value.model) { s1, v1 -> Bincode.writeString(s1, v1) }
        Bincode.writeOption(out, value.connector) { s1, v1 -> Bincode.writeString(s1, v1) }
        Bincode.writeOption(out, value.description) { s1, v1 -> Bincode.writeString(s1, v1) }
        writeSourceCapture(out, value.capture)
    }

    override fun readRegionSpace(bytes: ByteArray, offset: Int): Bincode.Decoded<RegionSpace> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> Bincode.Decoded(RegionSpace.Global, cursor)
            1 -> {
                val d_inner = readSourceId(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(RegionSpace.MonitorRelative(inner) as RegionSpace, cursor)
            }
            else -> throw Bincode.DecodeException("RegionSpace: unknown discriminant ${disc.value}")
        }
    }

    override fun writeRegionSpace(out: ByteArrayOutputStream, value: RegionSpace) {
        when (value) {
            RegionSpace.Global -> Bincode.writeEnumDiscriminant(out, 0)
            is RegionSpace.MonitorRelative -> {
                Bincode.writeEnumDiscriminant(out, 1)
                writeSourceId(out, value.value)
            }
        }
    }

    override fun readRegionSelector(bytes: ByteArray, offset: Int): Bincode.Decoded<RegionSelector> {
        var cursor = offset
        val d_rect = readRect(bytes, cursor); cursor = d_rect.consumed
        val rect = d_rect.value
        val d_space = readRegionSpace(bytes, cursor); cursor = d_space.consumed
        val space = d_space.value
        return Bincode.Decoded(RegionSelector(rect = rect, space = space), cursor)
    }

    override fun writeRegionSelector(out: ByteArrayOutputStream, value: RegionSelector) {
        writeRect(out, value.rect)
        writeRegionSpace(out, value.space)
    }

    override fun readPickerOptions(bytes: ByteArray, offset: Int): Bincode.Decoded<PickerOptions> {
        var cursor = offset
        val d_kinds = Bincode.readVec(bytes, cursor) { b1, c1 -> readSourceKind(b1, c1) }; cursor = d_kinds.consumed
        val kinds = d_kinds.value
        val d_multiple = Bincode.readBool(bytes, cursor); cursor = d_multiple.consumed
        val multiple = d_multiple.value
        return Bincode.Decoded(PickerOptions(kinds = kinds, multiple = multiple), cursor)
    }

    override fun writePickerOptions(out: ByteArrayOutputStream, value: PickerOptions) {
        Bincode.writeVec(out, value.kinds) { s1, v1 -> writeSourceKind(s1, v1) }
        Bincode.writeBool(out, value.multiple)
    }

    override fun readSourceSelector(bytes: ByteArray, offset: Int): Bincode.Decoded<SourceSelector> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> {
                val d_inner = readSourceId(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(SourceSelector.Id(inner) as SourceSelector, cursor)
            }
            1 -> {
                val d_inner = readRegionSelector(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(SourceSelector.Region(inner) as SourceSelector, cursor)
            }
            2 -> {
                val d_inner = readPickerOptions(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(SourceSelector.Picker(inner) as SourceSelector, cursor)
            }
            3 -> Bincode.Decoded(SourceSelector.PrimaryMonitor, cursor)
            4 -> Bincode.Decoded(SourceSelector.AllMonitors, cursor)
            5 -> {
                val d_inner = Bincode.readVec(bytes, cursor) { b1, c1 -> readSourceId(b1, c1) }; cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(SourceSelector.Monitors(inner) as SourceSelector, cursor)
            }
            6 -> Bincode.Decoded(SourceSelector.Focused, cursor)
            7 -> Bincode.Decoded(SourceSelector.UnderCursor, cursor)
            else -> throw Bincode.DecodeException("SourceSelector: unknown discriminant ${disc.value}")
        }
    }

    override fun writeSourceSelector(out: ByteArrayOutputStream, value: SourceSelector) {
        when (value) {
            is SourceSelector.Id -> {
                Bincode.writeEnumDiscriminant(out, 0)
                writeSourceId(out, value.value)
            }
            is SourceSelector.Region -> {
                Bincode.writeEnumDiscriminant(out, 1)
                writeRegionSelector(out, value.value)
            }
            is SourceSelector.Picker -> {
                Bincode.writeEnumDiscriminant(out, 2)
                writePickerOptions(out, value.value)
            }
            SourceSelector.PrimaryMonitor -> Bincode.writeEnumDiscriminant(out, 3)
            SourceSelector.AllMonitors -> Bincode.writeEnumDiscriminant(out, 4)
            is SourceSelector.Monitors -> {
                Bincode.writeEnumDiscriminant(out, 5)
                Bincode.writeVec(out, value.value) { s1, v1 -> writeSourceId(s1, v1) }
            }
            SourceSelector.Focused -> Bincode.writeEnumDiscriminant(out, 6)
            SourceSelector.UnderCursor -> Bincode.writeEnumDiscriminant(out, 7)
        }
    }

    override fun readSourceListing(bytes: ByteArray, offset: Int): Bincode.Decoded<SourceListing> {
        val d = Bincode.readEnumDiscriminant(bytes, offset)
        val variant = SourceListing.entries.getOrNull(d.value)
            ?: throw Bincode.DecodeException("SourceListing: unknown discriminant ${d.value}")
        return Bincode.Decoded(variant, d.consumed)
    }

    override fun writeSourceListing(out: ByteArrayOutputStream, value: SourceListing) {
        Bincode.writeEnumDiscriminant(out, value.ordinal)
    }

    override fun readSourceList(bytes: ByteArray, offset: Int): Bincode.Decoded<SourceList> {
        var cursor = offset
        val d_sources = Bincode.readVec(bytes, cursor) { b1, c1 -> readSource(b1, c1) }; cursor = d_sources.consumed
        val sources = d_sources.value
        val d_listing = readSourceListing(bytes, cursor); cursor = d_listing.consumed
        val listing = d_listing.value
        return Bincode.Decoded(SourceList(sources = sources, listing = listing), cursor)
    }

    override fun writeSourceList(out: ByteArrayOutputStream, value: SourceList) {
        Bincode.writeVec(out, value.sources) { s1, v1 -> writeSource(s1, v1) }
        writeSourceListing(out, value.listing)
    }

    override fun readSourceChange(bytes: ByteArray, offset: Int): Bincode.Decoded<SourceChange> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> {
                val d_inner = readSourceList(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(SourceChange.Listed(inner) as SourceChange, cursor)
            }
            1 -> {
                val d_inner = readSource(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(SourceChange.Added(inner) as SourceChange, cursor)
            }
            2 -> {
                val d_inner = readSource(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(SourceChange.Changed(inner) as SourceChange, cursor)
            }
            3 -> {
                val d_inner = readSourceId(bytes, cursor); cursor = d_inner.consumed
                val inner = d_inner.value
                Bincode.Decoded(SourceChange.Removed(inner) as SourceChange, cursor)
            }
            else -> throw Bincode.DecodeException("SourceChange: unknown discriminant ${disc.value}")
        }
    }

    override fun writeSourceChange(out: ByteArrayOutputStream, value: SourceChange) {
        when (value) {
            is SourceChange.Listed -> {
                Bincode.writeEnumDiscriminant(out, 0)
                writeSourceList(out, value.value)
            }
            is SourceChange.Added -> {
                Bincode.writeEnumDiscriminant(out, 1)
                writeSource(out, value.value)
            }
            is SourceChange.Changed -> {
                Bincode.writeEnumDiscriminant(out, 2)
                writeSource(out, value.value)
            }
            is SourceChange.Removed -> {
                Bincode.writeEnumDiscriminant(out, 3)
                writeSourceId(out, value.value)
            }
        }
    }

    override fun readSourceFilter(bytes: ByteArray, offset: Int): Bincode.Decoded<SourceFilter> {
        var cursor = offset
        val d_kinds = Bincode.readVec(bytes, cursor) { b1, c1 -> readSourceKind(b1, c1) }; cursor = d_kinds.consumed
        val kinds = d_kinds.value
        val d_backend = Bincode.readOption(bytes, cursor) { b1, c1 -> readBackendId(b1, c1) }; cursor = d_backend.consumed
        val backend = d_backend.value
        return Bincode.Decoded(SourceFilter(kinds = kinds, backend = backend), cursor)
    }

    override fun writeSourceFilter(out: ByteArrayOutputStream, value: SourceFilter) {
        Bincode.writeVec(out, value.kinds) { s1, v1 -> writeSourceKind(s1, v1) }
        Bincode.writeOption(out, value.backend) { s1, v1 -> writeBackendId(s1, v1) }
    }

    override fun readAccessStatus(bytes: ByteArray, offset: Int): Bincode.Decoded<AccessStatus> {
        var cursor = offset
        val disc = Bincode.readEnumDiscriminant(bytes, cursor)
        cursor = disc.consumed
        return when (disc.value) {
            0 -> Bincode.Decoded(AccessStatus.Granted, cursor)
            1 -> Bincode.Decoded(AccessStatus.Denied, cursor)
            2 -> Bincode.Decoded(AccessStatus.NotDetermined, cursor)
            3 -> Bincode.Decoded(AccessStatus.Restricted, cursor)
            4 -> Bincode.Decoded(AccessStatus.RequiresRestart, cursor)
            5 -> Bincode.Decoded(AccessStatus.PerSession, cursor)
            6 -> Bincode.Decoded(AccessStatus.NotApplicable, cursor)
            else -> Bincode.Decoded(AccessStatus.Unknown(disc.value, bytes.copyOfRange(cursor, bytes.size)) as AccessStatus, bytes.size)
        }
    }

    override fun writeAccessStatus(out: ByteArrayOutputStream, value: AccessStatus) {
        when (value) {
            AccessStatus.Granted -> Bincode.writeEnumDiscriminant(out, 0)
            AccessStatus.Denied -> Bincode.writeEnumDiscriminant(out, 1)
            AccessStatus.NotDetermined -> Bincode.writeEnumDiscriminant(out, 2)
            AccessStatus.Restricted -> Bincode.writeEnumDiscriminant(out, 3)
            AccessStatus.RequiresRestart -> Bincode.writeEnumDiscriminant(out, 4)
            AccessStatus.PerSession -> Bincode.writeEnumDiscriminant(out, 5)
            AccessStatus.NotApplicable -> Bincode.writeEnumDiscriminant(out, 6)
            is AccessStatus.Unknown -> {
                Bincode.writeEnumDiscriminant(out, value.discriminant)
                out.write(value.payload, 0, value.payload.size)
            }
        }
    }

    override fun readNativeHandleId(bytes: ByteArray, offset: Int): Bincode.Decoded<NativeHandleId> {
        return Bincode.readVarintU64(bytes, offset)
    }

    override fun writeNativeHandleId(out: ByteArrayOutputStream, value: NativeHandleId) {
        Bincode.writeU64(out, value.toULong())
    }
}
