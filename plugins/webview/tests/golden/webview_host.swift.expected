                var c = Bincode.Cursor(payload)
                let view = try codecs.readViewRef(&c)
                let request = try codecs.readClearDataRequest(&c)
                try await backend.clear_data(view: view, request: request)
                return .unary(Data())
            } catch let err as WebViewError {
                var errOut = Data()
                codecs.writeWebViewError(&errOut, err)
                throw PluginException(payload: errOut)
            }
        case "set_zoom":
            do {
                var c = Bincode.Cursor(payload)
                let view = try codecs.readViewRef(&c)
                let factor = try Bincode.readF32(&c)
                try await backend.set_zoom(view: view, factor: factor)
                return .unary(Data())
            } catch let err as WebViewError {
                var errOut = Data()
                codecs.writeWebViewError(&errOut, err)
                throw PluginException(payload: errOut)
            }
        case "find":
            do {
                var c = Bincode.Cursor(payload)
                let view = try codecs.readViewRef(&c)
                let query = try codecs.readFindQuery(&c)
                let result = try await backend.find(view: view, query: query)
                var out = Data()
                codecs.writeFindResult(&out, result)
                return .unary(out)
            } catch let err as WebViewError {
                var errOut = Data()
                codecs.writeWebViewError(&errOut, err)
                throw PluginException(payload: errOut)
            }
        case "snapshot":
            do {
                var c = Bincode.Cursor(payload)
                let view = try codecs.readViewRef(&c)
                let options = try codecs.readSnapshotOptions(&c)
                let result = try await backend.snapshot(view: view, options: options)
                var out = Data()
                codecs.writeWebSnapshot(&out, result)
                return .unary(out)
            } catch let err as WebViewError {
                var errOut = Data()
                codecs.writeWebViewError(&errOut, err)
                throw PluginException(payload: errOut)
            }
        case "print":
            do {
                var c = Bincode.Cursor(payload)
                let view = try codecs.readViewRef(&c)
                try await backend.print(view: view)
                return .unary(Data())
            } catch let err as WebViewError {
                var errOut = Data()
                codecs.writeWebViewError(&errOut, err)
                throw PluginException(payload: errOut)
            }
        case "set_inspector":
            do {
                var c = Bincode.Cursor(payload)
                let view = try codecs.readViewRef(&c)
                let `open` = try Bincode.readBool(&c)
                try await backend.set_inspector(view: view, open: `open`)
                return .unary(Data())
            } catch let err as WebViewError {
                var errOut = Data()
                codecs.writeWebViewError(&errOut, err)
                throw PluginException(payload: errOut)
            }
        case "download_control":
            do {
                var c = Bincode.Cursor(payload)
                let view = try codecs.readViewRef(&c)
                let op = try codecs.readDownloadOp(&c)
                try await backend.download_control(view: view, op: op)
                return .unary(Data())
            } catch let err as WebViewError {
                var errOut = Data()
                codecs.writeWebViewError(&errOut, err)
                throw PluginException(payload: errOut)
            }
        case "control_events":
            var c = Bincode.Cursor(payload)
            let view = try codecs.readViewRef(&c)
            let codecs = self.codecs
            return PluginResult.encoding(backend.control_events(view: view), encode: { item in
                var out = Data()
                codecs.writeControlEvent(&out, item)
                return out
            }, mapError: { error in
                guard let err = error as? WebViewError else { return error }
                var errOut = Data()
                codecs.writeWebViewError(&errOut, err)
                return PluginException(payload: errOut)
            })
        case "telemetry":
            var c = Bincode.Cursor(payload)
            let view = try codecs.readViewRef(&c)
            let kinds = try Bincode.readVec(&c) { c1 in try codecs.readTelemetryKind(&c1) }
            let codecs = self.codecs
            return PluginResult.encoding(backend.telemetry(view: view, kinds: kinds), encode: { item in
                var out = Data()
                codecs.writeTelemetryEvent(&out, item)
                return out
            }, mapError: { error in
                guard let err = error as? WebViewError else { return error }
                var errOut = Data()
                codecs.writeWebViewError(&errOut, err)
                return PluginException(payload: errOut)
            })
        default:
            throw PluginRuntimeError.unknownMethod(plugin: "WebView", method: method)
        }
    }
}
