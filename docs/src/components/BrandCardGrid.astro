---
interface Item {
  icon: string;
  title: string;
  body: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props as Props;
---
<div class="brand-grid">
  {items.map((it) => (
    <article class="brand-card">
      <div class="icon" set:html={it.icon}></div>
      <h3>{it.title}</h3>
      <p>{it.body}</p>
    </article>
  ))}
</div>

<style>
.brand-grid {
  display: grid; gap: 1rem;
  grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  margin: 1.5rem 0;
}
.brand-card {
  background: var(--sl-color-gray-6);
  border: 1px solid var(--sl-color-gray-5);
  border-radius: 0.75rem;
  padding: 1.5rem;
  display: flex; flex-direction: column; gap: 0.75rem;
}
.brand-card .icon {
  display: inline-flex; align-items: center; justify-content: center;
  width: 2.5rem; height: 2.5rem;
  background: var(--sl-color-black); border-radius: 0.5rem;
  color: #bfff00;
}
.brand-card .icon :global(svg) { width: 1.5rem; height: 1.5rem; }
.brand-card h3 {
  margin: 0; font-size: 1.1rem; font-weight: 600;
  color: var(--sl-color-white); letter-spacing: -0.01em;
}
.brand-card p {
  margin: 0; font-size: 0.9rem; line-height: 1.6;
  color: var(--sl-color-gray-3);
}
:root[data-theme='light'] .brand-card .icon {
  background: #0a0a0a; color: #bfff00;
}
</style>
