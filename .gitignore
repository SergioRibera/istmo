examples/data-store-demo/android/.gradle/
examples/data-store-demo/android/build/
examples/data-store-demo/android/**/build/
examples/data-store-demo/android/local.properties
examples/data-store-demo/android/app/src/main/java/dev/istmo/runtime/DataStoreDispatcher.kt
examples/data-store-demo/android/app/src/main/java/dev/istmo/runtime/DataStoreTypes.kt
examples/data-store-demo/android/app/src/main/java/dev/istmo/runtime/DataStoreCodecsImpl.kt
examples/data-store-demo/android/app/src/main/java/dev/istmo/runtime/IstmoPluginRegistry.kt
examples/data-store-demo/ios/DataStoreDemo/Plugins/IstmoPluginRegistry.swift

# android-demo / android-multi: build.rs writes generated Kotlin under
# each demo's `gen/` subpackage. Regenerated on every cargo build.
examples/android-demo/android/app/src/main/java/dev/istmo/demo/gen/
examples/android-multi/android/app/src/main/java/dev/istmo/multi/gen/

