    public func readSessionUpdate(_ c: inout Bincode.Cursor) throws -> SessionUpdate {
        let disc = try Bincode.readVarintU32(&c)
        switch disc {
        case 0: return .fps(try self.readFrameRate(&c))
        case 1: return .cursor(try self.readCursorRequest(&c))
        case 2: return .region(try self.readRegionSelector(&c))
        case 3: return .formats(try self.readFormatRequest(&c))
        case 4: return .pause
        case 5: return .resume
        default: throw Bincode.DecodeError.invalidTag(UInt8(clamping: disc))
        }
    }

