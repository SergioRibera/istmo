<?xml version="1.0" encoding="utf-8"?>
<!--
    Collapsed layout for the timer live activity — what shows up in the
    notification shade drawer when the row is not expanded. Kept as
    minimal as `RemoteViews` allows: title on the left, elapsed
    Chronometer on the right.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/timer_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/timer_text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:ellipsize="end"
        android:maxLines="1" />

    <Chronometer
        android:id="@+id/timer_elapsed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/timer_text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:format="%s" />

</LinearLayout>
