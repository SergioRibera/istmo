        val variant = ScriptWorld.entries.getOrNull(d.value)
            ?: throw Bincode.DecodeException("ScriptWorld: unknown discriminant ${d.value}")
        return Bincode.Decoded(variant, d.consumed)
    }

    override fun writeScriptWorld(out: ByteArrayOutputStream, value: ScriptWorld) {
        Bincode.writeEnumDiscriminant(out, value.ordinal)
    }

    override fun readBridgeConfig(bytes: ByteArray, offset: Int): Bincode.Decoded<BridgeConfig> {
