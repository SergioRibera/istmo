/// Decodes wire calls, invokes `ScreenCaptureBackend`, encodes the response.
/// Register with `IstmoRuntime.registerHandler(PLUGIN_ID, dispatcher)`.
class ScreenCaptureDispatcher(
    private val backend: ScreenCaptureBackend,
    private val codecs: ScreenCaptureCodecs,
) : PluginHandler, HandleReleaser {

    companion object {
        const val PLUGIN_ID = "istmo.screen_capture"
    }

    override fun releaseNativeHandle(handleId: Long) {
        (backend as? HandleReleaser)?.releaseNativeHandle(handleId)
    }

    override suspend fun handleCall(instanceId: Long, method: String, payload: ByteArray): PluginResult {
        return when (method) {
            "backends" -> {
                val result = backend.backends()
                val out = IstmoBytesOut()
                Bincode.writeVec(out, result) { s1, v1 -> codecs.writeBackendStatus(s1, v1) }
                PluginResult.Unary(out.toExactArray())
            }
            "capabilities" -> {
                try {
                    val query = codecs.readCapabilityQuery(payload, 0).value
                    val result = backend.capabilities(query)
                    val out = IstmoBytesOut()
                    codecs.writeCapabilityReport(out, result)
                    PluginResult.Unary(out.toExactArray())
                } catch (e: BackendException) {
                    val err = e.error as? CaptureError ?: throw e
                    val errOut = ByteArrayOutputStream()
                    codecs.writeCaptureError(errOut, err)
                    throw PluginException(errOut.toByteArray())
                }
            }
            "sources" -> {
                try {
                    val filter = codecs.readSourceFilter(payload, 0).value
                    val result = backend.sources(filter)
                    val out = IstmoBytesOut()
                    codecs.writeSourceList(out, result)
                    PluginResult.Unary(out.toExactArray())
                } catch (e: BackendException) {
                    val err = e.error as? CaptureError ?: throw e
                    val errOut = ByteArrayOutputStream()
                    codecs.writeCaptureError(errOut, err)
                    throw PluginException(errOut.toByteArray())
                }
            }
            "access" -> {
                try {
                    val scope = codecs.readAccessScope(payload, 0).value
                    val result = backend.access(scope)
                    val out = IstmoBytesOut()
                    codecs.writeAccessState(out, result)
                    PluginResult.Unary(out.toExactArray())
                } catch (e: BackendException) {
                    val err = e.error as? CaptureError ?: throw e
                    val errOut = ByteArrayOutputStream()
                    codecs.writeCaptureError(errOut, err)
                    throw PluginException(errOut.toByteArray())
                }
            }
            "request_access" -> {
                try {
                    val request = codecs.readAccessRequest(payload, 0).value
                    val result = backend.request_access(request)
                    val out = IstmoBytesOut()
                    codecs.writeAccessState(out, result)
                    PluginResult.Unary(out.toExactArray())
                } catch (e: BackendException) {
                    val err = e.error as? CaptureError ?: throw e
                    val errOut = ByteArrayOutputStream()
                    codecs.writeCaptureError(errOut, err)
                    throw PluginException(errOut.toByteArray())
                }
            }
            "request_projection" -> {
                try {
                    val request = codecs.readProjectionRequest(payload, 0).value
                    val result = backend.request_projection(request)
                    val out = IstmoBytesOut()
                    codecs.writeProjectionGrant(out, result)
                    PluginResult.Unary(out.toExactArray())
                } catch (e: BackendException) {
                    val err = e.error as? CaptureError ?: throw e
                    val errOut = ByteArrayOutputStream()
                    codecs.writeCaptureError(errOut, err)
                    throw PluginException(errOut.toByteArray())
                }
            }
            "screenshot" -> {
                try {
                    var cursor = 0
