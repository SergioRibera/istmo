    public func readPermissionState(_ c: inout Bincode.Cursor) throws -> Notifications.PermissionState {
        let disc = try Bincode.readVarintU32(&c)
        switch disc {
        case 0: return .granted
        case 1: return .denied
        case 2: return .notDetermined
        case 3: return .provisional
        case 4: return .ephemeral
        case 5: return .notRequired
        case 6: return .unavailable
        default:
            let payload = c.data.subdata(in: (c.data.endIndex - c.remaining) ..< c.data.endIndex)
            c.offset += payload.count
            return .unknown(discriminant: disc, payload: payload)
        }
    }

