        default: throw Bincode.DecodeError.invalidTag(UInt8(clamping: disc))
        }
    }

    public func writeHistoryNav(_ out: inout Data, _ value: WebView.HistoryNav) {
        switch value {
        case .back:
            Bincode.writeVarintU32(&out, 0)
        case .forward:
            Bincode.writeVarintU32(&out, 1)
        case .reload:
            Bincode.writeVarintU32(&out, 2)
        case .reloadBypassCache:
            Bincode.writeVarintU32(&out, 3)
        case .stop:
            Bincode.writeVarintU32(&out, 4)
        case .offset(let payload):
            Bincode.writeVarintU32(&out, 5)
            Bincode.writeVarintI32(&out, payload)
        }
    }

    public func readWebHistory(_ c: inout Bincode.Cursor) throws -> WebView.WebHistory {
        let entries = try Bincode.readVec(&c) { c1 in try self.readHistoryEntry(&c1) }
        let current = try Bincode.readVarintU32(&c)
        return WebView.WebHistory(entries: entries, current: current)
    }

    public func writeWebHistory(_ out: inout Data, _ value: WebView.WebHistory) {
        Bincode.writeVec(&out, value.entries) { o1, v1 in self.writeHistoryEntry(&o1, v1) }
        Bincode.writeVarintU32(&out, value.current)
    }

    public func readHistoryEntry(_ c: inout Bincode.Cursor) throws -> WebView.HistoryEntry {
