<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sign-in needs internet; notifications need POST_NOTIFICATIONS on 13+. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="rust-mobile-demo"
        android:hasCode="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <!-- RustMobileActivity is a NativeActivity subclass that boots
             IstmoRuntime + registers the three plugin dispatchers before
             `android_main` fires. The `android.app.lib_name` metadata
             tells NativeActivity which .so to load. -->
        <activity
            android:name="dev.istmo.rustdemo.RustMobileActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|keyboardHidden|screenSize">
            <meta-data
                android:name="android.app.lib_name"
                android:value="rust_mobile_demo" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
