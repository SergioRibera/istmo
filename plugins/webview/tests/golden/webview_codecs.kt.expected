        val channels = d_channels.value
        val d_allowedOrigins = Bincode.readVec(bytes, cursor) { b1, c1 -> Bincode.readString(b1, c1) }; cursor = d_allowedOrigins.consumed
        val allowedOrigins = d_allowedOrigins.value
        val d_allowSubframes = Bincode.readBool(bytes, cursor); cursor = d_allowSubframes.consumed
        val allowSubframes = d_allowSubframes.value
        return Bincode.Decoded(BridgeConfig(channels = channels, allowedOrigins = allowedOrigins, allowSubframes = allowSubframes), cursor)
    }

    override fun writeBridgeConfig(out: ByteArrayOutputStream, value: BridgeConfig) {
