    override fun readRawImage(bytes: ByteArray, offset: Int): Bincode.Decoded<RawImage> {
        var cursor = offset
        val d_width = Bincode.readU32(bytes, cursor); cursor = d_width.consumed
        val width = d_width.value
        val d_height = Bincode.readU32(bytes, cursor); cursor = d_height.consumed
        val height = d_height.value
        val d_stride = Bincode.readU32(bytes, cursor); cursor = d_stride.consumed
        val stride = d_stride.value
        val d_format = readCpuPixelFormat(bytes, cursor); cursor = d_format.consumed
        val format = d_format.value
        val d_colour = readColour(bytes, cursor); cursor = d_colour.consumed
        val colour = d_colour.value
        val d_source = readSourceId(bytes, cursor); cursor = d_source.consumed
        val source = d_source.value
        val d_bytes_ = Bincode.readBytes(bytes, cursor); cursor = d_bytes_.consumed
        val bytes_ = d_bytes_.value
        return Bincode.Decoded(RawImage(width = width, height = height, stride = stride, format = format, colour = colour, source = source, bytes = bytes_), cursor)
    }

    override fun writeRawImage(out: ByteArrayOutputStream, value: RawImage) {
        Bincode.writeU32(out, value.width)
        Bincode.writeU32(out, value.height)
        Bincode.writeU32(out, value.stride)
        writeCpuPixelFormat(out, value.format)
        writeColour(out, value.colour)
        writeSourceId(out, value.source)
        Bincode.writeBytes(out, value.bytes)
    }

