public enum BorderState: UInt32, Sendable {
    case shown = 0
    case hidden = 1
    case notApplicable = 2
}

public struct NegotiatedStream: Sendable {
    public let backend: BackendId
    public let source: Source
    public let size: Size
    public let contentRect: Rect
    public let format: PixelFormat
    public let memory: BufferMemory
    public let modifier: UInt64?
    public let tier: UInt8
    public let copies: [CopyStage]
    public let fps: FrameRate
    public let sourceRateMhz: UInt32?
    public let producer: GpuIdentity?
    public let sync: SyncKind
    public let poolDepth: UInt8
    public let exhaustion: Exhaustion
    public let orientation: OrientationSupport
    public let crop: RegionCrop
    public let damage: DamageSupport
    public let cursor: CursorMode
    public let colour: Colour
    public let hdr: Bool
    public let composite: CompositeInfo?
    public let consent: ConsentModel
    public let indicator: IndicatorState
    public let border: BorderState
    public let restoreToken: RestoreToken?
    public let restored: Bool
    public let audio: AudioNegotiated?

    public init(backend: BackendId, source: Source, size: Size, contentRect: Rect, format: PixelFormat, memory: BufferMemory, modifier: UInt64?, tier: UInt8, copies: [CopyStage], fps: FrameRate, sourceRateMhz: UInt32?, producer: GpuIdentity?, sync: SyncKind, poolDepth: UInt8, exhaustion: Exhaustion, orientation: OrientationSupport, crop: RegionCrop, damage: DamageSupport, cursor: CursorMode, colour: Colour, hdr: Bool, composite: CompositeInfo?, consent: ConsentModel, indicator: IndicatorState, border: BorderState, restoreToken: RestoreToken?, restored: Bool, audio: AudioNegotiated?) {
        self.backend = backend
        self.source = source
        self.size = size
        self.contentRect = contentRect
        self.format = format
        self.memory = memory
        self.modifier = modifier
        self.tier = tier
        self.copies = copies
        self.fps = fps
        self.sourceRateMhz = sourceRateMhz
        self.producer = producer
        self.sync = sync
        self.poolDepth = poolDepth
        self.exhaustion = exhaustion
        self.orientation = orientation
        self.crop = crop
        self.damage = damage
        self.cursor = cursor
        self.colour = colour
        self.hdr = hdr
        self.composite = composite
        self.consent = consent
        self.indicator = indicator
        self.border = border
        self.restoreToken = restoreToken
        self.restored = restored
        self.audio = audio
    }
}

